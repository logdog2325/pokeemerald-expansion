// Draconid Village: the player's home, at the foot of the cliffs below the Rayquaza shrine.

mapscripts DraconidVillage_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: DraconidVillage_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_DRACONID_STATE, DRACONID_STATE_EGG_HATCHED: DraconidVillage_EventScript_RunningShoes
        // the attack on the village (data/scripts/draconid/act7x.pory)
        VAR_TEMP_2, 1: DraconidVillage_EventScript_DraconidArrival
        VAR_TEMP_2, 3: DraconidVillage_EventScript_DraconidFinalIntro
        VAR_TEMP_2, 4: DraconidVillage_EventScript_DraconidGoodbyes
    ]
}

script DraconidVillage_OnTransition {
    setflag(FLAG_VISITED_DRACONID_VILLAGE)
    // VAR_TEMP_1 != 0 disarms the gatekeeper's coord triggers at the south exit
    if (var(VAR_DRACONID_STATE) >= DRACONID_STATE_READY_TO_LEAVE) {
        setvar(VAR_TEMP_1, 1)
    }
    // Acts 6-7: the sky stays dark from the meteor alert to the end of the finale (act7.pory)
    call(Draconid_EventScript_FinaleWeather)
    // the attack on the village: its weather, its people and the fights at each stage (act7x.pory)
    call(DraconidVillage_EventScript_DraconidAttackOnTransition)
}

// ---------------------------------------------------------------------------
// The egg hatches after DRACONID_EGG_HATCH_STEPS steps outdoors once the shrine ceremony is over (round 1,
// D-231): step hook Draconid_ShouldHatchEgg (src/draconid.c) in TryStartStepCountScript. Until the Running
// Shoes the village is the only outdoor map the player can reach, so this always plays here, right after a step.
// ---------------------------------------------------------------------------
script DraconidVillage_EventScript_EggHatch {
    lockall
    msgbox(format("Oh?\p"
                  "The egg is moving!"))
    closemessage
    setvar(VAR_0x8004, 0)
    special(EggHatch)
    setvar(VAR_0x8004, 0)
    special(DraconidRaiseHatchling)
    setflag(FLAG_DRACONID_EGG_HATCHED)
    clearflag(FLAG_HIDE_DRACONID_VILLAGE_SHOES_GIVER)
    setvar(VAR_DRACONID_STATE, DRACONID_STATE_EGG_HATCHED)
    releaseall
}

// ---------------------------------------------------------------------------
// An old villager heard the hatchling's cry: Running Shoes (round 1, D-102, D-231)
// ---------------------------------------------------------------------------
script DraconidVillage_EventScript_RunningShoes {
    lockall
    // she hurries over to the tile the player just walked from (always free: the egg hatches right after a
    // step), facing the player; VAR_0x8006 keeps the player's facing for the turn around
    getplayerxy(VAR_0x8004, VAR_0x8005)
    specialvar(VAR_0x8006, GetPlayerFacingDirection)
    switch (var(VAR_0x8006)) {
        case DIR_NORTH:
            addvar(VAR_0x8005, 1)
            setobjectmovementtype(LOCALID_DRACONID_VILLAGE_SHOES_GIVER, MOVEMENT_TYPE_FACE_UP)
        case DIR_SOUTH:
            subvar(VAR_0x8005, 1)
            setobjectmovementtype(LOCALID_DRACONID_VILLAGE_SHOES_GIVER, MOVEMENT_TYPE_FACE_DOWN)
        case DIR_WEST:
            addvar(VAR_0x8004, 1)
            setobjectmovementtype(LOCALID_DRACONID_VILLAGE_SHOES_GIVER, MOVEMENT_TYPE_FACE_LEFT)
        default:
            subvar(VAR_0x8004, 1)
            setobjectmovementtype(LOCALID_DRACONID_VILLAGE_SHOES_GIVER, MOVEMENT_TYPE_FACE_RIGHT)
    }
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_SHOES_GIVER, VAR_0x8004, VAR_0x8005)
    msgbox(format("OLD WOMAN: Oh, my! Was that a dragon's cry I heard?"))
    closemessage
    addobject(LOCALID_DRACONID_VILLAGE_SHOES_GIVER)
    switch (var(VAR_0x8006)) {
        case DIR_NORTH: applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
        case DIR_SOUTH: applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
        case DIR_WEST:  applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
        default:        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    }
    waitmovement(0)
    msgbox(format("OLD WOMAN: So the egg answered the sky. Let me see… Oh, what a bright little dragon!\p"
                  "The ELDER told us all. You're going down to the lowlands, alone, and in secret.\p"
                  "Then you'll need to move fast. Take these. Every tamer who leaves this village gets a pair."))
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} switched shoes with the RUNNING SHOES."))
    waitfanfare
    waitmessage
    msgbox(format("OLD WOMAN: Hold the B Button to run with them!\p"
                  "Cross the bridge on DRACONID PASS and head east to ROUTE 101. LITTLEROOT is just south of it.\p"
                  "Your house will be waiting when you need a rest. The whole village will."))
    closemessage
    setflag(FLAG_RECEIVED_RUNNING_SHOES)
    setflag(FLAG_SYS_B_DASH)
    // she stays until the village is loaded again
    setflag(FLAG_HIDE_DRACONID_VILLAGE_SHOES_GIVER)
    setvar(VAR_DRACONID_STATE, DRACONID_STATE_READY_TO_LEAVE)
    setvar(VAR_TEMP_1, 1)
    releaseall
}

script DraconidVillage_EventScript_ShoesGiver {
    msgbox(format("OLD WOMAN: Hold the B Button to run!\p"
                  "Cross the bridge on DRACONID PASS and head east to ROUTE 101."), MSGBOX_NPC)
}

// ---------------------------------------------------------------------------
// South exit: nobody leaves the village without a partner
// ---------------------------------------------------------------------------
script DraconidVillage_EventScript_GatekeeperStop {
    if (var(VAR_DRACONID_VILLAGE_STATE) >= VILLAGE_STATE_ALARM && var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_SAVED) {
        goto(DraconidVillage_EventScript_DraconidGatekeeperAttack) // act7x.pory
    }
    lockall
    applymovement(LOCALID_DRACONID_GATEKEEPER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    if (var(VAR_DRACONID_STATE) < DRACONID_STATE_EGG_RECEIVED) {
        msgbox(format("GATEKEEPER: Whoa there, {PLAYER}! Isn't today your egg ceremony?\p"
                      "The ELDER is waiting for you. You can't leave the village without a partner!"))
    } else {
        msgbox(format("GATEKEEPER: That egg of yours is about to hatch, {PLAYER}!\p"
                      "Stay in the village until it does. The lowlands are no place for an egg."))
    }
    closemessage
    applymovement(LOCALID_PLAYER, DraconidVillage_Movement_PushBack)
    waitmovement(0)
    releaseall
}

movement DraconidVillage_Movement_PushBack {
    walk_up
}

script DraconidVillage_EventScript_Gatekeeper {
    if (var(VAR_DRACONID_VILLAGE_STATE) >= VILLAGE_STATE_ALARM && var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_SAVED) {
        goto(DraconidVillage_EventScript_DraconidGatekeeperTalk) // act7x.pory
    }
    lock
    faceplayer
    if (var(VAR_DRACONID_STATE) < DRACONID_STATE_READY_TO_LEAVE) {
        msgbox(format("GATEKEEPER: Beyond this path lies DRACONID PASS, and past the river, the lowlands.\p"
                      "Wild Pokémon live out there. Only tamers with a partner may pass."))
    } elif (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_METEOR_DESTROYED) {
        msgbox(format("GATEKEEPER: They came up my path in the dark, and I couldn't hold them. You did.\p"
                      "The gate is yours, CHAMPION. Come home whenever you like."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        msgbox(format("GATEKEEPER: …Is that you under the red hood, {PLAYER}?\p"
                      "The ELDER said you'd come home looking like one of them. The gate is still yours."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_REVEALED) {
        msgbox(format("GATEKEEPER: The hero of SOOTOPOLIS, at my gate!\p"
                      "I'll never tell the young ones you once dressed like a MAGMA grunt."))
    } else {
        msgbox(format("GATEKEEPER: So you're off to see the lowlands! The clan's blessings go with you.\p"
                      "Follow the path over the bridge and head east to ROUTE 101. LITTLEROOT TOWN is south of there."))
    }
    release
}

// ---------------------------------------------------------------------------
// Villagers
// ---------------------------------------------------------------------------
script DraconidVillage_EventScript_Apprentice {
    msgbox(format("That crater was made by the star that fell here long ago.\p"
                  "The clan's KEY STONES were carved from its heart. Only the ELDER may give one away."), MSGBOX_NPC)
}

script DraconidVillage_EventScript_OldWoman {
    lock
    faceplayer
    if (flag(FLAG_DRACONID_EGG_HATCHED)) {
        msgbox(format("A dragon raised from the egg never forgets the face it saw first.\p"
                      "Be good to your little one."))
    } else {
        msgbox(format("Every child of the clan receives a dragon egg when they come of age.\p"
                      "I was your age when I received mine. Seems like only yesterday…"))
    }
    release
}

script DraconidVillage_EventScript_PondWoman {
    lock
    faceplayer
    if (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_METEOR_DESTROYED) {
        msgbox(format("KYOGRE sat right there in our pool, as big as a house!\p"
                      "The water's still cloudy. I'm not drinking a drop of it until it clears."))
    } else {
        msgbox(format("The water here comes from the peaks, where the sky dragon is said to rest.\p"
                      "Drinking it is supposed to make dragons grow strong!"))
    }
    release
}

script DraconidVillage_EventScript_Boy {
    lock
    faceplayer
    if (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_METEOR_DESTROYED) {
        msgbox(format("I saw a GROUDON and a KYOGRE, and RAYQUAZA too!\p"
                      "Nobody down in the lowlands is ever going to believe me."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        msgbox(format("Why are you dressed like the bad lowlanders?\p"
                      "…It's a trick, isn't it! I won't tell anyone!"))
    } else {
        msgbox(format("When I get my egg, I want a dragon that can fly all the way up to the sky!"))
    }
    release
}

script DraconidVillage_EventScript_VillageSign {
    msgbox(format("DRACONID VILLAGE\n"
                  "“Where the clan keeps the sky.”"), MSGBOX_SIGN)
}

script DraconidVillage_EventScript_PlayersHouseSign {
    msgbox(format("{PLAYER}'s house"), MSGBOX_SIGN)
}
