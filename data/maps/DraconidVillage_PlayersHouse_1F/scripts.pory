// Ground floor of the player's house in Draconid Village.

mapscripts DraconidVillage_PlayersHouse_1F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_HOUSES_STATE_MAY, 3: DraconidVillage_PlayersHouse_1F_EventScript_SSTicketAndLatiTV
    ]
}

// After the Hall of Fame (hall_of_fame.inc sets the state to 3 and shows Dad): Dad brings the SS Ticket
// and the Lati TV news flash airs. The house is a copy of Brendan's, so the vanilla scene runs with the
// male (Brendan's house) movements for both genders.
script DraconidVillage_PlayersHouse_1F_EventScript_SSTicketAndLatiTV {
    lockall
    setvar(VAR_0x8008, MALE)
    setvar(VAR_0x8009, LOCALID_DRACONID_HOUSE_DAD)
    setvar(VAR_0x800A, LOCALID_DRACONID_HOUSE_ELDER)
    goto(PlayersHouse_1F_EventScript_SSTicketAndLatiTV)
}

// The player lives alone (round 1: no Mom, D-100). The Elder only comes here after the finale (D-112).
script DraconidVillage_PlayersHouse_1F_EventScript_Elder {
    msgbox(format("ELDER: The sky's debt is paid, {PLAYER}. For now.\p"
                  "Rest while you can. The world beyond the mountains still has need of you."), MSGBOX_NPC)
}
