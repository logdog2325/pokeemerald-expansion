// Ground floor of the player's house in Draconid Village.

mapscripts DraconidVillage_PlayersHouse_1F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_LITTLEROOT_HOUSES_STATE_MAY, 3: DraconidVillage_PlayersHouse_1F_EventScript_SSTicketAndLatiTV
    ]
}

// After the Hall of Fame (hall_of_fame.inc sets the state to 3 and shows Dad): Dad brings the SS Ticket
// and the Lati TV news flash airs. The house is a copy of Brendan's, so the vanilla scene runs with the
// male (Brendan's house) movements for both genders.
script DraconidVillage_PlayersHouse_1F_EventScript_SSTicketAndLatiTV {
    lockall
    setvar(VAR_0x8008, MALE)
    setvar(VAR_0x8009, LOCALID_DRACONID_HOUSE_DAD)
    setvar(VAR_0x800A, LOCALID_DRACONID_HOUSE_MOM)
    goto(PlayersHouse_1F_EventScript_SSTicketAndLatiTV)
}

script DraconidVillage_PlayersHouse_1F_EventScript_Mom {
    lock
    faceplayer
    switch (var(VAR_DRACONID_STATE)) {
        case DRACONID_STATE_NEW_GAME:
        case DRACONID_STATE_SET_CLOCK:
            msgbox(format("MOM: Did you set the clock upstairs? Thank you, sweetie."))
        case DRACONID_STATE_CLOCK_SET:
            msgbox(format("MOM: Go on, the ELDER is waiting for you!\p"
                          "His is the house with the red roof, near the shrine at the foot of the cliff."))
        case DRACONID_STATE_EGG_RECEIVED:
            msgbox(format("MOM: Oh my… So that's your egg!\p"
                          "Your father would be so proud. Hurry to the shrine, the rite is about to begin!"))
        default:
            release
            goto(PlayersHouse_1F_EventScript_Mom)
    }
    release
}
