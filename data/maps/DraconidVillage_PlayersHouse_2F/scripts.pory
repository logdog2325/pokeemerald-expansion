// The player's bedroom in Draconid Village: where a new game starts.

mapscripts DraconidVillage_PlayersHouse_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // the player's own room: always show the player's decorations
        call(SecretBase_EventScript_SetDecorationFlags)
        setvar(VAR_SECRET_BASE_INITIALIZED, 0)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_SECRET_BASE_INITIALIZED, 0 {
            call(SecretBase_EventScript_InitDecorations)
        }
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_DRACONID_STATE, DRACONID_STATE_NEW_GAME: DraconidVillage_PlayersHouse_2F_EventScript_WakeUp
        // Acts 6-7: home after the Hall of Fame (act6.pory) and after the finale's credits (act7.pory)
        VAR_DRACONID_FINALE_STATE, FINALE_STATE_HALL_OF_FAME: DraconidVillage_PlayersHouse_2F_EventScript_DraconidHomecoming
        VAR_DRACONID_FINALE_STATE, FINALE_STATE_METEOR_DESTROYED: DraconidVillage_PlayersHouse_2F_EventScript_DraconidWakeUpAfterFinale
    ]
}

// New game (Act 1, D-102): a falling star in the night, then Aster comes to fetch the player for the Elder.
script DraconidVillage_PlayersHouse_2F_EventScript_WakeUp {
    lockall
    delay(60) // let the new game's own fade-in finish first
    fadescreen(FADE_TO_BLACK)
    delay(30)
    msgbox(format("That night, the DRACONID village slept under a clear, cold sky…"))
    closemessage
    playse(SE_M_DETECT)
    // the falling star: a hardware flash (a palette fade to white here would leave the map black afterwards)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    msgbox(format("A falling star tore across the heavens and vanished beyond the mountains.\p"
                  "In the ELDER's house, a lamp was lit, and it burned until dawn."))
    closemessage
    delay(40)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    playse(SE_EXIT)
    clearflag(FLAG_HIDE_DRACONID_HOUSE_2F_ASTER)
    addobject(LOCALID_DRACONID_HOUSE_2F_ASTER)
    applymovement(LOCALID_DRACONID_HOUSE_2F_ASTER, DraconidVillage_PlayersHouse_2F_Movement_AsterEnters)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    msgbox(format("ASTER: So you're awake. Finally.\p"
                  "The ELDER wants you. Now. He didn't sleep at all last night.\p"
                  "Did you see it? The star that fell? No… of course you didn't.\p"
                  "Hmph. And he calls for you, not me."))
    msgbox(format("ASTER: Set that clock of yours before you come. It's been dead for a week.\p"
                  "The ELDER's house is the one with the red roof, by the shrine. Don't make him wait."))
    closemessage
    applymovement(LOCALID_DRACONID_HOUSE_2F_ASTER, DraconidVillage_PlayersHouse_2F_Movement_AsterExits)
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_DRACONID_HOUSE_2F_ASTER)
    setvar(VAR_DRACONID_STATE, DRACONID_STATE_SET_CLOCK)
    releaseall
}

movement DraconidVillage_PlayersHouse_2F_Movement_AsterEnters {
    walk_down
    walk_left * 3
    walk_down * 2
    walk_in_place_faster_left
}

movement DraconidVillage_PlayersHouse_2F_Movement_AsterExits {
    walk_up * 2
    walk_right * 3
    walk_up
}

// Stairs: the clock has to be set first (it is the only way to start the real-time clock).
script DraconidVillage_PlayersHouse_2F_EventScript_StairsBlocked {
    lockall
    msgbox(format("{PLAYER} glanced at the stopped clock on the wall. Better set it first, like ASTER said."))
    closemessage
    applymovement(LOCALID_PLAYER, DraconidVillage_PlayersHouse_2F_Movement_StepAwayFromStairs)
    waitmovement(0)
    releaseall
}

movement DraconidVillage_PlayersHouse_2F_Movement_StepAwayFromStairs {
    walk_down
}

script DraconidVillage_PlayersHouse_2F_EventScript_WallClock {
    lockall
    if (var(VAR_DRACONID_STATE) <= DRACONID_STATE_SET_CLOCK) {
        msgbox(format("The clock has stopped. Better set it and get it going again!"))
        checkplayergender
        copyvar(VAR_0x8004, VAR_RESULT)
        fadescreen(FADE_TO_BLACK)
        special(StartWallClock)
        delay(30)
        setvar(VAR_DRACONID_STATE, DRACONID_STATE_CLOCK_SET)
        msgbox(format("Tick… tock… The clock is running again.\p"
                      "Time to head downstairs!"))
        releaseall
        end
    }
    incrementgamestat(GAME_STAT_CHECKED_CLOCK)
    fadescreen(FADE_TO_BLACK)
    special(Special_ViewWallClock)
    releaseall
}

script DraconidVillage_PlayersHouse_2F_EventScript_PC {
    lockall
    setvar(VAR_0x8004, PC_LOCATION_BRENDANS_HOUSE)
    special(DoPCTurnOnEffect)
    playse(SE_PC_ON)
    msgbox(gText_PlayerHouseBootPC)
    special(BedroomPC)
    releaseall
}

// Called from PlayerPC_TurnOff (src/player_pc.c) when the bedroom PC is shut down here.
script DraconidVillage_PlayersHouse_2F_EventScript_TurnOffPC {
    setvar(VAR_0x8004, PC_LOCATION_BRENDANS_HOUSE)
    playse(SE_PC_OFF)
    special(DoPCTurnOffEffect)
    releaseall
}
