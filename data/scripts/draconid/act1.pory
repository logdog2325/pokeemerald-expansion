// Draconid Emerald round 1, Act 1 (docs/hack_story.md): Littleroot families, Petalburg, Petalburg Woods
// recruitment and the Magma uniform, Rustboro. NPC lines follow VAR_DRACONID_REPUTATION (D-103).

// ---------------------------------------------------------------------------
// Littleroot: Brendan is Birch's son (Brendan's house), May is Norman's daughter (May's house) (D-100)
// ---------------------------------------------------------------------------

script LittlerootTown_BrendansHouse_1F_EventScript_DraconidBirchsWife {
    lock
    faceplayer
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_PRE_UNIFORM) {
        msgbox(format("MRS. BIRCH: Oh! You must be the young dragon tamer. My husband talked about you all night!\p"
                      "BRENDAN left for RUSTBORO already. Like father, like son. Neither of them can stay home."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM && var(VAR_BRENDAN_STATE) < BRENDAN_STATE_RUSTBORO) {
        // nobody she knows has seen the uniform yet: BRENDAN first sees it at RUSTBORO (D-272)
        msgbox(format("MRS. BIRCH: Oh! {PLAYER}? What on earth are you wearing, dear?\p"
                      "Isn't that what those TEAM MAGMA people wear? The ones from the news?\p"
                      "…Oh, my. BRENDAN won't like this at all."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        msgbox(format("MRS. BIRCH: {PLAYER}? That red uniform… So it's true.\p"
                      "BRENDAN came home so angry. He wouldn't even eat.\p"
                      "Whatever you're doing, dear… please be careful."))
    } else {
        msgbox(format("MRS. BIRCH: I heard what you did in SOOTOPOLIS. BRENDAN told me everything.\p"
                      "He feels awful about the things he said. Be patient with him, won't you?"))
    }
    release
}

script LittlerootTown_MaysHouse_1F_EventScript_DraconidMaysMom {
    lock
    faceplayer
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_PRE_UNIFORM) {
        msgbox(format("MAY'S MOM: Hello! You must be {PLAYER}. MAY talks about nothing but your dragon!\p"
                      "We only just moved here from JOHTO. My husband NORMAN runs the PETALBURG GYM now."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM && var(VAR_BRENDAN_STATE) < BRENDAN_STATE_RUSTBORO) {
        // MAY only hears about the uniform from BRENDAN, after RUSTBORO (D-272)
        msgbox(format("MAY'S MOM: Oh! {PLAYER}?\nMy, what a red outfit.\p"
                      "Isn't that the uniform those TEAM MAGMA people wear?\p"
                      "MAY is going to have questions for you. Lots of them."))
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        msgbox(format("MAY'S MOM: Oh… {PLAYER}. MAY told me you joined those people.\p"
                      "She doesn't believe it, though. And do you know what? Neither do I. Not quite."))
    } else {
        msgbox(format("MAY'S MOM: MAY was right about you all along! She's been unbearable about it.\p"
                      "Come by for dinner sometime. NORMAN would like to thank you properly."))
    }
    release
}

// ---------------------------------------------------------------------------
// Petalburg Woods: NERINE (in her Aqua disguise) robs the DEVON researcher, the player beats her
// (PetalburgWoods/scripts.inc), then COURTNEY recruits the player and takes them to the Magma outpost
// cabin (PetalburgWoods_MagmaOutpost), where the uniform goes on.
// VAR_PETALBURG_WOODS_STATE: 0 vanilla, 2 on the way to the cabin, 3 recruited (vanilla 1 is skipped).
// ---------------------------------------------------------------------------

script PetalburgWoods_EventScript_DraconidRecruitment {
    setvar(VAR_NERINE_STATE, NERINE_STATE_PETALBURG_WOODS)
    delay(30)
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    clearflag(FLAG_HIDE_PETALBURG_WOODS_COURTNEY)
    addobject(LOCALID_PETALBURG_WOODS_COURTNEY)
    // the two trigger tiles are x 26 and 27; Courtney stops just north of the player
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    if (var(VAR_TEMP_0) == 26) {
        applymovement(LOCALID_PETALBURG_WOODS_COURTNEY, PetalburgWoods_Movement_DraconidCourtneyApproachLeft)
    } else {
        applymovement(LOCALID_PETALBURG_WOODS_COURTNEY, PetalburgWoods_Movement_DraconidCourtneyApproachRight)
    }
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(format("???: …Observed. The whole battle.\p"
                  "Result: an AQUA member, crushed. By a child. With a dragon."))
    msgbox(format("COURTNEY: I am COURTNEY. TEAM MAGMA.\p"
                  "Anyone who crushes AQUA that easily… belongs with us.\p"
                  "More land. For people. For POKéMON. That is our goal.\p"
                  "You. Join us."))
    msgbox(format("{PLAYER} remembered the ELDER's words.\p"
                  "“Walk among the red ones. Learn what MAXIE seeks.”\p"
                  "{PLAYER} nodded."))
    msgbox(format("COURTNEY: …Answer: correct.\p"
                  "Follow. There is an outpost at the edge of the woods."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_PETALBURG_WOODS_COURTNEY)
    setvar(VAR_PETALBURG_WOODS_STATE, 2)
    warpsilent(MAP_PETALBURG_WOODS_MAGMA_OUTPOST, 4, 6)
    waitstate
    releaseall
}

// from (22, 17) on the path west of the robbery
movement PetalburgWoods_Movement_DraconidCourtneyApproachLeft {
    walk_right * 4
    walk_down * 5
}

movement PetalburgWoods_Movement_DraconidCourtneyApproachRight {
    walk_right * 5
    walk_down * 5
}

// ---------------------------------------------------------------------------
// Rustboro: BRENDAN stops the player at the city's south edge. The vanilla rival triggers on row 53 now
// check VAR_BRENDAN_STATE and walk the rival object (Brendan, (16, 50)) to the player, then
// RustboroCity_EventScript_RivalEncounter comes here. Shown by the outpost scene (PetalburgWoods_MagmaOutpost).
// ---------------------------------------------------------------------------

script RustboroCity_EventScript_DraconidBrendan {
    msgbox(format("BRENDAN: Huh? {PLAYER}?\p"
                  "Wait a second.\nIs that a TEAM MAGMA uniform?\p"
                  "You saved my dad on ROUTE 101! He hasn't stopped talking about you since.\p"
                  "And now you've joined MAGMA?! Those guys want to wreck HOENN!"))
    msgbox(format("BRENDAN: Well? Say something!\p"
                  "…Fine. Then I'll stop you myself!"))
    trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO, RustboroCity_Text_DraconidBrendanDefeat)
    msgbox(format("BRENDAN: Man, you're strong. Way too strong to be running errands for MAGMA.\p"
                  "I'm telling my dad about this. Don't expect a warm welcome at the LAB."))
    closemessage
    applymovement(LOCALID_RUSTBORO_RIVAL, RustboroCity_Movement_DraconidBrendanLeave)
    waitmovement(0)
    removeobject(LOCALID_RUSTBORO_RIVAL)
    setvar(VAR_BRENDAN_STATE, BRENDAN_STATE_RUSTBORO)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    releaseall
}

text RustboroCity_Text_DraconidBrendanDefeat {
    format("Tch… Why would someone like you\njoin THEM?")
}

movement RustboroCity_Movement_DraconidBrendanLeave {
    walk_fast_up * 6
}

// ---------------------------------------------------------------------------
// Rustboro Gym door, Stone Badge: TABITHA's order, before PROF. OAK's second starter (second_starter.pory)
// ---------------------------------------------------------------------------

script RustboroCity_EventScript_DraconidTabithaOrders {
    if (flag(FLAG_HIDE_RUSTBORO_CITY_TABITHA)) {
        return
    }
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(format("TABITHA: Hehehe! So you're the new grunt COURTNEY keeps going on about.\p"
                  "I'm TABITHA. I run the grunts in the field. That makes you mine.\p"
                  "A GYM BADGE already? Good. Leader MAXIE wants strong grunts.\p"
                  "Keep collecting BADGES. They open doors for us. Doors people don't open for a uniform.\p"
                  "And keep your eyes on DEVON. AQUA is sniffing around this town, too.\p"
                  "When I need you, I'll find you. Hehehe!"))
    closemessage
    applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaLeave)
    waitmovement(0)
    removeobject(LOCALID_RUSTBORO_TABITHA)
    setvar(VAR_MAGMA_STATE, MAGMA_STATE_ORDERS)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    delay(20)
}

// from (25, 20), left of the Gym door
movement RustboroCity_Movement_DraconidTabithaLeave {
    walk_left * 3
    walk_down * 4
}
