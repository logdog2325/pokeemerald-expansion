// Draconid Emerald round 1, Act 2 (docs/hack_story.md): the Devon Goods (Rustboro, Rusturf Tunnel, the
// goods choice), Steven in Granite Cave, the Slateport museum, May on Route 110, Wally in Mauville.
// NPC lines follow VAR_DRACONID_REPUTATION (D-103); the Magma career is VAR_MAGMA_STATE.

// ---------------------------------------------------------------------------
// Rustboro: NERINE (Aqua disguise) steals the Devon Goods (vanilla scene, her sprite and lines), then
// TABITHA steps out of the Gym and orders the player to take them "for Magma".
// RustboroCity_EventScript_StolenGoodsScene calls this at its end; VAR_0x8004 = the trigger row
// (0-4 = y 20-24, the player stands at x 23).
// ---------------------------------------------------------------------------

script RustboroCity_EventScript_DraconidTabithaGoodsOrder {
    setobjectxyperm(LOCALID_RUSTBORO_TABITHA, 27, 19)
    clearflag(FLAG_HIDE_RUSTBORO_CITY_TABITHA)
    addobject(LOCALID_RUSTBORO_TABITHA)
    playse(SE_DOOR)
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    switch (var(VAR_0x8004)) {
        case 0: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaToRow0)
        case 1: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaToRow1)
        case 2: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaToRow2)
        case 3: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaToRow3)
        default: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaToRow4)
    }
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    msgbox(format("TABITHA: Hehehe! Did you see that? AQUA just ran off with DEVON's package!\p"
                  "Leader MAXIE wants to know what DEVON is building. So do I.\p"
                  "She ran for RUSTURF TUNNEL, east of town. Get that package back.\p"
                  "Not for DEVON. For MAGMA. Understood?"))
    closemessage
    switch (var(VAR_0x8004)) {
        case 0: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaBackFromRow0)
        case 1: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaBackFromRow1)
        case 2: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaBackFromRow2)
        case 3: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaBackFromRow3)
        default: applymovement(LOCALID_RUSTBORO_TABITHA, RustboroCity_Movement_DraconidTabithaBackFromRow4)
    }
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_RUSTBORO_TABITHA)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
}

// from the Gym door (27, 19) to the player's right, (24, 20 + row)
movement RustboroCity_Movement_DraconidTabithaToRow0 { walk_down walk_left * 3 }
movement RustboroCity_Movement_DraconidTabithaToRow1 { walk_down * 2 walk_left * 3 }
movement RustboroCity_Movement_DraconidTabithaToRow2 { walk_down * 3 walk_left * 3 }
movement RustboroCity_Movement_DraconidTabithaToRow3 { walk_down * 4 walk_left * 3 }
movement RustboroCity_Movement_DraconidTabithaToRow4 { walk_down * 5 walk_left * 3 }

// and back into the Gym
movement RustboroCity_Movement_DraconidTabithaBackFromRow0 { walk_right * 3 walk_up set_invisible }
movement RustboroCity_Movement_DraconidTabithaBackFromRow1 { walk_right * 3 walk_up * 2 set_invisible }
movement RustboroCity_Movement_DraconidTabithaBackFromRow2 { walk_right * 3 walk_up * 3 set_invisible }
movement RustboroCity_Movement_DraconidTabithaBackFromRow3 { walk_right * 3 walk_up * 4 set_invisible }
movement RustboroCity_Movement_DraconidTabithaBackFromRow4 { walk_right * 3 walk_up * 5 set_invisible }

// ---------------------------------------------------------------------------
// Rusturf Tunnel: NERINE fight 2 (her team counters the egg and the second starter, D-104), then the
// Devon Goods choice (FLAG_DEVON_GOODS_RETURNED). RusturfTunnel_EventScript_Grunt battles her (base id)
// and calls this after Mr. Briney leaves with Peeko.
// ---------------------------------------------------------------------------

script RusturfTunnel_EventScript_DraconidGoodsChoice {
    setvar(VAR_NERINE_STATE, NERINE_STATE_RUSTURF)
    msgbox(format("{PLAYER} looked at the DEVON GOODS.\p"
                  "TABITHA wants them for MAGMA. DEVON wants them back."))
    message(format("What will {PLAYER} do with them?"))
    waitmessage
    dynmultichoice(15, 6, FALSE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Return to DEVON", "Keep for MAGMA")
    // what each choice leads to: devon_goods.pory (D-258)
    if (var(VAR_RESULT) == 0) {
        setflag(FLAG_DEVON_GOODS_RETURNED)
        msgbox(format("{PLAYER} decided to return the GOODS to DEVON.\p"
                      "If TABITHA asks, DEVON's people got to them first."))
    } else {
        clearflag(FLAG_DEVON_GOODS_RETURNED)
        msgbox(format("{PLAYER} tucked the GOODS away for MAGMA.\p"
                      "DEVON will have to think the thief got away with them.\p"
                      "The ELDER said to earn MAGMA's trust. This is how."))
    }
    setvar(VAR_MAGMA_STATE, MAGMA_STATE_DEVON_GOODS)
    // Tabitha waits in the Oceanic Museum with the next order
    clearflag(FLAG_HIDE_OCEANIC_MUSEUM_TABITHA)
}

// ---------------------------------------------------------------------------
// Oceanic Museum 1F: TABITHA waits past the ticket counter (FLAG_HIDE_OCEANIC_MUSEUM_TABITHA, shown by the
// goods choice). The fee script calls ...TabithaOrder once the player has paid.
// ---------------------------------------------------------------------------

script SlateportCity_OceanicMuseum_1F_EventScript_DraconidTabithaOrder {
    if (flag(FLAG_HIDE_OCEANIC_MUSEUM_TABITHA)) {
        return
    }
    playbgm(MUS_ENCOUNTER_MAGMA, FALSE)
    applymovement(LOCALID_OCEANIC_MUSEUM_1F_TABITHA, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    // the goods choice (D-258): the kept parts earn the player TABITHA's pay (devon_goods.pory)
    if (flag(FLAG_DEVON_GOODS_RETURNED)) {
        msgbox(format("TABITHA: Hehehe! There you are. DEVON got its package back, I hear.\p"
                      "Sloppy. No pay for sloppy work.\p"
                      "…But it doesn't matter. The package is going to STERN anyway."))
    } else {
        msgbox(format("TABITHA: Hehehe! There you are. You kept DEVON's package, and DEVON thinks the thief got away!\p"
                      "Good grunt! Leader MAXIE pays for results."))
        call(SlateportCity_OceanicMuseum_1F_EventScript_DraconidTabithaPays)
        msgbox(format("TABITHA: Now, here's the fun part. Take the package to STERN.\p"
                      "Tell him you found it. A grateful man doesn't ask questions."))
    }
    msgbox(format("TABITHA: STERN is building a submarine. Leader MAXIE wants to know where it goes.\p"
                  "Hand over the parts, smile, and keep your eyes open upstairs.\p"
                  "AQUA is crawling all over this museum. If they move on STERN, stop them.\p"
                  "For MAGMA, of course. Hehehe!"))
    // TEAM MAGMA equips its own grunt: the DOWSING MACHINE (it was MAY's hand-over on Route 110, D-259)
    msgbox(format("TABITHA: Oh, and take this. MAGMA digs, grunt. Every one of us carries one."))
    giveitem(ITEM_DOWSING_MACHINE)
    msgbox(format("TABITHA: A DOWSING MACHINE. It beeps when something's buried nearby.\p"
                  "If it's worth digging up, MAGMA wants it. Hehehe!"))
    closemessage
    applymovement(LOCALID_OCEANIC_MUSEUM_1F_TABITHA, SlateportCity_OceanicMuseum_1F_Movement_DraconidTabithaAside)
    waitmovement(0)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
}

// from (10, 5) to (13, 4), next to the AQUA grunt he's watching
movement SlateportCity_OceanicMuseum_1F_Movement_DraconidTabithaAside {
    walk_up
    walk_right * 3
    face_down
}

script SlateportCity_OceanicMuseum_1F_EventScript_DraconidTabitha {
    msgbox(format("TABITHA: Upstairs. STERN. Go on.\p"
                  "…And don't stare at the AQUA fools. They'll notice."), MSGBOX_NPC)
}

// Oceanic Museum 2F, after ARCHIE leaves and STERN has the parts (the vanilla scene calls this)
script SlateportCity_OceanicMuseum_2F_EventScript_DraconidAfterRaid {
    setflag(FLAG_HIDE_OCEANIC_MUSEUM_TABITHA)
    setvar(VAR_NERINE_STATE, NERINE_STATE_SLATEPORT)
    setvar(VAR_MAGMA_STATE, MAGMA_STATE_MUSEUM)
}

// ---------------------------------------------------------------------------
// Route 110: MAY battles the player (the vanilla rival scene, now hers) and leaves. She doesn't register the
// player in her PokéNav: nobody gives a MAGMA grunt their number (D-256; the rivals swap numbers at
// Sootopolis, rival_numbers.pory), nor hands over the DOWSING MACHINE (TABITHA does, D-259).
// Route110_EventScript_MayDefeated calls this after her post-battle line.
// ---------------------------------------------------------------------------

script Route110_EventScript_DraconidMayLeaves {
    setvar(VAR_MAY_STATE, MAY_STATE_ROUTE_110)
    msgbox(format("MAY: If MAGMA hurts anyone on this route, I'll know who to look for.\p"
                  "Next time, I won't lose.\nYou'll see, {PLAYER}!"))
}

// ---------------------------------------------------------------------------
// Mr. Stone gives the Gen 6 EXP. SHARE with the PokéNav (D-185): a key item that shares EXP with the whole
// party while FLAG_EXP_SHARE_ON is set (I_EXP_SHARE_FLAG). It starts switched on.
// RustboroCity_DevonCorp_3F_EventScript_MeetPresident calls this after the PokéNav.
// ---------------------------------------------------------------------------

script RustboroCity_DevonCorp_3F_EventScript_DraconidGiveExpShare {
    msgbox(format("MR. STONE: And one more thing. DEVON's newest invention!"))
    giveitem(ITEM_EXP_SHARE)
    setflag(FLAG_RECEIVED_EXP_SHARE)
    setflag(FLAG_EXP_SHARE_ON)
    msgbox(RustboroCity_DevonCorp_3F_Text_ExplainExpShare, MSGBOX_DEFAULT)
    // the parts came back: MR. STONE's thank-you gift (devon_goods.pory, D-258)
    call(RustboroCity_DevonCorp_3F_EventScript_DraconidThankYouGift)
}
