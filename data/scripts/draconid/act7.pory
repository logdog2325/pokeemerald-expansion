// Draconid Emerald round 1, Act 7 (docs/hack_story.md steps 31-34): "The prophecy fulfilled".
//
//   Sky Pillar, outside   ASTER and NERINE wait at the base: the TRIAL OF THREE, a double battle (the player +
//                         NERINE vs ASTER); the door opens and the three climb together
//   Sky Pillar 3F         ZINNIA, the LOREKEEPER of the METEOR FALLS DRACONIDS, tests the ELDER's chosen
//   Sky Pillar summit     the ELDER calls RAYQUAZA down: the must-catch battle, DRAGON ASCENT; DEOXYS attacks
//                         at once (boss battle); MEGA RAYQUAZA breaks the meteor; "The sky's debt is paid… for
//                         now."; then MAXIE and ARCHIE attack the village (act7x.pory): after it the game saves
//                         and the credits roll, then the player wakes at home
// Before the trial the ELDER calls the player home to REGIDRAGO (act7x.pory).
//   Post-game             the ELDER brings the SS TICKET (DraconidVillage_PlayersHouse_1F/scripts.pory), BRENDAN
//                         and MAY in the Littleroot lab (singles, then a double), ASTER at the village shrine,
//                         NERINE by the village pond, DEOXYS at the summit (once, D-111)
//
// VAR_DRACONID_FINALE_STATE: FINALE_STATE_* (include/constants/draconid.h). Every finale battle is fought again after
// a loss instead of whiting out (D-110, D-151, D-155). Scenes start from OnFrame on VAR_TEMP_7, which each map's
// OnTransition hook sets from the finale state (a lost battle ends the scene without looping it).
// Vanilla hooks are listed in docs/hack_changes.md ("Scripts").

// ---------------------------------------------------------------------------
// Shared
// ---------------------------------------------------------------------------

// The sky stays dark from the meteor alert until the meteor is destroyed; from the alarm until MAXIE and ARCHIE are
// beaten, PRIMAL GROUDON and KYOGRE make Emerald's alternating drought and downpour (act7x.pory, D-204)
script Draconid_EventScript_FinaleWeather {
    if (var(VAR_DRACONID_VILLAGE_STATE) >= VILLAGE_STATE_ALARM && var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_PRIMAL_WON) {
        setweather(WEATHER_ABNORMAL)
    } elif (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_METEOR_ALERT && var(VAR_DRACONID_FINALE_STATE) < FINALE_STATE_METEOR_DESTROYED
         && var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_ALARM) {
        setweather(WEATHER_SHADE)
    }
}

// After a lost finale battle: the party is healed and the scene waits for the player to try again
script Draconid_EventScript_FinaleHeal {
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
}

text Draconid_Text_NerineHeals {
    format("NERINE tended to {PLAYER}'s POKéMON. They're ready to battle again!")
}

// ---------------------------------------------------------------------------
// Sky Pillar, outside: ASTER and NERINE wait below the door (13, 7) / (15, 7); the player arrives from the cave at
// (17, 14) (on foot or on the ELDER's dragon). SkyPillar_Outside_OnTransition calls ...DraconidOnTransition;
// the OnFrame table runs ...DraconidTrialOfThree when VAR_TEMP_7 is 1; OnLoad opens the door from
// FINALE_STATE_CLIMB on (the Sky Pillar stays shut until the finale, D-109).
// ---------------------------------------------------------------------------

script SkyPillar_Outside_EventScript_DraconidOnTransition {
    if (var(VAR_DRACONID_FINALE_STATE) == FINALE_STATE_SUMMONED) {
        // the ELDER calls the player home to REGIDRAGO first, and WALLACE keeps the way; the trial waits for both
        // (act7x.pory)
        setflag(FLAG_HIDE_SKY_PILLAR_WALLACE)
        if (var(VAR_DRACONID_VILLAGE_STATE) == VILLAGE_STATE_NONE) {
            setvar(VAR_TEMP_7, 2)
        } elif (var(VAR_DRACONID_VILLAGE_STATE) >= VILLAGE_STATE_REGIDRAGO) {
            if (!defeated(TRAINER_WALLACE_SKY_PILLAR)) {
                call(SkyPillar_Outside_EventScript_DraconidShowWallace)
                setvar(VAR_TEMP_7, 3)
            } else {
                setvar(VAR_TEMP_7, 1)
            }
        }
    } else {
        setflag(FLAG_TEMP_11) // ASTER and NERINE only wait here before the trial
    }
    call(Draconid_EventScript_FinaleWeather)
}

script SkyPillar_Outside_EventScript_DraconidTrialOfThree {
    lockall
    setvar(VAR_TEMP_7, 0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_SKY_PILLAR_OUTSIDE_ASTER, SkyPillar_Outside_Movement_DraconidAsterToPlayer)
    applymovement(LOCALID_SKY_PILLAR_OUTSIDE_NERINE, SkyPillar_Outside_Movement_DraconidNerineToPlayer)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(format("ASTER: There you are, CHAMPION. You took your time."))
    msgbox(format("NERINE: Don't listen to her. She's been pacing since dusk.\p"
                  "The sky went dark hours ago. Even the sea went quiet."))
    msgbox(format("ASTER: Riddle: what falls for a thousand years and lands in a single night?\p"
                  "…Don't answer. We'll all find out soon enough."))
    msgbox(format("ASTER: The door won't open for us yet. Not before the last rite: the TRIAL OF THREE.\p"
                  "Two stand together, one stands alone. The sky watches how we fight.\p"
                  "I'll stand alone. I always have."))
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(format("NERINE: Then I'll stand with {PLAYER}.\p"
                  "I've stood alone long enough, dressed in blue."))
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(format("ASTER: Hmph. Pick your three, {PLAYER}. Don't hold back. I won't."))
    closemessage
    goto(SkyPillar_Outside_EventScript_DraconidDoubleBattle)
}

// from below the door to the player's left, (16, 14)
movement SkyPillar_Outside_Movement_DraconidAsterToPlayer {
    walk_down * 7
    walk_right * 3
    walk_in_place_faster_right
}

// from below the door to below the player, (17, 15)
movement SkyPillar_Outside_Movement_DraconidNerineToPlayer {
    walk_down
    walk_left * 3
    walk_down * 7
    walk_right * 5
    walk_in_place_faster_up
}

// The player + NERINE vs ASTER: ASTER names the base id (her team counters the player's egg, D-101) and NERINE the
// first partner id (her team follows the egg and the second starter, D-151). The player picks three.
script SkyPillar_Outside_EventScript_DraconidDoubleBattle {
    special(SavePlayerParty)
    fadescreen(FADE_TO_BLACK)
    special(ChooseHalfPartyForBattle)
    if (var(VAR_RESULT) == 0) {
        special(LoadPlayerParty)
        msgbox(format("ASTER: Not ready? Hmph. We'll be right here."))
        releaseall
        end
    }
    setflag(FLAG_DRACONID_NO_WHITEOUT)
    multi_2_vs_1(TRAINER_ASTER_SKY_PILLAR_DEINO, SkyPillar_Outside_Text_DraconidAsterDefeat, PARTNER_NERINE_DEINO_CHARMANDER)
    clearflag(FLAG_DRACONID_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_WON) {
        msgbox(format("ASTER: …Hmph. The sky doesn't wait for tamers who fall. NERINE, patch them up."))
        call(Draconid_EventScript_FinaleHeal)
        msgbox(Draconid_Text_NerineHeals)
        msgbox(format("ASTER: Talk to me when you want to try again."))
        releaseall
        end
    }
    setvar(VAR_ASTER_STATE, ASTER_STATE_SKY_PILLAR)
    setvar(VAR_NERINE_STATE, NERINE_STATE_SKY_PILLAR)
    msgbox(format("ASTER: …Two dragons climbed the same tower. Remember that riddle?\p"
                  "I said only one could reach the sky. The one still standing.\p"
                  "I was wrong. This time we all reach the top."))
    msgbox(format("NERINE: Listen. The pillar heard us."))
    closemessage
    playse(SE_M_EARTHQUAKE)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, SkyPillar_Outside_Movement_DraconidCameraToDoor)
    waitmovement(0)
    call(SkyPillar_Outside_EventScript_OpenDoor)
    special(DrawWholeMapView)
    playse(SE_DOOR)
    msgbox(format("The great door of the SKY PILLAR rumbled open!"))
    closemessage
    applymovement(LOCALID_CAMERA, SkyPillar_Outside_Movement_DraconidCameraBack)
    waitmovement(0)
    special(RemoveCameraObject)
    msgbox(format("NERINE: Wait. Let me see to your partners first. It's a long way up."))
    call(Draconid_EventScript_FinaleHeal)
    msgbox(Draconid_Text_NerineHeals)
    msgbox(format("ASTER: Then let's climb. Together."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_DRACONID_FINALE_STATE, FINALE_STATE_CLIMB)
    msgbox(format("{PLAYER}, ASTER and NERINE climbed the SKY PILLAR together…"))
    closemessage
    warpsilent(MAP_SKY_PILLAR_3F, 3, 2)
    waitstate
}

movement SkyPillar_Outside_Movement_DraconidCameraToDoor {
    walk_up * 5
    walk_left * 3
}

movement SkyPillar_Outside_Movement_DraconidCameraBack {
    walk_right * 3
    walk_down * 5
}

text SkyPillar_Outside_Text_DraconidAsterDefeat {
    format("…So that's the answer.")
}

// ASTER and NERINE after a lost trial: talk to either to try again
script SkyPillar_Outside_EventScript_DraconidAster {
    lock
    faceplayer
    if (var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_REGIDRAGO) {
        goto(SkyPillar_Outside_EventScript_DraconidGoHomeFirst) // act7x.pory
    }
    msgbox(format("ASTER: Ready for the TRIAL OF THREE?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("ASTER: Take your time. Just not too much of it. Look at the sky."))
        release
        end
    }
    closemessage
    goto(SkyPillar_Outside_EventScript_DraconidDoubleBattle)
}

script SkyPillar_Outside_EventScript_DraconidNerine {
    lock
    faceplayer
    if (var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_REGIDRAGO) {
        goto(SkyPillar_Outside_EventScript_DraconidGoHomeFirst) // act7x.pory
    }
    msgbox(format("NERINE: I'm with you, {PLAYER}. Shall we try again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("NERINE: When you're ready. The sky is patient. Barely."))
        release
        end
    }
    closemessage
    goto(SkyPillar_Outside_EventScript_DraconidDoubleBattle)
}

// ---------------------------------------------------------------------------
// Sky Pillar 3F: ZINNIA, the LOREKEEPER of the METEOR FALLS DRACONIDS (a sister clan), tests the ELDER's chosen
// (D-155). The player arrives by the stairs at (3, 2), ASTER at (2, 2), NERINE at (2, 3), ZINNIA waits at (3, 5).
// SkyPillar_3F_OnTransition calls ...DraconidOnTransition; the OnFrame table runs ...DraconidZinniaScene.
// ---------------------------------------------------------------------------

script SkyPillar_3F_EventScript_DraconidOnTransition {
    if (var(VAR_DRACONID_FINALE_STATE) == FINALE_STATE_CLIMB) {
        setvar(VAR_TEMP_7, 1)
    } else {
        setflag(FLAG_TEMP_11) // ZINNIA, ASTER and NERINE only wait here during the climb
    }
}

script SkyPillar_3F_EventScript_DraconidZinniaScene {
    lockall
    setvar(VAR_TEMP_7, 0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    delay(20)
    applymovement(LOCALID_SKY_PILLAR_3F_ZINNIA, Common_Movement_WalkUp)
    waitmovement(0)
    msgbox(format("???: Heh. So the ELDER's chosen one finally shows up."))
    msgbox(format("ZINNIA: The name's ZINNIA.\p"
                  "I'm the LOREKEEPER of the DRACONIDS of METEOR FALLS."))
    applymovement(LOCALID_SKY_PILLAR_3F_ASTER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    msgbox(format("ASTER: The sister clan… The LOREKEEPER? I thought she was a story the ELDER told us to keep us quiet!"))
    msgbox(format("NERINE: The ones who keep the old songs. When the sky went red, you came.\p"
                  "The ELDER said you would."))
    msgbox(format("ZINNIA: Your ELDER and I read the same stars. When they went dark tonight, I came running.\p"
                  "RAYQUAZA doesn't answer to just anyone, you know.\p"
                  "The one who stands beside it has to be ready for anything. Even the end of the world."))
    msgbox(format("ZINNIA: So before you go up there, {PLAYER}, show me.\p"
                  "Show me you're worth the whole sky!"))
    goto(SkyPillar_3F_EventScript_DraconidBattleZinnia)
}

// A loss doesn't white out here: the whole climb is one scene (D-155)
script SkyPillar_3F_EventScript_DraconidBattleZinnia {
    setflag(FLAG_DRACONID_NO_WHITEOUT)
    trainerbattle_no_intro(TRAINER_ZINNIA_SKY_PILLAR, SkyPillar_3F_Text_DraconidZinniaDefeat)
    clearflag(FLAG_DRACONID_NO_WHITEOUT)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) != B_OUTCOME_WON) {
        msgbox(format("ZINNIA: Not yet, huh? Rest up. I'm not going anywhere."))
        call(Draconid_EventScript_FinaleHeal)
        msgbox(Draconid_Text_NerineHeals)
        releaseall
        end
    }
    msgbox(format("ZINNIA: Hah! That's the stuff! Now I see why the old man picked you.\p"
                  "Go on up. The summit's waiting, and so is your ELDER.\p"
                  "I'll be right behind you. I wouldn't miss this for anything."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_DRACONID_FINALE_STATE, FINALE_STATE_SUMMIT)
    msgbox(format("…At last, they reached the top of the SKY PILLAR."))
    closemessage
    warpsilent(MAP_SKY_PILLAR_TOP, 14, 12)
    waitstate
}

text SkyPillar_3F_Text_DraconidZinniaDefeat {
    format("Now THAT is a dragon tamer!")
}

script SkyPillar_3F_EventScript_DraconidZinnia {
    lock
    faceplayer
    msgbox(format("ZINNIA: Ready for round two, chosen one?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("ZINNIA: Take a breath. The stars can wait a little longer."))
        release
        end
    }
    closemessage
    goto(SkyPillar_3F_EventScript_DraconidBattleZinnia)
}

script SkyPillar_3F_EventScript_DraconidAster {
    msgbox(format("ASTER: A LOREKEEPER, testing us. The ELDER never tells us anything.\p"
                  "Beat her, {PLAYER}. I'm not climbing all the way back down."), MSGBOX_NPC)
}

script SkyPillar_3F_EventScript_DraconidNerine {
    msgbox(format("NERINE: Her dragons are old and wise, like her songs.\p"
                  "Listen to them, and you'll win."), MSGBOX_NPC)
}

// ---------------------------------------------------------------------------
// Sky Pillar summit (story steps 32-34). The player arrives at (14, 12); the ELDER waits at (14, 9), ASTER at
// (13, 11), NERINE at (15, 11), ZINNIA at (16, 12). RAYQUAZA (LOCALID_RAYQUAZA_SLEEPING) and DEOXYS come down
// from the sky onto (14, 7). SkyPillar_Top_OnTransition calls ...DraconidOnTransition; the OnFrame table runs
// ...DraconidSummit.
// ---------------------------------------------------------------------------

script SkyPillar_Top_EventScript_DraconidOnTransition {
    if (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_SUMMONED) {
        // the vanilla "RAYQUAZA wakes" trigger at (14, 9) stays off; the finale brings its own RAYQUAZA
        setvar(VAR_SKY_PILLAR_RAYQUAZA_CRY_DONE, 1)
        setflag(FLAG_HIDE_SKY_PILLAR_TOP_RAYQUAZA)
    }
    if (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_SUMMONED && var(VAR_DRACONID_FINALE_STATE) < FINALE_STATE_METEOR_DESTROYED) {
        setflag(FLAG_HIDE_SKY_PILLAR_TOP_RAYQUAZA_STILL)
    }
    if (var(VAR_DRACONID_FINALE_STATE) == FINALE_STATE_SUMMIT) {
        setvar(VAR_TEMP_7, 1)
        clearflag(FLAG_HIDE_SKY_PILLAR_TOP_ASTER)
        setobjectxyperm(LOCALID_SKY_PILLAR_TOP_ASTER, 13, 11)
        setobjectmovementtype(LOCALID_SKY_PILLAR_TOP_ASTER, MOVEMENT_TYPE_FACE_UP)
    } else {
        setflag(FLAG_TEMP_11) // the ELDER, NERINE and ZINNIA are only here for the finale
    }
    // DEOXYS (post-game): where it fell, until it is caught (or beaten: then after the next Hall of Fame, D-111)
    if (var(VAR_DRACONID_FINALE_STATE) < FINALE_STATE_METEOR_DESTROYED || flag(FLAG_BATTLED_DEOXYS) || flag(FLAG_DEFEATED_DEOXYS)) {
        setflag(FLAG_TEMP_12)
    }
    call(Draconid_EventScript_FinaleWeather)
}

script SkyPillar_Top_EventScript_DraconidSummit {
    lockall
    setvar(VAR_TEMP_7, 0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(30)
    applymovement(LOCALID_SKY_PILLAR_TOP_ELDER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(format("ELDER: {PLAYER}. ASTER. NERINE. You came together. Good."))
    applymovement(LOCALID_SKY_PILLAR_TOP_ELDER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    msgbox(format("ELDER: And the LOREKEEPER of the FALLS. It has been many years, ZINNIA."))
    msgbox(format("ZINNIA: Too many, old man! Your kids are all right, you know.\p"
                  "This one especially."))
    applymovement(LOCALID_SKY_PILLAR_TOP_ELDER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(format("ELDER: Rest a moment, {PLAYER}. Let the clan tend to your partners."))
    call(Draconid_EventScript_FinaleHeal)
    msgbox(format("{PLAYER}'s POKéMON were restored to full health!"))
    msgbox(format("ELDER: Now. Look up, all of you."))
    closemessage
    applymovement(LOCALID_SKY_PILLAR_TOP_ELDER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanUp)
    waitmovement(0)
    call(Draconid_EventScript_FinaleQuake)
    playse(SE_M_EXPLOSION)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    msgbox(format("Above the clouds, a second sun was burning.\p"
                  "The meteor. So close now, it filled half the sky."))
    msgbox(format("ELDER: Call it, as our clan has always called it.\p"
                  "Guardian of the Sky, who stilled the land and the sea…\p"
                  "The sky's debt has come due. Come down to us!"))
    closemessage
    playse(SE_M_DRAGON_RAGE)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    delay(30)
    // RAYQUAZA comes down from the sky
    setobjectxyperm(LOCALID_RAYQUAZA_SLEEPING, 14, 1)
    addobject(LOCALID_RAYQUAZA_SLEEPING)
    applymovement(LOCALID_RAYQUAZA_SLEEPING, SkyPillar_Top_Movement_DraconidRayquazaDescends)
    waitmovement(0)
    waitse
    playmoncry(SPECIES_RAYQUAZA, CRY_MODE_ENCOUNTER)
    call(Draconid_EventScript_FinaleQuake)
    waitmoncry
    msgbox(format("RAYQUAZA came down from the sky!"))
    applymovement(LOCALID_SKY_PILLAR_TOP_ELDER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(format("ELDER: It has come to see who stands beside it.\p"
                  "Show it, {PLAYER}. Show it who you are!"))
    closemessage
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanDown)
    waitmovement(0)
    special(RemoveCameraObject)
    call(SkyPillar_Top_EventScript_DraconidCatchRayquaza)
    call(SkyPillar_Top_EventScript_DraconidDragonAscent)
    call(SkyPillar_Top_EventScript_DraconidDeoxysAttacks)
    goto(SkyPillar_Top_EventScript_DraconidMeteor)
}

// descends onto (14, 7), then the awake pose (Rayquaza's frames follow its facing: locked to north = flying)
movement SkyPillar_Top_Movement_DraconidRayquazaDescends {
    walk_in_place_faster_up
    lock_facing_direction
    slide_down * 6
    unlock_facing_direction
    delay_16
    walk_in_place_right
    delay_16
}

movement SkyPillar_Top_Movement_DraconidRayquazaLeaves {
    walk_in_place_right
    delay_8
    walk_faster_up
    slide_up * 6
}

// The must-catch battle (D-110): no running; if RAYQUAZA faints or the player loses, a line and the battle again.
script SkyPillar_Top_EventScript_DraconidCatchRayquaza {
    call(SkyPillar_Top_EventScript_DraconidGiveBalls)
    closemessage
    setflag(FLAG_DRACONID_NO_WHITEOUT)
    setflag(FLAG_DRACONID_NO_RUNNING)
    do {
        setwildbattle(SPECIES_RAYQUAZA, DRACONID_RAYQUAZA_LEVEL)
        special(BattleSetup_StartLegendaryBattle)
        specialvar(VAR_TEMP_8, GetBattleOutcome)
        if (var(VAR_TEMP_8) == B_OUTCOME_WON) {
            msgbox(format("RAYQUAZA fell… but it rose again, higher than before!\p"
                          "ELDER: It is not defeat it wants from you, {PLAYER}. It is trust.\p"
                          "Again!"))
            call(Draconid_EventScript_FinaleHeal)
            call(SkyPillar_Top_EventScript_DraconidGiveBalls)
            closemessage
        } elif (var(VAR_TEMP_8) != B_OUTCOME_CAUGHT) {
            msgbox(format("ELDER: Rise, {PLAYER}. The sky is not lost while you still stand.\p"
                          "Again!"))
            call(Draconid_EventScript_FinaleHeal)
            call(SkyPillar_Top_EventScript_DraconidGiveBalls)
            closemessage
        }
    } while (var(VAR_TEMP_8) != B_OUTCOME_CAUGHT)
    clearflag(FLAG_DRACONID_NO_RUNNING)
    clearflag(FLAG_DRACONID_NO_WHITEOUT)
    removeobject(LOCALID_RAYQUAZA_SLEEPING)
    setflag(FLAG_DEFEATED_RAYQUAZA)
}

// Never without a POKé BALL at the summit
script SkyPillar_Top_EventScript_DraconidGiveBalls {
    checkitem(ITEM_ULTRA_BALL)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("ELDER: Take these. A POKé BALL is a promise, not a cage."))
        giveitem(ITEM_ULTRA_BALL, 5)
    }
}

// The ELDER teaches DRAGON ASCENT; RAYQUAZA leads the party for DEOXYS (Draconid_PrepareRayquaza, src/draconid.c)
script SkyPillar_Top_EventScript_DraconidDragonAscent {
    msgbox(format("ELDER: RAYQUAZA has chosen you, {PLAYER}. As the stars said it would."))
    callnative(Draconid_PrepareRayquaza)
    if (var(VAR_RESULT) == FALSE) {
        return
    }
    bufferpartymonnick(STR_VAR_1, 0)
    msgbox(format("ELDER: Now let it remember the oldest song of our clan.\p"
                  "The song of the dragon that rises to meet the falling star."))
    closemessage
    playse(SE_M_DRAGON_RAGE)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    if (var(VAR_0x8005) != MOVE_NONE) {
        buffermovename(STR_VAR_2, VAR_0x8005)
        msgbox(format("{STR_VAR_1} forgot {STR_VAR_2}…"))
    }
    playfanfare(MUS_LEVEL_UP)
    message(format("{STR_VAR_1} learned DRAGON ASCENT!"))
    waitmessage
    waitfanfare
    msgbox(format("ELDER: With DRAGON ASCENT and your MEGA RING, RAYQUAZA can take its true form."))
    setvar(VAR_DRACONID_FINALE_STATE, FINALE_STATE_RAYQUAZA)
}

// DEOXYS attacks at once (story step 33): a boss battle, no catching, no running, fought again after a loss;
// RAYQUAZA leads the party
script SkyPillar_Top_EventScript_DraconidDeoxysAttacks {
    closemessage
    playse(SE_M_TELEPORT)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    call(Draconid_EventScript_FinaleQuake)
    msgbox(format("ASTER: Wait… something's coming down! Fast!"))
    closemessage
    playbgm(MUS_RG_ENCOUNTER_DEOXYS, FALSE)
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanUp)
    waitmovement(0)
    setobjectxyperm(LOCALID_SKY_PILLAR_TOP_DEOXYS, 14, 1)
    addobject(LOCALID_SKY_PILLAR_TOP_DEOXYS)
    applymovement(LOCALID_SKY_PILLAR_TOP_DEOXYS, SkyPillar_Top_Movement_DraconidDeoxysDescends)
    waitmovement(0)
    playse(SE_M_EXPLOSION)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    waitse
    playmoncry(SPECIES_DEOXYS_NORMAL, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("ELDER: DEOXYS… It rode the stone down from the dark between the stars."))
    msgbox(format("NERINE: It wants RAYQUAZA! It came for the guardian of the sky!"))
    msgbox(format("ZINNIA: Then don't let it have it! {PLAYER}, RAYQUAZA leads! Go!"))
    closemessage
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanDown)
    waitmovement(0)
    special(RemoveCameraObject)
    setflag(FLAG_DRACONID_NO_WHITEOUT)
    setflag(FLAG_DRACONID_NO_RUNNING)
    setflag(FLAG_DRACONID_NO_CATCHING)
    do {
        setwildbattle(SPECIES_DEOXYS_NORMAL, DRACONID_DEOXYS_BOSS_LEVEL)
        special(BattleSetup_StartLegendaryBattle)
        specialvar(VAR_TEMP_8, GetBattleOutcome)
        if (var(VAR_TEMP_8) != B_OUTCOME_WON) {
            msgbox(format("ELDER: Rise, {PLAYER}! The stone still falls. We cannot fall with it!"))
            call(Draconid_EventScript_FinaleHeal)
            msgbox(format("{PLAYER}'s POKéMON were restored to full health!"))
            closemessage
        }
    } while (var(VAR_TEMP_8) != B_OUTCOME_WON)
    clearflag(FLAG_DRACONID_NO_CATCHING)
    clearflag(FLAG_DRACONID_NO_RUNNING)
    clearflag(FLAG_DRACONID_NO_WHITEOUT)
}

// SkyPillar_Top_Movement_CameraPanDown, quickly (the screen is black)
movement SkyPillar_Top_Movement_DraconidCameraBackDown {
    walk_faster_down * 3
}

movement SkyPillar_Top_Movement_DraconidDeoxysDescends {
    face_down
    lock_facing_direction
    slide_down * 6
    unlock_facing_direction
}

// DEOXYS vanishes, MEGA RAYQUAZA flies up and breaks the meteor (ORAS Delta Episode style), the ELDER's last words,
// then the alarm over the village (act7x.pory; the save and the credits come after the attack, story step 34)
script SkyPillar_Top_EventScript_DraconidMeteor {
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanUp)
    waitmovement(0)
    playse(SE_M_TELEPORT)
    fadescreenswapbuffers(FADE_TO_WHITE)
    removeobject(LOCALID_SKY_PILLAR_TOP_DEOXYS)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    msgbox(format("DEOXYS came apart into shards of light… and was gone."))
    closemessage
    call(Draconid_EventScript_FinaleQuake)
    msgbox(format("ELDER: The stone still falls! {PLAYER}, now! Call on RAYQUAZA!"))
    closemessage
    bufferpartymonnick(STR_VAR_1, 0)
    setobjectxyperm(LOCALID_RAYQUAZA_SLEEPING, 14, 7)
    playse(SE_BALL_OPEN)
    addobject(LOCALID_RAYQUAZA_SLEEPING)
    applymovement(LOCALID_RAYQUAZA_SLEEPING, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    waitse
    playmoncry(SPECIES_RAYQUAZA, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("{PLAYER}'s MEGA RING began to shine, and {STR_VAR_1} answered!"))
    closemessage
    playse(SE_M_SKY_UPPERCUT)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    playse(SE_M_SKY_UPPERCUT)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    waitse
    playmoncry(SPECIES_RAYQUAZA_MEGA, CRY_MODE_ENCOUNTER)
    // TODO(art): a MEGA RAYQUAZA overworld sprite to swap in here (the field object stays the normal RAYQUAZA)
    msgbox(format("{STR_VAR_1} MEGA EVOLVED into MEGA RAYQUAZA!"))
    waitmoncry
    msgbox(format("ELDER: Go, guardian of the sky. DRAGON ASCENT!"))
    closemessage
    playse(SE_M_FLY)
    applymovement(LOCALID_RAYQUAZA_SLEEPING, SkyPillar_Top_Movement_DraconidRayquazaLeaves)
    waitmovement(0)
    removeobject(LOCALID_RAYQUAZA_SLEEPING)
    fadescreen(FADE_TO_BLACK)
    // back on the player before leaving the field: the camera's position is the saved map position
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_DraconidCameraBackDown)
    waitmovement(0)
    special(RemoveCameraObject)
    callnative(Draconid_DoRayquazaFlightScene)
    waitstate
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanUp)
    waitmovement(0)
    msgbox(format("Beyond the clouds, beyond the sky itself, MEGA RAYQUAZA met the falling star."))
    closemessage
    playse(SE_M_HYPER_BEAM)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    delay(20)
    playse(SE_THUNDER)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    delay(20)
    playse(SE_M_EXPLOSION)
    fadescreenswapbuffers(FADE_TO_WHITE)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    call(Draconid_EventScript_FinaleQuake)
    msgbox(format("A light brighter than the sun… and the meteor broke apart!"))
    closemessage
    setweather(WEATHER_NONE)
    doweather
    special(WaitWeather)
    msgbox(format("Its pieces burned across the sky: a rain of falling stars from one end of HOENN to the other."))
    closemessage
    // RAYQUAZA comes back
    setobjectxyperm(LOCALID_RAYQUAZA_SLEEPING, 14, 1)
    addobject(LOCALID_RAYQUAZA_SLEEPING)
    applymovement(LOCALID_RAYQUAZA_SLEEPING, SkyPillar_Top_Movement_DraconidRayquazaDescends)
    waitmovement(0)
    playmoncry(SPECIES_RAYQUAZA, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("{STR_VAR_1} came back down from the edge of the sky.\p"
                  "It looked at {PLAYER} for a long moment… and returned to its POKé BALL."))
    closemessage
    playse(SE_BALL)
    removeobject(LOCALID_RAYQUAZA_SLEEPING)
    delay(30)
    applymovement(LOCALID_CAMERA, SkyPillar_Top_Movement_CameraPanDown)
    waitmovement(0)
    special(RemoveCameraObject)
    msgbox(format("ELDER: It is done."))
    msgbox(format("ELDER: The sky's debt is paid… for now."))
    applymovement(LOCALID_SKY_PILLAR_TOP_ASTER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    msgbox(format("ASTER: Riddle: what's red, falls from the sky, and ends up in a thousand pieces?\p"
                  "…Ha. Don't answer that one either."))
    applymovement(LOCALID_SKY_PILLAR_TOP_NERINE, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(format("NERINE: The sky is blue again.\p"
                  "I never did like red, you know. Even on you."))
    msgbox(format("ZINNIA: Heh. The stars got it right for once. See you around, CHAMPION."))
    closemessage
    // no credits yet: the sky over the village splits, and the attack on the village follows (act7x.pory, D-200);
    // the credits roll once the village is saved (DraconidVillage_EventScript_DraconidCredits)
    goto(SkyPillar_Top_EventScript_DraconidAlarm)
}

// ---------------------------------------------------------------------------
// Home after the credits (D-112): the player wakes in the bedroom (DraconidVillage_PlayersHouse_2F OnFrame,
// FINALE_STATE_METEOR_DESTROYED); the ELDER waits downstairs with the SS TICKET
// (DraconidVillage_PlayersHouse_1F/scripts.pory, FINALE_STATE_HOME)
// ---------------------------------------------------------------------------

script DraconidVillage_PlayersHouse_2F_EventScript_DraconidWakeUpAfterFinale {
    lockall
    delay(30)
    msgbox(format("{PLAYER} slept through a whole day and a night.\p"
                  "Downstairs, someone was humming an old DRACONID song…"))
    closemessage
    setvar(VAR_DRACONID_FINALE_STATE, FINALE_STATE_HOME)
    releaseall
}

// ---------------------------------------------------------------------------
// Post-game: DEOXYS at the summit, where it fell (D-111); once caught it is gone for good, once beaten it comes
// back after the next Hall of Fame (hall_of_fame.inc clears FLAG_DEFEATED_DEOXYS), as on Birth Island
// ---------------------------------------------------------------------------

script SkyPillar_Top_EventScript_DraconidDeoxys {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_DEOXYS_NORMAL, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setwildbattle(SPECIES_DEOXYS_NORMAL, DRACONID_DEOXYS_LEVEL)
    special(BattleSetup_StartLegendaryBattle)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
        setflag(FLAG_BATTLED_DEOXYS)
        removeobject(LOCALID_SKY_PILLAR_TOP_DEOXYS)
        release
        end
    }
    if (var(VAR_RESULT) == B_OUTCOME_WON) {
        setflag(FLAG_DEFEATED_DEOXYS)
    }
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_SKY_PILLAR_TOP_DEOXYS)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    setvar(VAR_0x8004, SPECIES_DEOXYS_NORMAL)
    bufferspeciesname(STR_VAR_1, VAR_0x8004)
    msgbox(gText_LegendaryFlewAway)
    release
}

// ---------------------------------------------------------------------------
// Post-game: BRENDAN and MAY in the Littleroot lab (moved from rivals.pory; the lab's scripts still call these
// labels). Once the finale is over they battle the player one at a time, then together (D-156).
// ---------------------------------------------------------------------------

// LittlerootTown_ProfessorBirchsLab_OnTransition calls this: BRENDAN waits by the door after the finale
script LittlerootTown_ProfessorBirchsLab_EventScript_DraconidPostgameLayout {
    if (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_METEOR_DESTROYED) {
        clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BIRCHS_LAB_BRENDAN)
        setobjectxyperm(LOCALID_BIRCHS_LAB_BRENDAN, 8, 10)
        setobjectmovementtype(LOCALID_BIRCHS_LAB_BRENDAN, MOVEMENT_TYPE_FACE_DOWN)
    }
}

// MAY (the lab's rival object) after the National Dex scene
script LittlerootTown_ProfessorBirchsLab_EventScript_DraconidPostgameMay {
    if (var(VAR_DRACONID_FINALE_STATE) < FINALE_STATE_METEOR_DESTROYED) {
        msgbox(format("MAY: Have you seen the sky? Something's burning up there!\p"
                      "If it has anything to do with dragons, {PLAYER}, it has to do with you. Go!"))
        release
        end
    }
    if (!defeated(TRAINER_MAY_POSTGAME)) {
        msgbox(format("MAY: {PLAYER}! The CHAMPION who saved the sky, right here in the lab!\p"
                      "I KNEW it way back on ROUTE 110, and I'm never going to stop saying so!\p"
                      "Now, you promised me one more battle. Everything we've got, okay?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format("MAY: BLAZIKEN, let's show {PLAYER} what we learned!"))
            trainerbattle_no_intro(TRAINER_MAY_POSTGAME, LittlerootTown_ProfessorBirchsLab_Text_DraconidMayPostgameDefeat)
            setvar(VAR_MAY_STATE, MAY_STATE_POSTGAME)
            msgbox(format("MAY: I'm writing all of this down, you know.\p"
                          "Someday people will want to hear the true story."))
        } else {
            msgbox(LittlerootTown_ProfessorBirchsLab_Text_DraconidRivalAnytime)
        }
        release
        end
    }
    goto(LittlerootTown_ProfessorBirchsLab_EventScript_DraconidPostgameDouble)
}

// BRENDAN (LittlerootTown_ProfessorBirchsLab_EventScript_Brendan comes here once the game is cleared)
script LittlerootTown_ProfessorBirchsLab_EventScript_DraconidPostgameBrendan {
    if (!defeated(TRAINER_BRENDAN_POSTGAME)) {
        msgbox(format("BRENDAN: {PLAYER}! You came! After your village… Man, we never did get that real battle.\p"
                      "Just you and me this time. Ready, CHAMPION?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {
            msgbox(format("BRENDAN: SCEPTILE, MEGA EVOLVE! No holding back this time!"))
            trainerbattle_no_intro(TRAINER_BRENDAN_POSTGAME, LittlerootTown_ProfessorBirchsLab_Text_DraconidBrendanPostgameDefeat)
            setvar(VAR_BRENDAN_STATE, BRENDAN_STATE_POSTGAME)
            msgbox(format("BRENDAN: Next time, I'm winning. Count on it."))
        } else {
            msgbox(LittlerootTown_ProfessorBirchsLab_Text_DraconidRivalAnytime)
        }
        release
        end
    }
    goto(LittlerootTown_ProfessorBirchsLab_EventScript_DraconidPostgameDouble)
}

script LittlerootTown_ProfessorBirchsLab_EventScript_DraconidPostgameDouble {
    if (!defeated(TRAINER_MAY_POSTGAME) || !defeated(TRAINER_BRENDAN_POSTGAME)) {
        msgbox(format("Did you battle both of us yet? Then we can team up for a real two-on-two!"))
        release
        end
    }
    if (defeated(TRAINER_BRENDAN_POSTGAME_DOUBLE)) {
        msgbox(LittlerootTown_ProfessorBirchsLab_Text_DraconidPostgameDone)
        release
        end
    }
    // "Like in LILYCOVE" only if that double was won: it can be skipped (D-273)
    if (defeated(TRAINER_BRENDAN_LILYCOVE)) {
        msgbox(format("BRENDAN: You beat us both, one at a time…\p"
                      "MAY: So how about both of us at once? Like in LILYCOVE…\p"
                      "…except this time, we know who we're battling!"), MSGBOX_YESNO)
    } else {
        msgbox(format("BRENDAN: One at a time wasn't\nenough, huh?\p"
                      "MAY: Then how about both of us\nat once?\p"
                      "Two on one, and this time we know who we're battling!"), MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO) {
        msgbox(LittlerootTown_ProfessorBirchsLab_Text_DraconidRivalAnytime)
        release
        end
    }
    special(HasEnoughMonsForDoubleBattle)
    if (var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS) {
        msgbox(format("MAY: Oh! You need at least two POKéMON that can battle for this one."))
        release
        end
    }
    msgbox(format("BRENDAN: MAY, let's go!\p"
                  "MAY: Right behind you!"))
    trainerbattle_two_trainers_no_intro(TRAINER_BRENDAN_POSTGAME_DOUBLE, LittlerootTown_ProfessorBirchsLab_Text_DraconidBrendanPostgameDefeat, TRAINER_MAY_POSTGAME_DOUBLE, LittlerootTown_ProfessorBirchsLab_Text_DraconidMayPostgameDefeat)
    msgbox(LittlerootTown_ProfessorBirchsLab_Text_DraconidPostgameDone)
    release
}

text LittlerootTown_ProfessorBirchsLab_Text_DraconidMayPostgameDefeat {
    format("MAY: That's our CHAMPION!")
}

text LittlerootTown_ProfessorBirchsLab_Text_DraconidBrendanPostgameDefeat {
    format("BRENDAN: Unbelievable… Still, that felt good.")
}

text LittlerootTown_ProfessorBirchsLab_Text_DraconidRivalAnytime {
    format("Any time you're ready!")
}

text LittlerootTown_ProfessorBirchsLab_Text_DraconidPostgameDone {
    format("MAY: Dad says the BATTLE FRONTIER is full of strong TRAINERS.\p"
           "BRENDAN: Let's all go some time! All three of us!")
}

// ---------------------------------------------------------------------------
// Post-game: ASTER at the village shrine (moved from aster.pory; DraconidVillage_Shrine_OnTransition calls
// ...DraconidAsterPostgame, the shrine's ASTER object runs ..._Aster)
// ---------------------------------------------------------------------------

script DraconidVillage_Shrine_EventScript_DraconidAsterPostgame {
    if (var(VAR_DRACONID_FINALE_STATE) >= FINALE_STATE_METEOR_DESTROYED && var(VAR_ASTER_STATE) == ASTER_STATE_SKY_PILLAR) {
        clearflag(FLAG_HIDE_DRACONID_SHRINE_ASTER)
        setobjectxyperm(LOCALID_DRACONID_SHRINE_ASTER, 10, 11) // below the GUARDIAN's statue, which moved to (10, 9) (act7x.pory)
        setobjectmovementtype(LOCALID_DRACONID_SHRINE_ASTER, MOVEMENT_TYPE_FACE_UP)
    }
}

script DraconidVillage_Shrine_EventScript_Aster {
    lock
    faceplayer
    msgbox(format("ASTER: The CHAMPION of HOENN, back where it all started.\p"
                  "The shrine held. …So did you.\p"
                  "No riddles today. Just you, me, and everything we've got. Ready?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("ASTER: I'll wait. The statue doesn't mind."))
        release
        end
    }
    trainerbattle_no_intro(TRAINER_ASTER_POSTGAME_DEINO, DraconidVillage_Shrine_Text_DraconidAsterPostgameDefeat)
    msgbox(format("ASTER: …You know what the answer to all my riddles was? The sky. It was always the sky.\p"
                  "The ELDER chose right, {PLAYER}. Don't you dare tell him I said so."))
    // she waits by the pond next, for the double with NERINE (draconid_rivals.pory, D-283)
    msgbox(format("ASTER: Come find me by the pond later. NERINE and I have an idea."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_DRACONID_SHRINE_ASTER)
    setflag(FLAG_HIDE_DRACONID_SHRINE_ASTER)
    setvar(VAR_ASTER_STATE, ASTER_STATE_POSTGAME)
    fadescreen(FADE_FROM_BLACK)
    release
}

text DraconidVillage_Shrine_Text_DraconidAsterPostgameDefeat {
    format("…Hmph. The wind was at your back again.")
}

// ---------------------------------------------------------------------------
// Post-game: NERINE by the village pond (28, 7), home at last (D-157; FLAG_HIDE_DRACONID_VILLAGE_NERINE, shown by
// the finale). Her team follows the player's egg and second starter (TRAINER_NERINE_POSTGAME_*, D-104).
// ---------------------------------------------------------------------------

script DraconidVillage_EventScript_DraconidNerine {
    lock
    faceplayer
    // before the LEAGUE she is home as herself (draconid_rivals.pory, D-281)
    if (var(VAR_DRACONID_FINALE_STATE) < FINALE_STATE_METEOR_DESTROYED) {
        goto(DraconidVillage_EventScript_DraconidNerineHome)
    }
    if (var(VAR_NERINE_STATE) == NERINE_STATE_POSTGAME) {
        // ASTER's shrine battle done too: their double by the pond (draconid_rivals.pory, D-283)
        if (var(VAR_ASTER_STATE) == ASTER_STATE_POSTGAME) {
            goto(DraconidVillage_EventScript_DraconidRivalsDouble)
        }
        msgbox(format("NERINE: The pond's still muddy from KYOGRE. It'll clear. Most things do.\p"
                      "When the sky calls again, we'll answer it together."))
        release
        end
    }
    if (defeated(TRAINER_NERINE_VILLAGE_DEINO_CHARMANDER)) {
        // they battled as themselves once already, before the LEAGUE (draconid_rivals.pory)
        msgbox(format("NERINE: The pond's still muddy from KYOGRE. Even so, it's good to be home.\p"
                      "Last time we battled, you were on your way to the LEAGUE. Look at you now.\p"
                      "One more, {PLAYER}? Everything we've got. Will you?"), MSGBOX_YESNO)
    } else {
        msgbox(format("NERINE: After years of salt water, even this muddy little pond feels like a dream.\p"
                      "I spent all that time in blue, pretending. And I watched you in red, pretending.\p"
                      "No more pretending, {PLAYER}. One battle, as ourselves. Will you?"), MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO) {
        msgbox(format("NERINE: I'll be here. The water isn't going anywhere, and neither am I."))
        release
        end
    }
    msgbox(format("NERINE: Then let the sky watch."))
    trainerbattle_no_intro(TRAINER_NERINE_POSTGAME_DEINO_CHARMANDER, DraconidVillage_Text_DraconidNerinePostgameDefeat)
    setvar(VAR_NERINE_STATE, NERINE_STATE_POSTGAME)
    msgbox(format("NERINE: …Yes. That's the tamer the ELDER saw, all those years ago.\p"
                  "I think I'll stay a while. It's good to be home."))
    release
}

text DraconidVillage_Text_DraconidNerinePostgameDefeat {
    format("NERINE: The sky chose well.")
}
