// Draconid Emerald: Aster's arc after Draconid Pass (Phase 4, reworked in round 1).
//
//   Meteor Falls, Jagged Pass (Mega Ring): data/scripts/draconid/act3.pory (round 1, Act 3)
//   The Sky Pillar finale and the post-game shrine battle: data/scripts/draconid/act7.pory (round 1, Act 7)
//
// VAR_ASTER_STATE: ASTER_STATE_* (include/constants/draconid.h). Aster's team counter-picks the
// player's egg; her trainer ids are named after the PLAYER's egg (VAR_STARTER_MON).
// Vanilla hooks are listed in docs/hack_changes.md ("Scripts").

// ---------------------------------------------------------------------------
// Shared (Aster's battles moved to act3.pory / act7.pory)
// ---------------------------------------------------------------------------

// Put the Team Magma disguise on or take it off (VAR_0x8004 = PLAYER_OUTFIT_*), behind a quick fade.
script Draconid_EventScript_ChangeOutfit {
    fadescreen(FADE_TO_BLACK)
    special(SetPlayerOutfit)
    playse(SE_BIKE_HOP)
    delay(20)
    fadescreen(FADE_FROM_BLACK)
}
