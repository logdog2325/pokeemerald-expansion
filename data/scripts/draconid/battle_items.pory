// ---------------------------------------------------------------------------
// Gym Leaders: their type's booster after the TM (D-220). Called from each gym's TM script right after the
// TM flag is set (both vanilla paths: straight after the battle, and on a later visit if the bag was full).
// A full bag only costs the booster; the counter sells it too.
// ---------------------------------------------------------------------------
script Draconid_EventScript_GymBoosterRoxanne {
    msgbox(format("ROXANNE: Please take this HARD STONE as well.\p"
                  "Held by a POKéMON, it strengthens ROCK-type moves."))
    giveitem(ITEM_HARD_STONE)
    return
}

script Draconid_EventScript_GymBoosterBrawly {
    msgbox(format("BRAWLY: Oh, and grab this BLACK BELT, too!\p"
                  "Hold it, and your FIGHTING-type moves hit like a big wave!"))
    giveitem(ITEM_BLACK_BELT)
    return
}

script Draconid_EventScript_GymBoosterWattson {
    msgbox(format("WATTSON: Wahahahaha! Take this MAGNET as well!\p"
                  "It charges up ELECTRIC-type moves. Zap!"))
    giveitem(ITEM_MAGNET)
    return
}

script Draconid_EventScript_GymBoosterFlannery {
    msgbox(format("FLANNERY: And… take this CHARCOAL, too.\p"
                  "It makes FIRE-type moves burn hotter. Use it well!"))
    giveitem(ITEM_CHARCOAL)
    return
}

script Draconid_EventScript_GymBoosterNorman {
    msgbox(format("NORMAN: Take this SILK SCARF, too.\p"
                  "It strengthens NORMAL-type moves. Simple, and strong."))
    giveitem(ITEM_SILK_SCARF)
    return
}

script Draconid_EventScript_GymBoosterWinona {
    msgbox(format("WINONA: Please accept this SHARP BEAK as well.\p"
                  "It lends strength to FLYING-type moves."))
    giveitem(ITEM_SHARP_BEAK)
    return
}

script Draconid_EventScript_GymBoosterTateAndLiza {
    msgbox(format("TATE: We have one more gift for you…\p"
                  "LIZA: …a TWISTED SPOON! It sharpens PSYCHIC-type moves!"))
    giveitem(ITEM_TWISTED_SPOON)
    return
}

script Draconid_EventScript_GymBoosterJuan {
    msgbox(format("JUAN: Please, accept this MYSTIC WATER as well.\p"
                  "It lends grace to WATER-type moves."))
    giveitem(ITEM_MYSTIC_WATER)
    return
}
