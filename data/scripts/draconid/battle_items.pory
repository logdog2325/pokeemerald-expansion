// Draconid Emerald round 1, feedback 1.33 (D-218 – D-222) and 2.5 (D-320 – D-325): battle items, Mega Stones
// and Z-Crystals.
//
// A second clerk behind the counter of every Poké Mart (and a third on the Lilycove Department Store 3F)
// runs the BATTLE ITEM counter. Its stock grows with the number of Gym Badges, so it follows the level caps
// (src/caps.c): type boosters from the start, Choice items and the first Mega Stones at six badges, the rest
// of the competitive items and more Mega Stones at eight. After the Champion the clerk asks which counter:
// the battle items (everything of the tiers), every Mega Stone or every Z-Crystal of the build. Tier table and
// prices: docs/hack_items.md. The Gym Leaders also hand over their type's booster with their TM (D-220).

// ---------------------------------------------------------------------------
// The counter clerk (map.json objects in the Marts point here)
// ---------------------------------------------------------------------------
script Draconid_EventScript_BattleItemClerk {
    lock
    faceplayer
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        message(Draconid_Text_BattleItemGreetingUniform)
    } elif (var(VAR_DRACONID_REPUTATION) == REPUTATION_REVEALED) {
        message(Draconid_Text_BattleItemGreetingRevealed)
    } else {
        message(Draconid_Text_BattleItemGreeting)
    }
    waitmessage
    call(Draconid_EventScript_CountBadges)
    if (flag(FLAG_IS_CHAMPION)) {
        call(Draconid_EventScript_BattleItemPostGame)
    } elif (var(VAR_RESULT) >= BATTLE_ITEMS_TIER_5_BADGES) {
        pokemart(Draconid_BattleItems_Tier5)
    } elif (var(VAR_RESULT) >= BATTLE_ITEMS_TIER_4_BADGES) {
        pokemart(Draconid_BattleItems_Tier4)
    } elif (var(VAR_RESULT) >= BATTLE_ITEMS_TIER_3_BADGES) {
        pokemart(Draconid_BattleItems_Tier3)
    } elif (var(VAR_RESULT) >= BATTLE_ITEMS_TIER_2_BADGES) {
        pokemart(Draconid_BattleItems_Tier2)
    } else {
        pokemart(Draconid_BattleItems_Tier1)
    }
    call(Draconid_EventScript_MartGoodbye)
    release
    end
}

// After the Champion (D-320): three lists instead of one of 216 entries – the battle items (every tier),
// every Mega Stone and every Z-Crystal (check_megas.py --write keeps the last two complete). The menu comes
// back after each list until the player cancels.
script Draconid_EventScript_BattleItemPostGame {
    waitbuttonpress  // the greeting's last box stays until the player has read it
    message(Draconid_Text_BattleItemPostGame)
    waitmessage
    setvar(VAR_0x8004, FALSE)
    while (var(VAR_0x8004) == FALSE) {
        dynmultichoice(17, 4, FALSE, 4, 0, DYN_MULTICHOICE_CB_NONE, "BATTLE ITEMS", "MEGA STONES", "Z-CRYSTALS", "CANCEL")
        switch (var(VAR_RESULT)) {
            case 0:
                pokemart(Draconid_BattleItems_Tier5)
            case 1:
                pokemart(Draconid_MegaStones_PostGame)
            case 2:
                pokemart(Draconid_ZCrystals_PostGame)
            default:
                setvar(VAR_0x8004, TRUE)
        }
        if (var(VAR_0x8004) == FALSE) {
            message(Draconid_Text_BattleItemAnotherList)
            waitmessage
        }
    }
    return
}

// VAR_RESULT = the number of Gym Badges (any order)
script Draconid_EventScript_CountBadges {
    setvar(VAR_RESULT, 0)
    if (flag(FLAG_BADGE01_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE02_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE03_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE04_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE05_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE06_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE07_GET)) { addvar(VAR_RESULT, 1) }
    if (flag(FLAG_BADGE08_GET)) { addvar(VAR_RESULT, 1) }
    return
}

text Draconid_Text_BattleItemGreeting {
    format("Welcome to the BATTLE ITEM counter!\p"
           "The more GYM BADGES you carry, the stronger the items I'm allowed to sell you.")
}

text Draconid_Text_BattleItemGreetingUniform {
    format("…Battle items for TEAM MAGMA. Wonderful.\p"
           "Rules are rules. Your BADGES decide what I sell you. Not your uniform.")
}

text Draconid_Text_BattleItemPostGame {
    format("For the CHAMPION, the whole stock: every MEGA STONE and every Z-CRYSTAL there is, too.\p"
           "What are you looking for?")
}

text Draconid_Text_BattleItemAnotherList {
    format("Would you like to see another list?")
}

text Draconid_Text_BattleItemGreetingRevealed {
    format("{PLAYER}! Everyone's talking about what you did in SOOTOPOLIS!\p"
           "Here, have a look. Everything your BADGES allow!")
}

// ---------------------------------------------------------------------------
// The stock: ONE list, newest tier first. Each tier's label starts its own new items and runs on through
// every lower tier to the single ITEM_NONE, so a tier sells everything below it and its new items come
// first in the shop. Tier badge counts: BATTLE_ITEMS_TIER_*_BADGES (include/constants/draconid.h).
// The tiers' Mega Stones are for Pokémon lines the player can get before the post-game: tools/hack/check_megas.py
// checks that every such stone has a source before it (an item ball, a gift or a tier; D-323).
// ---------------------------------------------------------------------------
