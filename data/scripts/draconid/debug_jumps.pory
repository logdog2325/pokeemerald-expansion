// The post-game: downstairs at home, the SS Ticket in the bag and the Lati news aired; out of the door the village
// waits (Nerine by the pond, Aster at the shrine, Drake by the Elder's door; Lance lands on a later visit)
script Debug_EventScript_DraconidJumpPostgame {
    lockall
    setvar(VAR_0x8008, DRACONID_JUMP_STOP_POSTGAME)
    call(Debug_EventScript_DraconidJumpBegin)
    call(Debug_EventScript_DraconidJumpState_POSTGAME)
    setrespawn(HEAL_LOCATION_DRACONID_VILLAGE_PLAYERS_HOUSE_2F)
    setvar(VAR_0x8006, DRACONID_JUMP_LEVEL_POSTGAME)
    call(Debug_EventScript_DraconidJumpCommon)
    warp(MAP_DRACONID_VILLAGE_PLAYERS_HOUSE_1F, 8, 6)
    waitstate
}

// ---------------------------------------------------------------------------
// Shared
// ---------------------------------------------------------------------------

// The rewind question (D-484): a save that has already played the chosen stop's first scene goes backwards; NO
// leaves everything as it was. Then the player's own choices are read before the state overwrites them.
script Debug_EventScript_DraconidJumpBegin {
    call(Debug_EventScript_DraconidJumpProgress)
    if (var(VAR_RESULT) > VAR_0x8008) {
        msgbox(format("This rewinds the story. Continue?"), MSGBOX_YESNO)
        if (var(VAR_RESULT) == NO) {
            closemessage
            releaseall
            end
        }
        closemessage
    }
    call(Debug_EventScript_DraconidJumpKeepChoices)
}

// What the story simulation doesn't give (D-482; docs/hack_progression.md, "Not modelled"), by the stop
// (VAR_0x8008) and the state just set
script Debug_EventScript_DraconidJumpCommon {
    // the Pokédex: the lab turns on the National Dex with a special (every stop is past the lab)
    special(EnableNationalPokedex)
    // Prof. Oak's crystals from ALOLA, by Stern's shipyard in Slateport (Act 2; he is off the story table's path):
    // every stop from Act 3 on has passed him
    if (var(VAR_0x8008) >= DRACONID_JUMP_STOP_ACT3) {
        setflag(FLAG_RECEIVED_OAK_Z_CRYSTAL)
        setvar(VAR_0x8005, 1)
    } else {
        clearflag(FLAG_RECEIVED_OAK_Z_CRYSTAL)
        setvar(VAR_0x8005, 0)
    }
    setvar(VAR_0x8004, DRACONID_Z_CRYSTAL_CHARMANDER)
    callnative(Draconid_DebugJumpSetItem)
    setvar(VAR_0x8004, DRACONID_Z_CRYSTAL_TOTODILE)
    callnative(Draconid_DebugJumpSetItem)
    setvar(VAR_0x8004, DRACONID_Z_CRYSTAL_TREECKO)
    callnative(Draconid_DebugJumpSetItem)
    // the Mega Stone for Prof. Oak's partner, from the Draconid traveller in Lavaridge (3.05; the simulation can't
    // tell which): Act 4 on, the partner's stone; before, none of the three
    if (var(VAR_0x8008) >= DRACONID_JUMP_STOP_ACT4) {
        switch (var(VAR_SECOND_STARTER)) {
            case SECOND_STARTER_CHARMANDER: setvar(VAR_0x8004, ITEM_CHARIZARDITE_X)
            case SECOND_STARTER_TOTODILE:   setvar(VAR_0x8004, ITEM_FERALIGITE)
            default:                        setvar(VAR_0x8004, ITEM_SCEPTILITE)
        }
        checkitem(VAR_0x8004)
        if (var(VAR_RESULT) == FALSE) {
            additem(VAR_0x8004)
        }
    } else {
        setvar(VAR_0x8005, 0)
        setvar(VAR_0x8004, ITEM_CHARIZARDITE_X)
        callnative(Draconid_DebugJumpSetItem)
        setvar(VAR_0x8004, ITEM_FERALIGITE)
        callnative(Draconid_DebugJumpSetItem)
        setvar(VAR_0x8004, ITEM_SCEPTILITE)
        callnative(Draconid_DebugJumpSetItem)
    }
    // the Devon Goods' reward follows the choice (D-258; the simulation takes the "returned" way, so the state has
    // Mr. Stone's AMULET COIN): a save that kept them has Tabitha's FIRE STONE instead (the museum, Act 2)
    if (var(VAR_0x8008) >= DRACONID_JUMP_STOP_ACT3 && !flag(FLAG_DEVON_GOODS_RETURNED)) {
        clearflag(FLAG_RECEIVED_AMULET_COIN)
        setvar(VAR_0x8004, DRACONID_GOODS_THANKS_ITEM)
        setvar(VAR_0x8005, 0)
        callnative(Draconid_DebugJumpSetItem)
        checkitem(DRACONID_GOODS_REWARD_ITEM)
        if (var(VAR_RESULT) == FALSE) {
            additem(DRACONID_GOODS_REWARD_ITEM)
        }
    }
    // the KOMMONIUM Z Nerine leaves a Jangmo-o tamer on the Mt. Pyre summit (4.13): Act 5 on, for that egg only
    setvar(VAR_0x8005, 0)
    clearflag(FLAG_RECEIVED_KOMMONIUM_Z)
    if (var(VAR_0x8008) >= DRACONID_JUMP_STOP_ACT5 && var(VAR_STARTER_MON) == DRACONID_EGG_JANGMO_O) {
        setflag(FLAG_RECEIVED_KOMMONIUM_Z)
        setvar(VAR_0x8005, 1)
    }
    setvar(VAR_0x8004, DRACONID_Z_CRYSTAL_JANGMO_O)
    callnative(Draconid_DebugJumpSetItem)
    // Maxie's calls (D-186) ring from a C step hook: the one due here has rung already, none is left to ring
    specialvar(VAR_RESULT, Draconid_GetDueMaxieCall)
    if (var(VAR_RESULT) != MAXIE_CALL_NONE) {
        copyvar(VAR_MAXIE_CALL, VAR_RESULT)
    }
    setvar(VAR_MAXIE_CALL_STEPS, 0)
    // the Lati roamers: from the SS Ticket's news on (the post-game), not before
    setvar(VAR_0x8004, FALSE)
    if (var(VAR_0x8008) >= DRACONID_JUMP_STOP_POSTGAME) {
        setvar(VAR_0x8004, TRUE)
    }
    callnative(Draconid_DebugJumpRoamers)
    // the party (D-483): a ready team if the player's own is behind the stop's level; after the summit, RAYQUAZA
    // with DRAGON ASCENT; then money, medicine and Poké Balls
    callnative(Draconid_DebugJumpTeam)
    if (var(VAR_0x8008) >= DRACONID_JUMP_STOP_VILLAGE) {
        callnative(Draconid_DebugJumpRayquaza)
        callnative(Draconid_PrepareRayquaza)
    }
    callnative(Draconid_DebugJumpSupplies)
    special(HealPlayerParty)
    // the outfit follows the reputation (the Magma uniform from the outpost to the Sootopolis turn, D-101)
    setvar(VAR_0x8004, PLAYER_OUTFIT_DRACONID)
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        setvar(VAR_0x8004, PLAYER_OUTFIT_MAGMA)
    }
    call(Draconid_EventScript_ChangeOutfit)
}
