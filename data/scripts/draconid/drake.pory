// Draconid Emerald round 2, feedback 2.14 ("give drake something cool to do in the story … or have some of his
// backstory revealed"): DRAKE, the ELITE FOUR's DRAGON master, is the ELDER's younger brother (D-440 - D-444).
//
//   Lore (D-440)      Born in the village below the shrine. He and his brother hatched their BAGON the same spring
//                     (the ELDER's "old dragon" is the other SALAMENCE). Forty years ago he flew down off the
//                     mountain to see the sea; the clan keeps to its mountain (its people go down to trade and come
//                     home), and his brother told him that if he left, he need not come back. He never did: he
//                     sailed the world and became HOENN's dragon master, and never once flew over the mountains.
//   The LEAGUE (D-442) his room's speeches (EverGrandeCity_DrakesRoom/scripts.inc calls these): before the first
//                     win he knows the player's horned band; after it he tells them who he is and asks them to say
//                     nothing to his brother (FLAG_DRACONID_DRAKE_TOLD). Later runs: a short line, and after the
//                     finale (VILLAGE_STATE_SAVED) the lines of a man who has gone home. His teams are unchanged.
//   The village (D-443) the Act 7 attack, at the shrine (act7x.pory calls these): MAXIE turns PRIMAL GROUDON on the
//                     shrine door; DRAKE's SALAMENCE drops out of the storm and takes the blow, and DRAKE holds the
//                     door while the player and BRENDAN or MAY fight MAXIE and ARCHIE. After the win the brothers
//                     face each other for the first time in forty years; DRAKE keeps watch on the pass that night.
//   Post-game (D-444) DRAKE and his SALAMENCE by the ELDER's door. The first talk: the ELDER comes out and the two
//                     make peace (FLAG_DRACONID_DRAKE_RECONCILED); from then on DRAKE teaches DRACO METEOR.
//
// Objects (DraconidVillage/map.json, the last two): DRAKE (26, 12) and his SALAMENCE (27, 12), on FLAG_TEMP_10 (FLAG_TEMP_1F is ASTER's home object, D-279), which
// DraconidVillage_EventScript_DrakeOnTransition sets whenever they aren't there (D-136). During the Primal battle
// (VILLAGE_STATE_FINAL) DRAKE stands before the shrine door and the SALAMENCE at the foot of the crater, glaring at
// GROUDON; post-game at their map.json spot.

// DRAKE in front of the shrine door, below the ELDER; his SALAMENCE two tiles below him at the foot of the crater, so
// its 32x32 sprite doesn't hide him (he rides it one tile up, (19, 8), and jumps from its back to the door)
const DRAKE_DOOR_X = 19
const DRAKE_DOOR_Y = 7
const DRAKE_RIDING_Y = 8
const DRAKE_SALAMENCE_CRATER_X = 19
const DRAKE_SALAMENCE_CRATER_Y = 9
// MAXIE and ARCHIE, thrown a step aside when the SALAMENCE lands (act7x.pory has them at (18, 8) and (20, 8))
const DRAKE_MAXIE_ASIDE_X = 17
const DRAKE_ARCHIE_ASIDE_X = 21
const DRAKE_LEADERS_Y = 8
// Post-game: the ELDER's door, where he comes out to his brother
const DRAKE_ELDER_DOOR_X = 24
const DRAKE_ELDER_DOOR_Y = 11

// ---------------------------------------------------------------------------
// The LEAGUE: DRAKE's room. The vanilla script plays the encounter music, then calls the intro; after the win (and
// when the player talks to him again) it calls the post-battle speech. Draconid_ResolveVariantTrainer still swaps in
// TRAINER_DRAKE_REMATCH after the Hall of Fame (D-174).
// ---------------------------------------------------------------------------

script EverGrandeCity_DrakesRoom_EventScript_DraconidIntro {
    if (var(VAR_DRACONID_VILLAGE_STATE) >= VILLAGE_STATE_SAVED) {
        msgbox(format("Ah, {PLAYER}! These days I keep the LEAGUE's door by day, and fly home to the village by night.\p"
                      "My brother says it took me forty years to learn the way back."))
        msgbox(format("But in this room, I am still the last of the ELITE FOUR.\p"
                      "Show me again what is needed!"))
    } elif (flag(FLAG_DRACONID_DRAKE_TOLD)) {
        msgbox(format("You again, {PLAYER}. I take it you have said nothing to my brother.\p"
                      "Good. Then let our POKéMON\ndo the talking."))
        msgbox(format("I am the last of the POKéMON LEAGUE\nELITE FOUR, DRAKE the DRAGON master!\p"
                      "Show me again what is needed!"))
    } else {
        msgbox(format("I am the last of the POKéMON LEAGUE\nELITE FOUR, DRAKE the DRAGON master!"))
        msgbox(format("…Hm? That band on your brow.\nTeal cloth, two horns of ivory.\p"
                      "I have not seen one of those\nin forty years."))
        msgbox(format("For us to battle with POKéMON as\npartners, do you know what it takes?\p"
                      "Do you know what is needed?\p"
                      "If you don't, then you will never\nprevail over me!"))
    }
}

script EverGrandeCity_DrakesRoom_EventScript_DraconidPostBattle {
    if (var(VAR_DRACONID_VILLAGE_STATE) >= VILLAGE_STATE_SAVED) {
        msgbox(format("Go onwards, {PLAYER}.\nThe CHAMPION is waiting.\p"
                      "I will see you at home."))
    } elif (flag(FLAG_DRACONID_DRAKE_TOLD)) {
        msgbox(format("Go! Go onwards!\nThe CHAMPION is waiting!\p"
                      "…And not a word to my brother."))
    } else {
        msgbox(format("You deserve every credit for coming this far, {PLAYER}.\p"
                      "You do seem to know what is needed."))
        msgbox(format("And that dragon of yours fought like one hatched below the shrine, from one of the ELDER's eggs."))
        msgbox(format("Yes. I know that band, and I know that shrine. I was born below it."))
        msgbox(format("The ELDER who gave you your egg\nis my older brother.\p"
                      "We hatched our BAGON the same spring."))
        msgbox(format("Forty years ago, I flew mine down off the mountain to see the sea.\p"
                      "Our clan keeps to its mountain. My brother told me that if I left, I need not come back.\p"
                      "I never did."))
        msgbox(format("…Say nothing of me to him. Forty years is too long for a message.\p"
                      "Go! Go onwards!\nThe CHAMPION is waiting!"))
        setflag(FLAG_DRACONID_DRAKE_TOLD)
    }
}

// ---------------------------------------------------------------------------
// The village: who stands where (DraconidVillage_OnTransition calls this after the attack's own hook)
// ---------------------------------------------------------------------------

script DraconidVillage_EventScript_DrakeOnTransition {
    if (var(VAR_DRACONID_VILLAGE_STATE) == VILLAGE_STATE_FINAL) {
        // the Primal battle, and its retries after a loss: DRAKE holds the shrine door
        setobjectxyperm(LOCALID_DRACONID_VILLAGE_DRAKE, DRAKE_DOOR_X, DRAKE_DOOR_Y)
        setobjectmovementtype(LOCALID_DRACONID_VILLAGE_DRAKE, MOVEMENT_TYPE_FACE_DOWN)
        setobjectxyperm(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE, DRAKE_SALAMENCE_CRATER_X, DRAKE_SALAMENCE_CRATER_Y)
        setobjectmovementtype(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE, MOVEMENT_TYPE_FACE_LEFT)
        setobjectxyperm(LOCALID_DRACONID_VILLAGE_MAXIE, DRAKE_MAXIE_ASIDE_X, DRAKE_LEADERS_Y)
        setobjectxyperm(LOCALID_DRACONID_VILLAGE_ARCHIE, DRAKE_ARCHIE_ASIDE_X, DRAKE_LEADERS_Y)
    } elif (var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_SAVED) {
        // before he comes (he flies in during MAXIE and ARCHIE's scene), and that evening (he keeps watch on the pass)
        setflag(FLAG_TEMP_10)
    }
}

// ---------------------------------------------------------------------------
// The village under attack (DraconidVillage_EventScript_DraconidFinalIntro calls this after MAXIE's "Behold
// GROUDON"): MAXIE turns GROUDON on the shrine door; the SALAMENCE dives into the crater with DRAKE on its back (he
// rides one tile up, behind its head) and takes the blow; MAXIE and ARCHIE are thrown a step aside; DRAKE leaps from
// its back to the shrine door.
// ---------------------------------------------------------------------------

script DraconidVillage_EventScript_DrakeComesHome {
    // the camera goes up to the shrine door (the ELDER is off the top of the screen from the player's (19, 11))
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, DraconidVillage_Movement_DrakeCameraUp)
    waitmovement(0)
    applymovement(LOCALID_DRACONID_VILLAGE_MAXIE, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(format("MAXIE: GROUDON! Bury that shrine, and the old man in its door!"))
    closemessage
    playmoncry(SPECIES_GROUDON_PRIMAL, CRY_MODE_ENCOUNTER)
    call(Draconid_EventScript_FinaleQuake)
    waitmoncry
    playmoncry(SPECIES_SALAMENCE, CRY_MODE_ENCOUNTER)
    applymovement(LOCALID_PLAYER, Common_Movement_ExclamationMark)
    waitmovement(0)
    waitmoncry
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE, DRAKE_SALAMENCE_CRATER_X, DRAKE_SALAMENCE_CRATER_Y)
    setobjectmovementtype(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE, MOVEMENT_TYPE_FACE_LEFT)
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_DRAKE, DRAKE_DOOR_X, DRAKE_RIDING_Y)
    setobjectmovementtype(LOCALID_DRACONID_VILLAGE_DRAKE, MOVEMENT_TYPE_FACE_LEFT)
    clearflag(FLAG_TEMP_10)
    addobject(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE)
    addobject(LOCALID_DRACONID_VILLAGE_DRAKE)
    playse(SE_M_FLY)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE, DraconidVillage_Movement_DrakeFlyDown)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, DraconidVillage_Movement_DrakeFlyDown)
    waitmovement(0)
    // the blow: a white flash, and MAXIE and ARCHIE stagger a step aside from the dragon between them
    playse(SE_M_DRAGON_RAGE)
    fadescreenswapbuffers(FADE_TO_WHITE)
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_MAXIE, DRAKE_MAXIE_ASIDE_X, DRAKE_LEADERS_Y)
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_ARCHIE, DRAKE_ARCHIE_ASIDE_X, DRAKE_LEADERS_Y)
    setobjectxy(LOCALID_DRACONID_VILLAGE_MAXIE, DRAKE_MAXIE_ASIDE_X, DRAKE_LEADERS_Y)
    setobjectxy(LOCALID_DRACONID_VILLAGE_ARCHIE, DRAKE_ARCHIE_ASIDE_X, DRAKE_LEADERS_Y)
    turnobject(LOCALID_DRACONID_VILLAGE_MAXIE, DIR_EAST)
    turnobject(LOCALID_DRACONID_VILLAGE_ARCHIE, DIR_WEST)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    playmoncry(SPECIES_SALAMENCE, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("A SALAMENCE plunged out of the storm and took GROUDON's blow on its wings!"))
    closemessage
    // DRAKE leaps from its back to the shrine door, in front of his brother
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_DRAKE, DRAKE_DOOR_X, DRAKE_DOOR_Y)
    setobjectmovementtype(LOCALID_DRACONID_VILLAGE_DRAKE, MOVEMENT_TYPE_FACE_DOWN)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, DraconidVillage_Movement_DrakeLeapsToTheDoor)
    waitmovement(0)
    msgbox(format("DRAKE: Hmph. Is that how you knock on a door, MAXIE?"))
    msgbox(format("MAXIE: DRAKE… The ELITE FOUR's\nDRAGON master.\p"
                  "This is no concern of the LEAGUE's."))
    msgbox(format("DRAKE: The LEAGUE didn't send me. I was born on this mountain."))
    msgbox(format("ARCHIE: Born up here? Fufufu… So the old sea dog is a sky-watcher too!"))
    closemessage
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(format("ELDER: …DRAKE."))
    msgbox(format("DRAKE: Forty years, brother.\nAnd still you guard the door yourself."))
    closemessage
    applymovement(LOCALID_DRACONID_VILLAGE_ASTER, Common_Movement_ExclamationMark)
    waitmovement(0)
    msgbox(format("ASTER: B-BROTHER?!"))
    closemessage
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(format("DRAKE: {PLAYER}!\nMAXIE and ARCHIE are yours.\p"
                  "Nothing touches this door\nwhile I stand in it."))
    closemessage
    turnobject(LOCALID_DRACONID_VILLAGE_MAXIE, DIR_SOUTH)
    turnobject(LOCALID_DRACONID_VILLAGE_ARCHIE, DIR_SOUTH)
    applymovement(LOCALID_CAMERA, DraconidVillage_Movement_DrakeCameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
}

// After the win (DraconidVillage_EventScript_DraconidPrimalWon calls this once MAXIE and ARCHIE have gone down the
// pass): the brothers face each other; DRAKE keeps watch on the pass that night, so the evening's goodbyes are the
// rivals' (act7x.pory) and the two talk properly in the post-game.
script DraconidVillage_EventScript_DrakeAndTheElder {
    special(SpawnCameraObject)
    applymovement(LOCALID_CAMERA, DraconidVillage_Movement_DrakeCameraUp)
    waitmovement(0)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(format("ELDER: You came home."))
    msgbox(format("DRAKE: The sky split open over half of HOENN, brother. Even an old sailor knows what that means."))
    msgbox(format("ELDER: The traders spoke of a dragon master in the lowlanders' LEAGUE, with a SALAMENCE.\p"
                  "I knew it was you. I never said your name aloud."))
    msgbox(format("DRAKE: And I never once flew over these mountains, for fear you would see me."))
    msgbox(format("ELDER: Forty years, DRAKE."))
    msgbox(format("DRAKE: …I know. We will talk, brother.\nThere is a great deal to say."))
    closemessage
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(format("DRAKE: Tonight I will watch the pass,\nin case MAXIE's people come back.\p"
                  "{PLAYER}… Thank you.\nYou brought an old fool home."))
    closemessage
    // back onto his SALAMENCE's back, and away
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, DraconidVillage_Movement_DrakeMounts)
    waitmovement(0)
    playse(SE_M_FLY)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE, DraconidVillage_Movement_DrakeFlyUp)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, DraconidVillage_Movement_DrakeFlyUp)
    waitmovement(0)
    removeobject(LOCALID_DRACONID_VILLAGE_DRAKE)
    removeobject(LOCALID_DRACONID_VILLAGE_DRAKE_SALAMENCE)
    applymovement(LOCALID_CAMERA, DraconidVillage_Movement_DrakeCameraDown)
    waitmovement(0)
    special(RemoveCameraObject)
}

// ---------------------------------------------------------------------------
// DRAKE and his SALAMENCE: at the shrine door during the Primal battle, by the ELDER's door after the finale
// ---------------------------------------------------------------------------

script DraconidVillage_EventScript_Drake {
    lock
    faceplayer
    if (var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_SAVED) {
        msgbox(format("DRAKE: Nothing touches this door\nwhile I stand in it.\p"
                      "Go, {PLAYER}!\nMAXIE and ARCHIE are yours."))
        release
        end
    }
    if (!flag(FLAG_DRACONID_DRAKE_RECONCILED)) {
        goto(DraconidVillage_EventScript_DrakeMakesPeace)
    }
    if (!flag(FLAG_HIDE_DRACONID_VILLAGE_LANCE)) {
        msgbox(format("DRAKE: So the NORTHERN WING came home this year, too.\p"
                      "The old songs will need a new verse."))
    } else {
        msgbox(format("DRAKE: My brother and I have forty years of stories to trade.\p"
                      "Some of mine are even true."))
    }
    goto(DraconidVillage_EventScript_DrakeTutor)
}

// The first post-game talk: the ELDER comes out of his house (24, 11) to the path below his door (the scene ELDER of
// lance.pory, an addobject-only object) and the brothers make peace; then DRACO METEOR
script DraconidVillage_EventScript_DrakeMakesPeace {
    msgbox(format("DRAKE: {PLAYER}. I asked you to say nothing of me to my brother.\p"
                  "And then I flew home and told him everything myself."))
    msgbox(format("DRAKE: Forty years I kept away. In the end, it took MAXIE and ARCHIE knocking on our door."))
    closemessage
    playse(SE_DOOR)
    setobjectxyperm(LOCALID_DRACONID_VILLAGE_LANCE_ELDER, DRAKE_ELDER_DOOR_X, DRAKE_ELDER_DOOR_Y)
    setobjectmovementtype(LOCALID_DRACONID_VILLAGE_LANCE_ELDER, MOVEMENT_TYPE_FACE_DOWN)
    addobject(LOCALID_DRACONID_VILLAGE_LANCE_ELDER)
    applymovement(LOCALID_DRACONID_VILLAGE_LANCE_ELDER, DraconidVillage_Movement_DrakeElderComesOut)
    waitmovement(0)
    msgbox(format("ELDER: DRAKE.\nYour tea has gone cold again."))
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(format("DRAKE: I was telling {PLAYER} how I ran off to sea, brother."))
    msgbox(format("ELDER: And how I told you\nnever to come back.\p"
                  "I said it in anger, and then I was too proud to take it back."))
    msgbox(format("DRAKE: And I was too proud to ask.\nTwo stubborn old dragons."))
    msgbox(format("ELDER: Our songs say that one wing flew north and did not come back.\p"
                  "I never wanted to sing that verse for my own brother."))
    msgbox(format("ELDER: Now I will not have to.\nWelcome home, DRAKE."))
    msgbox(format("DRAKE: …It is good to be home."))
    closemessage
    applymovement(LOCALID_DRACONID_VILLAGE_LANCE_ELDER, DraconidVillage_Movement_DrakeElderGoesIn)
    waitmovement(0)
    playse(SE_DOOR)
    removeobject(LOCALID_DRACONID_VILLAGE_LANCE_ELDER)
    setflag(FLAG_DRACONID_DRAKE_RECONCILED)
    applymovement(LOCALID_DRACONID_VILLAGE_DRAKE, Common_Movement_FacePlayer)
    waitmovement(0)
    msgbox(format("DRAKE: Before I left, our father taught us both the clan's oldest move.\p"
                  "It is time someone else learned it."))
    goto(DraconidVillage_EventScript_DrakeTutor)
}

// DRACO METEOR, whenever asked, for any POKéMON that can learn it (the move tutor's own check). make_tutors.py
// finds the move here (it reads data/scripts/draconid/ too), so the dragons' teachable learnsets have it (D-444).
script DraconidVillage_EventScript_DrakeTutor {
    move_tutor(MOVE_DRACO_METEOR, DraconidVillage_Text_DrakeTutorTeach, DraconidVillage_Text_DrakeTutorWhichMon, DraconidVillage_EventScript_DrakeTutorDeclined, DraconidVillage_EventScript_DrakeTutorTaught)
    release
    end
}

script DraconidVillage_EventScript_DrakeTutorDeclined {
    msgbox(format("DRAKE: Come back whenever you like.\nI am not going anywhere now."))
    release
    end
}

script DraconidVillage_EventScript_DrakeTutorTaught {
    msgbox(format("DRAKE: Every time the stars fall, they take something from the TRAINER who called them.\p"
                  "Use it wisely."))
    release
    end
}

text DraconidVillage_Text_DrakeTutorTeach {
    format("DRAKE: DRACO METEOR calls the stars down on the foe, as the sky once fell on this mountain.\p"
           "Shall I teach it to one of\nyour POKéMON?")
}

text DraconidVillage_Text_DrakeTutorWhichMon {
    format("DRAKE: Which one? Only a POKéMON with a dragon's heart can bear it.")
}

script DraconidVillage_EventScript_DrakeSalamence {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_SALAMENCE, CRY_MODE_NORMAL)
    msgbox(format("SALAMENCE: Grrooaah!"))
    waitmoncry
    if (var(VAR_DRACONID_VILLAGE_STATE) < VILLAGE_STATE_SAVED) {
        msgbox(format("DRAKE's SALAMENCE kept its eyes on GROUDON, its wings spread before the shrine."))
    } else {
        msgbox(format("DRAKE's SALAMENCE has curled up by the ELDER's door, as if it had never left."))
    }
    release
}

// ---------------------------------------------------------------------------
// Movements
// ---------------------------------------------------------------------------

// down out of the sky onto its tile (the SALAMENCE in the crater, DRAKE on its back one tile up)
movement DraconidVillage_Movement_DrakeFlyDown {
    fly_down
}

movement DraconidVillage_Movement_DrakeFlyUp {
    fly_up
}

// DRAKE from the SALAMENCE's back (19, 8) to the shrine door (19, 7), turning to face the crater
movement DraconidVillage_Movement_DrakeLeapsToTheDoor {
    face_up
    jump_up
    face_down
}

// and back onto its back, (19, 8), for the flight
movement DraconidVillage_Movement_DrakeMounts {
    jump_down
    face_left
}

// from the player (the battle starts at (19, 11)) up the crater to the shrine door, and back
movement DraconidVillage_Movement_DrakeCameraUp {
    walk_up * 3
}

movement DraconidVillage_Movement_DrakeCameraDown {
    walk_down * 3
}

// the ELDER from his door (24, 11) one step down onto the path, facing DRAKE (26, 12)
movement DraconidVillage_Movement_DrakeElderComesOut {
    walk_down
    face_right
}

movement DraconidVillage_Movement_DrakeElderGoesIn {
    walk_up
}
