// Draconid Emerald: extra new-game state, called from EventScript_ResetAllMapFlags
// (data/scripts/new_game.inc). The player now lives in Draconid Village, so Littleroot is
// put into its "intro finished, nobody moved in" state. See docs/hack_notes_early_game.md.

script DraconidEmerald_EventScript_NewGameSetup {
    // Littleroot: no truck, no moving boxes, no player's Mom, no set-the-clock scenes
    setvar(VAR_LITTLEROOT_INTRO_STATE, 7)
    // 4 = inert: the player only reaches Littleroot after rescuing Birch on Route 101
    // (0 traps the player, 1/2 are the twin's "go save Birch" lines, 3 is Mom's Running Shoes)
    setvar(VAR_LITTLEROOT_TOWN_STATE, 4)
    // 1 = the rescue starts at Route 101's west entrance (birch_intro.pory), no popup hiding
    setvar(VAR_ROUTE101_STATE, 1)
    setflag(FLAG_HIDE_ROUTE_101_BIRCH_STARTERS_BAG)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BIRCHS_LAB_BRENDAN)
    // Rival scenes that vanilla doesn't have (rivals.pory) start hidden
    setflag(FLAG_HIDE_OCEANIC_MUSEUM_TABITHA)
    setflag(FLAG_HIDE_SOOTOPOLIS_CITY_RIVALS)
    setflag(FLAG_HIDE_PETALBURG_CITY_WALLY_GYM)
    setflag(FLAG_HIDE_LILYCOVE_CITY_WALLY)
    setflag(FLAG_HIDE_MOSSDEEP_SPACE_CENTER_RIVALS)
    setflag(FLAG_HIDE_RUSTBORO_CITY_BIRCH)
    setflag(FLAG_HIDE_METEOR_FALLS_ASTER)
    setflag(FLAG_HIDE_SKY_PILLAR_TOP_ASTER)
    // 3 = rivals already met; stops the 2F "meet your new neighbour" scenes
    setvar(VAR_LITTLEROOT_RIVAL_STATE, 3)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_MOM)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_MOM)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_1)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTH_2)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_POKE_BALL)
    setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_2F_POKE_BALL)
    // the clocks in the Littleroot houses belong to the rivals' families now
    setflag(FLAG_SET_WALL_CLOCK)
    // May waits on Route 103 only after the lab scene (fixes the vanilla Pokédex sequence break)
    setflag(FLAG_HIDE_ROUTE_103_RIVAL)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN)

    // Draconid Village
    setflag(FLAG_HIDE_DRACONID_ELDERS_HOUSE_ASTER)
    setflag(FLAG_HIDE_DRACONID_VILLAGE_ASTER)
    setflag(FLAG_HIDE_DRACONID_SHRINE_ELDER)
    setflag(FLAG_HIDE_DRACONID_SHRINE_ASTER)
    setflag(FLAG_HIDE_DRACONID_PASS_ASTER)
    setflag(FLAG_HIDE_DRACONID_VILLAGE_SHOES_GIVER)
    setvar(VAR_DRACONID_STATE, DRACONID_STATE_NEW_GAME)
    setvar(VAR_PLAYER_OUTFIT, PLAYER_OUTFIT_DRACONID)
    setvar(VAR_DRACONID_REPUTATION, REPUTATION_PRE_UNIFORM)
    setflag(FLAG_HIDE_DRACONID_HOUSE_ELDER)
    setflag(FLAG_HIDE_DRACONID_HOUSE_2F_ASTER)
    // Act 1: Courtney steps out of the trees after Nerine is beaten in Petalburg Woods
    setflag(FLAG_HIDE_PETALBURG_WOODS_COURTNEY)
    setflag(FLAG_HIDE_RUSTBORO_CITY_TABITHA)
    // Act 3: Aster waits at the top of Jagged Pass after Mt. Chimney; the Draconid traveller in Lavaridge
    setflag(FLAG_HIDE_JAGGED_PASS_ASTER)
    setflag(FLAG_HIDE_LAVARIDGE_TOWN_DRACONID_TRAVELLER)
    // Acts 6–7: Nerine comes home to the village pond after the finale
    setflag(FLAG_HIDE_DRACONID_VILLAGE_NERINE)
    // blacking out before the first Pokémon Center brings the player home
    setrespawn(HEAL_LOCATION_DRACONID_VILLAGE_PLAYERS_HOUSE_2F)
}
