    }
}

text FallarborTown_Mart_Text_DraconidRepPokefanMUniform {
    format("I found this NUGGET and I suppose I'll have to sell it.\p"
           "Don't even think about it, TEAM MAGMA. It's mine.")
}

// Move tutor (METRONOME) at (7, 2)
script FallarborTown_Mart_EventScript_DraconidRepMetronomeTutor {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
