// Draconid Emerald: reputation dialogue – Fallarbor Town (D-103; shared NPCs in shared.pory).
// Each townsperson's map.json "script" points here; PRE_UNIFORM goes on to the vanilla script.
// Lines collected in docs/reputation_dialogue.md.

// Girl with her Azurill at (8, 11) (vanilla: "This is my precious AZURILL!")
script FallarborTown_EventScript_DraconidRepGirl {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            lock
            faceplayer
            msgbox(FallarborTown_Text_DraconidRepGirlUniform, MSGBOX_DEFAULT)
            goto(Draconid_EventScript_RepTurnAway)
        case REPUTATION_REVEALED:
            msgbox(FallarborTown_Text_DraconidRepGirlRevealed, MSGBOX_NPC)
        default:
            goto(FallarborTown_EventScript_Girl)
    }
}

text FallarborTown_Text_DraconidRepGirlUniform {
    format("This is my precious AZURILL. You can't have it!\p"
           "TEAM MAGMA isn't taking my AZURILL anywhere!")
}

text FallarborTown_Text_DraconidRepGirlRevealed {
    format("See! This is my precious AZURILL!\p"
           "It's slick and smooth and plushy! You can pet it, if you like!")
}

// Old man at (11, 9) (vanilla: shady characters at COZMO's home → meteors)
script FallarborTown_EventScript_DraconidRepExpertM {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            lock
            faceplayer
            msgbox(FallarborTown_Text_DraconidRepExpertMUniform, MSGBOX_DEFAULT)
            goto(Draconid_EventScript_RepTurnAway)
        case REPUTATION_REVEALED:
            msgbox(FallarborTown_Text_DraconidRepExpertMRevealed, MSGBOX_NPC)
        default:
            goto(FallarborTown_EventScript_ExpertM)
    }
}

text FallarborTown_Text_DraconidRepExpertMUniform {
    format("You! I've seen your kind around PROF. COZMO's home!\p"
           "What does TEAM MAGMA want with him? …Hmph! I'm watching you.")
}

text FallarborTown_Text_DraconidRepExpertMRevealed {
    format("I shouted at you about PROF. COZMO…\p"
           "But you were working against TEAM MAGMA all along. I'm sorry.")
}

// Gentleman at (11, 15) (vanilla: FLANNERY's grandfather was one of the ELITE FOUR)
script FallarborTown_EventScript_DraconidRepGentleman {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_Text_DraconidRepGentlemanUniform, MSGBOX_NPC)
        case REPUTATION_REVEALED:
            msgbox(FallarborTown_Text_DraconidRepGentlemanRevealed, MSGBOX_NPC)
        default:
            goto(FallarborTown_EventScript_Gentleman)
    }
}

text FallarborTown_Text_DraconidRepGentlemanUniform {
    format("The ash that falls on FALLARBOR comes from MT. CHIMNEY.\p"
           "And I hear TEAM MAGMA has been meddling with it. …Shameful.")
}

text FallarborTown_Text_DraconidRepGentlemanRevealed {
    format("FLANNERY's grandfather was one of the ELITE FOUR.\p"
           "But you… You might be greater than any of them!")
}

// Old man in the Pokémon Center at (2, 3) (vanilla: hardy trees that grow in volcanic ash)
script FallarborTown_PokemonCenter_1F_EventScript_DraconidRepExpertM {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_PokemonCenter_1F_Text_DraconidRepExpertMUniform, MSGBOX_NPC)
        case REPUTATION_REVEALED:
            msgbox(FallarborTown_PokemonCenter_1F_Text_DraconidRepExpertMRevealed, MSGBOX_NPC)
        default:
            goto(FallarborTown_PokemonCenter_1F_EventScript_ExpertM)
    }
}

text FallarborTown_PokemonCenter_1F_Text_DraconidRepExpertMUniform {
    format("We plant trees that grow even in volcanic ash.\p"
           "TEAM MAGMA plants nothing. It only burns.")
}

text FallarborTown_PokemonCenter_1F_Text_DraconidRepExpertMRevealed {
    format("We plant trees that grow even in volcanic ash.\p"
           "I'll plant one for you, {PLAYER}. So FALLARBOR remembers.")
}

// PROF. COZMO (round 1 contradiction scrub, D-255): the grunt he saw beside MAXIE at METEOR FALLS walks in with
// the METEORITE that MAGMA took from him. FallarborTown_CozmosHouse_EventScript_NoticeMeteorite (a called
// script) jumps here in the uniform; the YES/NO answer goes back to its caller in VAR_RESULT, and the vanilla
// trade follows (the TM, FLAG_RECEIVED_TM_RETURN). After the reveal he says why he thinks it came back.
script FallarborTown_CozmosHouse_EventScript_DraconidRepNoticeMeteoriteUniform {
    msgbox(FallarborTown_CozmosHouse_Text_DraconidRepCozmoUniform, MSGBOX_YESNO)
}

text FallarborTown_CozmosHouse_Text_DraconidRepCozmoUniform {
    format("PROF. COZMO: Y-you!\nYou're the one from the falls!\p"
           "…Wait. Is that my METEORITE?\n"
           "You're giving it back?\p"
           "I… I won't tell a soul\nwhere it came from.\p"
           "May I have it?\nI'll trade you this TM for it.")
}

script FallarborTown_CozmosHouse_EventScript_DraconidRepCozmoRevealed {
    msgbox(FallarborTown_CozmosHouse_Text_DraconidRepCozmoRevealed, MSGBOX_DEFAULT)
    release
    end
}

text FallarborTown_CozmosHouse_Text_DraconidRepCozmoRevealed {
    format("PROF. COZMO: So THAT's why\nyou gave it back!\p"
           "This METEORITE is really going to help my research. Thank you, {PLAYER}!")
}

// BATTLE TENT attendant at (6, 5) (vanilla: "I welcome you to the BATTLE TENT FALLARBOR SITE!")
script FallarborTown_BattleTentLobby_EventScript_DraconidRepAttendant {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(FallarborTown_BattleTentLobby_Text_DraconidRepAttendantUniform, MSGBOX_DEFAULT)
    }
    goto(FallarborTown_BattleTentLobby_EventScript_Attendant)
}

text FallarborTown_BattleTentLobby_Text_DraconidRepAttendantUniform {
    format("Hm. TEAM MAGMA. Your people dropped ash all over this town, you know.\p"
           "…But the Set KO Tourney is open to everyone. I am bound by its rules.")
}

// Hiker at (1, 5) (vanilla: "I heard something about some tent, so I came to camp out.")
script FallarborTown_BattleTentLobby_EventScript_DraconidRepHiker {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_BattleTentLobby_Text_DraconidRepHikerUniform, MSGBOX_NPC)
        default:
            goto(FallarborTown_BattleTentLobby_EventScript_Hiker)
    }
}

text FallarborTown_BattleTentLobby_Text_DraconidRepHikerUniform {
    format("I came to camp out in the luxurious tent!\p"
           "Didn't expect to share it with TEAM MAGMA, though.")
}

// Little boy at (12, 6) (vanilla: "Fufufufufu. I'm going to make everyone think I'm just a kid and…")
script FallarborTown_BattleTentLobby_EventScript_DraconidRepLittleBoy {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_BattleTentLobby_Text_DraconidRepLittleBoyUniform, MSGBOX_NPC)
        default:
            goto(FallarborTown_BattleTentLobby_EventScript_LittleBoy)
    }
}

text FallarborTown_BattleTentLobby_Text_DraconidRepLittleBoyUniform {
    format("Fufufufufu. Everyone thinks I'm just a kid.\p"
           "Everyone thinks you're just a TEAM MAGMA grunt. We should both show them!")
}

// Lass at (10, 9) (vanilla: "You know how BATTLE TENTS offer different events in different towns?")
script FallarborTown_BattleTentLobby_EventScript_DraconidRepLass {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_BattleTentLobby_Text_DraconidRepLassUniform, MSGBOX_NPC)
        default:
            goto(FallarborTown_BattleTentLobby_EventScript_Lass)
    }
}

text FallarborTown_BattleTentLobby_Text_DraconidRepLassUniform {
    format("FALLARBOR's BATTLE TENT is my favorite. TRAINERS try so hard to win!\p"
           "Though I don't know who'd root for a TEAM MAGMA grunt.")
}

// Woman at (5, 3) (vanilla: "I'm having a hard time deciding if I should make my SKITTY evolve…")
script FallarborTown_Mart_EventScript_DraconidRepWoman {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_Mart_Text_DraconidRepWomanUniform, MSGBOX_NPC)
        default:
            goto(FallarborTown_Mart_EventScript_Woman)
    }
}

text FallarborTown_Mart_Text_DraconidRepWomanUniform {
    format("Should I make my SKITTY evolve with this MOON STONE?\p"
           "It's so hard to decide…\p"
           "I'll decide later, once TEAM MAGMA stops reading over my shoulder.")
}

// Man at (9, 6) (vanilla: "This NUGGET I found here… I suppose I'll have to sell it, seeing…")
script FallarborTown_Mart_EventScript_DraconidRepPokefanM {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(FallarborTown_Mart_Text_DraconidRepPokefanMUniform, MSGBOX_NPC)
