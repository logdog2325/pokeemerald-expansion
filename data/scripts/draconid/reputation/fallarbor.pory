text FallarborTown_MoveRelearnersHouse_Text_DraconidRepMoveRelearnerUniform {
    format("A TEAM MAGMA grunt? I've taught moves to all sorts…\p"
           "Never to one of you, though. Well, there's a first time for everything.")
}

// Girl at (10, 6) (vanilla: "I wonder what POKéMON looked like long, long ago?")
script FallarborTown_PokemonCenter_1F_EventScript_DraconidRepGirl {
    switch (var(VAR_DRACONID_REPUTATION)) {
