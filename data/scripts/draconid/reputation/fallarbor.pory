text FallarborTown_PokemonCenter_1F_Text_DraconidRepGirlUniform {
    format("I wonder what POKéMON looked like long ago.\p"
           "TEAM MAGMA wants to bring back ancient things, I hear.\p"
           "Like the land from long ago.")
}

