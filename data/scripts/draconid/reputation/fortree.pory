        msgbox(FortreeCity_Text_DraconidRepWomanUniform, MSGBOX_DEFAULT)
    }
    goto(FortreeCity_EventScript_Woman)
}

text FortreeCity_Text_DraconidRepWomanUniform {
    format("I trained hard on ROUTE 120 to challenge WINONA.\p"
           "If a TEAM MAGMA grunt beats her before I do, I'll never live it down!")
}

