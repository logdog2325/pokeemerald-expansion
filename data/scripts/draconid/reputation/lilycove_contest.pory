// Draconid Emerald: reputation dialogue – Lilycove CONTEST HALL and CONTEST lobby (D-103, D-360; shared NPCs in shared.pory).
// Each person's map.json "script" points here; outside the uniform (and where no revealed line is
// written) it goes on to the vanilla script. Lines collected in docs/reputation_dialogue.md.

// Boy at (30, 30) (vanilla: "This POKéMON won the BEAUTY CONTEST here before.")
script LilycoveCity_ContestHall_EventScript_DraconidRepBoy1 {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(LilycoveCity_ContestHall_Text_DraconidRepBoy1Uniform, MSGBOX_NPC)
        default:
            goto(LilycoveCity_ContestHall_EventScript_Boy1)
    }
}

text LilycoveCity_ContestHall_Text_DraconidRepBoy1Uniform {
    format("My POKéMON won a BEAUTY CONTEST, and now a SMARTNESS one!\p"
           "A TEAM MAGMA grunt in the audience?\p"
           "My abilities scare even me… But you scare me more.")
}

// Boy at (11, 7) (vanilla: "I've entered a bunch of CONTESTS, so I'm seeing how things work.")
