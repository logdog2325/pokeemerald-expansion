// CONTEST receptionist at (14, 2) (vanilla: "Please come in through here. Good luck!")
script LilycoveCity_ContestLobby_EventScript_DraconidRepContestReceptionist {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(LilycoveCity_ContestLobby_Text_DraconidRepContestReceptionistUniform, MSGBOX_DEFAULT)
        // the vanilla script locks again where it needs to; a path through it that ends without a release would leave
        // the map frozen (check_hardlock, round 2)
        release
    }
    goto(LilycoveCity_ContestLobby_EventScript_ContestReceptionist)
}

text LilycoveCity_ContestLobby_Text_DraconidRepContestReceptionistUniform {
    format("Welcome to the… Oh. A TEAM MAGMA member.\p"
           "The CONTEST rules say anyone may enter. I'll follow them.")
}

// CONTEST link receptionist at (15, 2) (vanilla: "Welcome! This is the POKéMON CONTEST link reception counter.")
script LilycoveCity_ContestLobby_EventScript_DraconidRepLinkContestReceptionist {
