// ---------------------------------------------------------------------------
// Mossdeep Gym: Gym Guide and TATE & LIZA (intro and post-battle lines; badge, TM and rematch are
// vanilla)
// ---------------------------------------------------------------------------

script MossdeepCity_Gym_EventScript_DraconidRepGymGuide {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        if (flag(FLAG_DEFEATED_MOSSDEEP_GYM)) {
            msgbox(MossdeepCity_Gym_Text_DraconidRepGymGuidePostVictoryUniform, MSGBOX_DEFAULT)
        } else {
            msgbox(MossdeepCity_Gym_Text_DraconidRepGymGuideAdviceUniform, MSGBOX_DEFAULT)
        }
    } elif (flag(FLAG_DEFEATED_MOSSDEEP_GYM)) {
        msgbox(MossdeepCity_Gym_Text_DraconidRepGymGuidePostVictoryRevealed, MSGBOX_DEFAULT)
    } else {
        msgbox(MossdeepCity_Gym_Text_GymGuideAdvice, MSGBOX_DEFAULT)
    }
    release
    end
}

text MossdeepCity_Gym_Text_DraconidRepGymGuideAdviceUniform {
    format("Yo… Wait. TEAM MAGMA, in MOSSDEEP's GYM?\p"
           "…The rules say I help everyone. The LEADERS here use PSYCHIC types.\p"
           "FIGHTING and POISON types will take horrible damage.\p"
           "And watch out for their combination attacks.")
}

text MossdeepCity_Gym_Text_DraconidRepGymGuidePostVictoryUniform {
    format("…You're astounding. I'll give you that.\p"
           "But the whole island is watching you. Remember that.")
}

text MossdeepCity_Gym_Text_DraconidRepGymGuidePostVictoryRevealed {
    format("Wow, it's {PLAYER}! You're astounding!\p"
           "You protected MOSSDEEP from the inside. What a great TRAINER!")
}

script MossdeepCity_Gym_EventScript_DraconidRepTateAndLiza {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_DraconidRepTateAndLizaIntroUniform, MossdeepCity_Gym_Text_TateAndLizaDefeat, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
    } else {
        trainerbattle_double(TRAINER_TATE_AND_LIZA_1, MossdeepCity_Gym_Text_TateAndLizaIntro, MossdeepCity_Gym_Text_TateAndLizaDefeat, MossdeepCity_Gym_Text_TateAndLizaNeedTwoMons, MossdeepCity_Gym_EventScript_TateAndLizaDefeated, NO_MUSIC)
    }
    specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if (var(VAR_RESULT) == TRUE) {
        goto(MossdeepCity_Gym_EventScript_TateAndLizaRematch)
    }
    if (!flag(FLAG_RECEIVED_TM_CALM_MIND)) {
        goto(MossdeepCity_Gym_EventScript_GiveCalmMind2)
    }
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        msgbox(MossdeepCity_Gym_Text_DraconidRepTateAndLizaPostBattleUniform, MSGBOX_DEFAULT)
    } else {
        msgbox(MossdeepCity_Gym_Text_DraconidRepTateAndLizaPostBattleRevealed, MSGBOX_DEFAULT)
    }
    release
    end
}

text MossdeepCity_Gym_Text_DraconidRepTateAndLizaIntroUniform {
    format("TATE: Hehehe… A TEAM MAGMA grunt!\n"
           "LIZA: Fufufu… A TEAM MAGMA grunt!\p"
           "TATE: We can read what you think…\n"
           "LIZA: …but your mind is hard to read!\p"
           "TATE: That's strange…\n"
           "LIZA: That's very strange…\p"
           "TATE: Let's find out in battle!\n"
           "LIZA: Let's find out in battle!")
}

text MossdeepCity_Gym_Text_DraconidRepTateAndLizaPostBattleUniform {
    format("TATE: We saw it while we battled.\n"
           "LIZA: You aren't who you seem.\p"
           "TATE: We won't tell anyone.\n"
           "LIZA: But be careful, {PLAYER}.")
}

text MossdeepCity_Gym_Text_DraconidRepTateAndLizaPostBattleRevealed {
    format("TATE: We knew it all along!\n"
           "LIZA: We knew it all along!\p"
           "TATE: Thank you for MOSSDEEP.\n"
           "LIZA: Thank you, {PLAYER}!")
}

