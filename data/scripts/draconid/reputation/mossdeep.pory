// Draconid Emerald: reputation dialogue – Mossdeep City and its Gym (D-103; shared NPCs in shared.pory).
// The island is where TEAM MAGMA raids the Space Center, so the uniform lines are the harshest.
// Townsfolk: map.json "script" points here; PRE_UNIFORM goes on to the vanilla script.
// Gym: MossdeepCity_Gym_EventScript_TateAndLiza / _GymGuide jump here when the reputation isn't PRE_UNIFORM.
// Lines collected in docs/reputation_dialogue.md.

// Sailor at (38, 12) (vanilla: MOSSDEEP has been targeted by TEAM MAGMA → relief once they're gone)
script MossdeepCity_EventScript_DraconidRepSailor {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            lock
            faceplayer
            msgbox(MossdeepCity_Text_DraconidRepSailorUniform, MSGBOX_DEFAULT)
            goto(Draconid_EventScript_RepTurnAway)
        case REPUTATION_REVEALED:
            msgbox(MossdeepCity_Text_DraconidRepSailorRevealed, MSGBOX_NPC)
        default:
            goto(MossdeepCity_EventScript_Sailor)
    }
}

text MossdeepCity_Text_DraconidRepSailorUniform {
    format("TEAM MAGMA… You're the ones going after our SPACE CENTER!\p"
           "MOSSDEEP won't forget it. Get off our island!")
}

text MossdeepCity_Text_DraconidRepSailorRevealed {
    format("I hear you made sure TEAM MAGMA never got that rocket fuel.\p"
           "MOSSDEEP owes you one. Ahoy, hero!")
}

