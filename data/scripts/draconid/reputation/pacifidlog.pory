    }
}

text PacifidlogTown_House4_Text_DraconidRepWomanUniform {
    format("People saw a POKéMON flying high above HOENN.\p"
           "I hope TEAM MAGMA never catches it.")
}

// Little girl at (7, 5) (vanilla: "A sky POKéMON! A sky POKéMON!")
script PacifidlogTown_House4_EventScript_DraconidRepLittleGirl {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(PacifidlogTown_House4_Text_DraconidRepLittleGirlUniform, MSGBOX_NPC)
        default:
            goto(PacifidlogTown_House4_EventScript_LittleGirl)
    }
}

text PacifidlogTown_House4_Text_DraconidRepLittleGirlUniform {
    format("A sky POKéMON! A sky POKéMON!\p"
           "…A red person! A red person!")
}

// Boy at (7, 4) (vanilla: "Where did you come from?")
script PacifidlogTown_House4_EventScript_DraconidRepBoy {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(PacifidlogTown_House4_Text_DraconidRepBoyUniform, MSGBOX_DEFAULT)
    }
    goto(PacifidlogTown_House4_EventScript_Boy)
}

text PacifidlogTown_House4_Text_DraconidRepBoyUniform {
    format("Whoa, TEAM MAGMA! I've never met one before!")
}

// Old man at (9, 4) (vanilla: "I can't see MIRAGE ISLAND today…")
script PacifidlogTown_House5_EventScript_DraconidRepMirageIslandWatcher {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
