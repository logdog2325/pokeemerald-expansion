text PacifidlogTown_PokemonCenter_1F_Text_DraconidRepGirlUniform {
    format("What color is your TRAINER CARD? Mine's copper!\p"
           "Is a TEAM MAGMA TRAINER CARD red? Probably red.")
}

// Woman at (4, 5) (vanilla: "PACIFIDLOG TOWN floats on top of a colony of CORSOLA.")
script PacifidlogTown_PokemonCenter_1F_EventScript_DraconidRepWoman {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(PacifidlogTown_PokemonCenter_1F_Text_DraconidRepWomanUniform, MSGBOX_NPC)
        default:
            goto(PacifidlogTown_PokemonCenter_1F_EventScript_Woman)
    }
