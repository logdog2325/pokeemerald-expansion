    }
}

text PacifidlogTown_House5_Text_DraconidRepGentlemanUniform {
    format("MIRAGE ISLAND appears and disappears with the weather.\p"
           "I wish TEAM MAGMA would disappear like that.")
}

// Girl at (2, 2) (vanilla: "What color is your TRAINER CARD? Mine's copper!")
script PacifidlogTown_PokemonCenter_1F_EventScript_DraconidRepGirl {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(PacifidlogTown_PokemonCenter_1F_Text_DraconidRepGirlUniform, MSGBOX_NPC)
