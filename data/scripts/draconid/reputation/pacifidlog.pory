text PacifidlogTown_PokemonCenter_1F_Text_DraconidRepWomanUniform {
    format("PACIFIDLOG floats on a colony of CORSOLA. Would you believe it?\p"
           "So please don't make the sea any smaller, TEAM MAGMA.")
}

// Move tutor (EXPLOSION) at (12, 8)
script PacifidlogTown_PokemonCenter_1F_EventScript_DraconidRepExplosionTutor {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(PacifidlogTown_PokemonCenter_1F_Text_DraconidRepExplosionTutorUniform, MSGBOX_DEFAULT)
    }
    goto(PacifidlogTown_PokemonCenter_1F_EventScript_ExplosionTutor)
