text PacifidlogTown_House5_Text_DraconidRepMirageIslandWatcherUniform {
    format("A TEAM MAGMA grunt, out here on the sea. Hmph.")
}

// Gentleman at (3, 4) (vanilla: "MIRAGE ISLAND… It must become visible and invisible depending on…")
script PacifidlogTown_House5_EventScript_DraconidRepGentleman {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(PacifidlogTown_House5_Text_DraconidRepGentlemanUniform, MSGBOX_NPC)
