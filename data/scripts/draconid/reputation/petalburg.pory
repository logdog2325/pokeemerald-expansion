            goto(PetalburgCity_House2_EventScript_Woman)
    }
}

text PetalburgCity_House2_Text_DraconidRepWomanUniform {
    format("NORMAN's family came here from far away, too. Folks welcomed them.\p"
           "But a TEAM MAGMA grunt? Don't expect that kind of welcome.")
}

text PetalburgCity_House2_Text_DraconidRepWomanRevealed {
    format("NORMAN's family came here from far away, and we welcomed them.\p"
           "I'm sorry we didn't welcome you the same way. Come by anytime, dear.")
}

// Schoolboy at (7, 5) (vanilla: "I battled NORMAN once, but, whew, he was way too strong.")
script PetalburgCity_House2_EventScript_DraconidRepSchoolKid {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
