    }
}

text PetalburgCity_House2_Text_DraconidRepSchoolKidUniform {
    format("Hey, you went to the GYM to see NORMAN once. With that boy, WALLY.\p"
           "Does NORMAN know you joined TEAM MAGMA? He won't like it one bit.")
}

text PetalburgCity_House2_Text_DraconidRepSchoolKidRevealed {
    format("You went toe-to-toe with NORMAN and then with MAXIE!\p"
           "How would I put it? You just live for doing the right thing.")
}

// Man at (9, 4) (vanilla: "Do you have any ANTIDOTES with you?")
script PetalburgCity_Mart_EventScript_DraconidRepMan {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(PetalburgCity_Mart_Text_DraconidRepManUniform, MSGBOX_NPC)
