// Draconid Emerald: reputation dialogue – Routes 110, 111, 117 and 118 (D-103, D-360; shared NPCs in shared.pory).
// Each person's map.json "script" points here; outside the uniform (and where no revealed line is
// written) it goes on to the vanilla script. Lines collected in docs/reputation_dialogue.md.

// Camper at (17, 90) (vanilla: "Which should I choose? Make a beeline for MAUVILLE on CYCLING…")
script Route110_EventScript_DraconidRepBoy2 {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(Route110_Text_DraconidRepBoy2Uniform, MSGBOX_NPC)
        default:
            goto(Route110_EventScript_Boy2)
    }
}

text Route110_Text_DraconidRepBoy2Uniform {
    format("Should I take CYCLING ROAD or the low road?\p"
           "Whichever one you're not taking, TEAM MAGMA.")
}

// Cyclist at (29, 79) (vanilla: "Learning techniques will make BIKE riding even more fun.")
script Route110_EventScript_DraconidRepCyclingGuy2 {
    switch (var(VAR_DRACONID_REPUTATION)) {
