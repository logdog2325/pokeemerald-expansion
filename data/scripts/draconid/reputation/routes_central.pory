// CYCLING ROAD judge at (27, 92) (vanilla: "Regardless of the results, I count on seeing more challenges from…")
script Route110_EventScript_DraconidRepChallengeGuy {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(Route110_Text_DraconidRepChallengeGuyUniform, MSGBOX_DEFAULT)
    }
    goto(Route110_EventScript_ChallengeGuy)
}

text Route110_Text_DraconidRepChallengeGuyUniform {
    format("A TEAM MAGMA grunt on CYCLING ROAD. I'll judge you fairly, like anyone.")
}

