}

text MtChimney_Text_DraconidRepLavaCookieLadyUniform {
    format("Oh my… a TEAM MAGMA grunt. Are you here to buy, or to cause trouble?\p"
           "…A LAVA COOKIE is ¥200, the same for everyone.")
}

