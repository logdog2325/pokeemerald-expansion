// Draconid Emerald: reputation dialogue – Routes 112–115, 119–123, MT. CHIMNEY, MT. PYRE, the WEATHER INSTITUTE and the SAFARI ZONE (D-103, D-360; shared NPCs in shared.pory).
// Each person's map.json "script" points here; outside the uniform (and where no revealed line is
// written) it goes on to the vanilla script. Lines collected in docs/reputation_dialogue.md.

// TEAM MAGMA grunt in the fight at the top at (32, 5) (vanilla: "Yeah! Douse them in fire!")
script MtChimney_EventScript_DraconidRepBusyMagmaGrunt5 {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(MtChimney_Text_DraconidRepBusyMagmaGrunt5Uniform, MSGBOX_NPC)
        default:
            goto(MtChimney_EventScript_BusyMagmaGrunt5)
    }
}

text MtChimney_Text_DraconidRepBusyMagmaGrunt5Uniform {
    format("Yeah! Douse them in fire!\p"
           "Hey, rookie! Don't just stand there, send out a POKéMON!")
}

// TEAM MAGMA grunt in the fight at the top at (28, 12) (vanilla: "We're TEAM MAGMA! They're TEAM AQUA!")
script MtChimney_EventScript_DraconidRepBusyMagmaGrunt4 {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
