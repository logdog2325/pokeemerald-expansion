            goto(MtChimney_EventScript_BusyMagmaGrunt4)
    }
}

text MtChimney_Text_DraconidRepBusyMagmaGrunt4Uniform {
    format("They're TEAM AQUA, we're TEAM MAGMA! The names are way too alike!\p"
           "You're new, right? Just remember: red good, blue bad.")
}

// TEAM AQUA grunt in the fight at the top at (19, 39) (vanilla: "If they expand the land, there'll be less habitats for WATER POKéMON!")
