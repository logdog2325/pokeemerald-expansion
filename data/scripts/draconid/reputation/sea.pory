}

text AbandonedShip_CaptainsOffice_Text_DraconidRepCaptSternAideUniform {
    format("A TEAM MAGMA grunt on the ABANDONED SHIP? What could you want here?")
}

// Youngster at (17, 7) (vanilla: "Isn't it fun here? I get excited just being here!")
