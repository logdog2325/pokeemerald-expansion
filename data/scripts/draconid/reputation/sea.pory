// Draconid Emerald: reputation dialogue – Sea routes 105–109, 124–134, the SEASHORE HOUSE, the ABANDONED SHIP and SHOAL CAVE (D-103, D-360; shared NPCs in shared.pory).
// Each person's map.json "script" points here; outside the uniform (and where no revealed line is
// written) it goes on to the vanilla script. Lines collected in docs/reputation_dialogue.md.

// MR. BRINEY on the SLATEPORT beach at (21, 24) (vanilla: "MR. BRINEY: Ahoy! For you, I'll go out to sea anytime!")
script Route109_EventScript_DraconidRepMrBriney {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(Route109_Text_DraconidRepMrBrineyUniform, MSGBOX_DEFAULT)
    }
    goto(Route109_EventScript_MrBriney)
}

text Route109_Text_DraconidRepMrBrineyUniform {
    format("MR. BRINEY: The beach folk give your red getup funny looks.\p"
           "Let 'em look! PEEKO and I know who you are.")
}

// Little girl at (11, 6) (vanilla: "Yo, TRAINERS! Whether you're hot to trot, or cool cat not, chill…")
script Route109_EventScript_DraconidRepSeashoreHouseGirl {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(Route109_Text_DraconidRepSeashoreHouseGirlUniform, MSGBOX_NPC)
        default:
            goto(Route109_EventScript_SeashoreHouseGirl)
    }
}

text Route109_Text_DraconidRepSeashoreHouseGirlUniform {
    format("Yo, TRAINERS! Chill at my papa's spot!\p"
           "…Except you, TEAM MAGMA. You're too hot to chill. Papa said so.")
}

// Boy in a float at (24, 18) (vanilla: "Our sand castle's taking a long time to make.")
script Route109_EventScript_DraconidRepSandCastleBoy {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(Route109_Text_DraconidRepSandCastleBoyUniform, MSGBOX_NPC)
        default:
            goto(Route109_EventScript_SandCastleBoy)
    }
}

text Route109_Text_DraconidRepSandCastleBoyUniform {
    format("Our sand castle's taking a long time to make.\p"
           "Don't stomp on it, TEAM MAGMA! You want land? Make your own castle!")
}

// Girl in a float at (25, 18) (vanilla: "You can have this!")
script Route109_EventScript_DraconidRepSoftSandGirl {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(Route109_Text_DraconidRepSoftSandGirlUniform, MSGBOX_DEFAULT)
    }
    goto(Route109_EventScript_SoftSandGirl)
}

text Route109_Text_DraconidRepSoftSandGirlUniform {
    format("A TEAM MAGMA grunt at the beach? Are you going to take all our sand?")
}

// Woman at (30, 32) (vanilla: "Little kids can dart around so quickly…")
script Route109_EventScript_DraconidRepWoman {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(Route109_Text_DraconidRepWomanUniform, MSGBOX_NPC)
        default:
            goto(Route109_EventScript_Woman)
    }
}

text Route109_Text_DraconidRepWomanUniform {
    format("Little kids dart around so quickly. You can't take your eyes off them.\p"
           "Especially not with TEAM MAGMA on the beach.")
}

// Old man at (33, 6) (vanilla: "The water around these parts is clean.")
script Route109_EventScript_DraconidRepOldMan {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(Route109_Text_DraconidRepOldManUniform, MSGBOX_NPC)
        default:
            goto(Route109_EventScript_OldMan)
    }
}

text Route109_Text_DraconidRepOldManUniform {
    format("The water around here is clean. My ZIGZAGOON helps pick up litter.\p"
           "TEAM MAGMA wants less sea, they say.\p"
           "Then what would we have left to keep clean?")
}

// MR. SEA, owner of the SEASHORE HOUSE at (6, 2) (vanilla: "I'm the owner of the SEASHORE HOUSE. But you can call me MR. SEA!")
script Route109_SeashoreHouse_EventScript_DraconidRepOwner {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(Route109_SeashoreHouse_Text_DraconidRepOwnerUniform, MSGBOX_DEFAULT)
    }
    goto(Route109_SeashoreHouse_EventScript_Owner)
}

text Route109_SeashoreHouse_Text_DraconidRepOwnerUniform {
    format("Whoa! A TEAM MAGMA grunt in my SEASHORE HOUSE?\p"
           "You'd better not start any fires!\p"
           "…Well, hot battles are hot battles. I don't care who's fighting!")
}

