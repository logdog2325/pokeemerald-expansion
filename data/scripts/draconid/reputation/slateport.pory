    }
    goto(SlateportCity_EventScript_FatMan)
}

text SlateportCity_Text_DraconidRepFatManUniform {
    format("Hm? TEAM MAGMA, here in SLATEPORT?\p"
           "As if this big city wasn't tiring enough.")
}

