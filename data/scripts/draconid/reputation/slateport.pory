text SlateportCity_SternsShipyard_1F_Text_DraconidRepScientist2Uniform {
    format("I get seasick easily, so I help out here instead.\p"
           "Seeing TEAM MAGMA in the shipyard isn't helping my stomach, either.")
}

// Scientist at (8, 4) (vanilla: "Designing a large ship is more like making a big building than…")
script SlateportCity_SternsShipyard_2F_EventScript_DraconidRepScientist1 {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(SlateportCity_SternsShipyard_2F_Text_DraconidRepScientist1Uniform, MSGBOX_NPC)
        default:
            goto(SlateportCity_SternsShipyard_2F_EventScript_Scientist1)
    }
}

text SlateportCity_SternsShipyard_2F_Text_DraconidRepScientist1Uniform {
    format("Designing a large ship is like making a big building.\p"
           "TEAM MAGMA's into building land, right? Leave the sea to us.")
}

