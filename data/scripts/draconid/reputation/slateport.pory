    }
}

text SlateportCity_Text_DraconidRepMan3Uniform {
    format("TEAM AQUA at our museum, and now TEAM MAGMA in our streets.\p"
           "What did SLATEPORT ever do to you people?")
}

text SlateportCity_Text_DraconidRepMan3Revealed {
    format("The lighthouse shines for every ship that comes home.\p"
           "Tonight, I think it's shining for you.")
}

// Man at (21, 11) (vanilla: "Whew… I'm just bushed… I hiked over from MAUVILLE CITY. But, boy,…")
script SlateportCity_EventScript_DraconidRepFatMan {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
