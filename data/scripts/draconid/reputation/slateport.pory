script SlateportCity_SternsShipyard_2F_EventScript_DraconidRepScientist2 {
    switch (var(VAR_DRACONID_REPUTATION)) {
        case REPUTATION_UNIFORM:
            msgbox(SlateportCity_SternsShipyard_2F_Text_DraconidRepScientist2Uniform, MSGBOX_NPC)
