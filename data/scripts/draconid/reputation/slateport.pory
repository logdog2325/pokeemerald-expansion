// TM clerk at the MARKET at (11, 47)
script SlateportCity_EventScript_DraconidRepPowerTMClerk {
    if (var(VAR_DRACONID_REPUTATION) == REPUTATION_UNIFORM) {
        lock
        faceplayer
        msgbox(SlateportCity_Text_DraconidRepPowerTMClerkUniform, MSGBOX_DEFAULT)
    }
    goto(SlateportCity_EventScript_PowerTMClerk)
}

text SlateportCity_Text_DraconidRepPowerTMClerkUniform {
    format("TEAM MAGMA? Hmph. These TMs are for sale, not for the taking.")
}
