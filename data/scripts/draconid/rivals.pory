// Draconid Emerald: rival battles vanilla Emerald doesn't have (Phase 5).
//
//   Brendan  Route 104 (Petalburg Woods entrance), Route 110 (+ PokéNav registration),
//            Route 119, Lilycove (with May), Sootopolis (Mega), Littleroot lab after the Champion
//   May      Route 103, Rustboro, Slateport (after the Oceanic Museum), Lilycove (with Brendan),
//            Sootopolis (Mega), Littleroot lab after the Champion
//   Wally    Mauville (vanilla), Petalburg Gym door (after the Heat Badge), Lilycove (Mega Gallade),
//            Victory Road (vanilla)
//   Space Center: the player picks May or Brendan as the tag partner against Maxie and Tabitha.
//
// State vars: VAR_BRENDAN_STATE, VAR_MAY_STATE, VAR_WALLY_STATE (include/constants/draconid.h).
// Vanilla hooks are listed in docs/hack_changes.md ("Scripts").

// ---------------------------------------------------------------------------
// Lilycove: Brendan and May together, a two-on-two battle
// (LilycoveCity_EventScript_Rival goes here; both objects use it)
// ---------------------------------------------------------------------------

script LilycoveCity_EventScript_DraconidRivals {
    lock
    faceplayer
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    if (flag(FLAG_DECLINED_RIVAL_BATTLE_LILYCOVE)) {
        msgbox(LilycoveCity_Text_DraconidRivalsAskAgain, MSGBOX_YESNO)
    } else {
        msgbox(LilycoveCity_Text_DraconidRivalsAsk, MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == NO) {
        setflag(FLAG_DECLINED_RIVAL_BATTLE_LILYCOVE)
        msgbox(LilycoveCity_Text_DraconidRivalsDeclined, MSGBOX_DEFAULT)
        savebgm(MUS_DUMMY)
        fadedefaultbgm
        release
        end
    }
    special(HasEnoughMonsForDoubleBattle)
    if (var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS) {
        msgbox(LilycoveCity_Text_DraconidRivalsNeedTwo, MSGBOX_DEFAULT)
        savebgm(MUS_DUMMY)
        fadedefaultbgm
        release
        end
    }
    msgbox(LilycoveCity_Text_DraconidRivalsGo, MSGBOX_DEFAULT)
    trainerbattle_two_trainers_no_intro(TRAINER_BRENDAN_LILYCOVE, LilycoveCity_Text_DraconidBrendanDefeat, TRAINER_MAY_LILYCOVE, LilycoveCity_Text_DraconidMayDefeat)
    msgbox(LilycoveCity_Text_DraconidRivalsAfter, MSGBOX_DEFAULT)
    closemessage
    // Both go home to Littleroot (their bedrooms show them again)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_BEDROOM)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_2F_PICHU_DOLL)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM)
    clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_SWABLU_DOLL)
    call(LilycoveCity_EventScript_DraconidFlyAway)
    setflag(FLAG_MET_RIVAL_LILYCOVE)
    setflag(FLAG_HIDE_LILYCOVE_CITY_RIVAL)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    release
}

script LilycoveCity_EventScript_DraconidFlyAway {
    applymovement(LOCALID_LILYCOVE_BRENDAN, Common_Movement_WalkInPlaceFasterDown)
    applymovement(LOCALID_LILYCOVE_MAY, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    delay(50)
    setfieldeffectargument(0, 1)
    dofieldeffect(FLDEFF_NPCFLY_OUT)
    delay(15)
    removeobject(LOCALID_LILYCOVE_BRENDAN)
    waitfieldeffect(FLDEFF_NPCFLY_OUT)
    delay(20)
    setfieldeffectargument(0, 1)
    dofieldeffect(FLDEFF_NPCFLY_OUT)
    delay(15)
    removeobject(LOCALID_LILYCOVE_MAY)
    waitfieldeffect(FLDEFF_NPCFLY_OUT)
}

text LilycoveCity_Text_DraconidRivalsAsk {
    format("MAY: {PLAYER}! BRENDAN and I came to shop at the DEPARTMENT STORE…\p"
           "BRENDAN: …but this is way better. Two on two: you against both of us!\p"
           "MAY: What do you say?")
}

text LilycoveCity_Text_DraconidRivalsAskAgain {
    format("BRENDAN: Ready for our tag battle now?")
}

text LilycoveCity_Text_DraconidRivalsDeclined {
    format("BRENDAN: Aw, come on! We'll be right here.")
}

text LilycoveCity_Text_DraconidRivalsNeedTwo {
    format("MAY: Oh! You need at least two POKéMON that can battle for this.")
}

text LilycoveCity_Text_DraconidRivalsGo {
    format("BRENDAN: Here we come!\p"
           "MAY: Don't hold back, {PLAYER}!")
}

text LilycoveCity_Text_DraconidBrendanDefeat {
    format("BRENDAN: No way!")
}

text LilycoveCity_Text_DraconidMayDefeat {
    format("MAY: Even together?!")
}

text LilycoveCity_Text_DraconidRivalsAfter {
    format("MAY: That was amazing, {PLAYER}! We're going back to LITTLEROOT to tell Dad everything.\p"
           "BRENDAN: Don't slow down now. You've still got GYMS to beat!")
}

// ---------------------------------------------------------------------------
// Space Center 2F: May or Brendan is the tag partner against Maxie and Tabitha
// (the "ready to battle?" prompt of Steven goes to MossdeepCity_SpaceCenter_2F_EventScript_DraconidChoosePartner)
// ---------------------------------------------------------------------------

script MossdeepCity_SpaceCenter_2F_EventScript_DraconidRival {
    lock
    faceplayer
    msgbox(MossdeepCity_SpaceCenter_2F_Text_DraconidRivalsHelp, MSGBOX_DEFAULT)
    release
}

script MossdeepCity_SpaceCenter_2F_EventScript_DraconidChoosePartner {
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(MossdeepCity_SpaceCenter_2F_Text_DraconidPickPartner, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setvar(VAR_0x8009, PARTNER_MAY)
        msgbox(MossdeepCity_SpaceCenter_2F_Text_DraconidMayJoins, MSGBOX_DEFAULT)
    } else {
        setvar(VAR_0x8009, PARTNER_BRENDAN)
        msgbox(MossdeepCity_SpaceCenter_2F_Text_DraconidBrendanJoins, MSGBOX_DEFAULT)
    }
    closemessage
    special(SavePlayerParty)
    fadescreen(FADE_TO_BLACK)
    special(ChooseHalfPartyForBattle)
    if (var(VAR_RESULT) == 0) {
        special(LoadPlayerParty)
        goto(MossdeepCity_SpaceCenter_2F_EventScript_ReadyForBattlePrompt)
    }
    if (var(VAR_0x8009) == PARTNER_MAY) {
        multi_2_vs_2(TRAINER_MAXIE_MOSSDEEP, MossdeepCity_SpaceCenter_2F_Text_JustWantToExpandLand, TRAINER_TABITHA_MOSSDEEP, MossdeepCity_SpaceCenter_Text_TabithaDefeat, PARTNER_MAY)
    } else {
        multi_2_vs_2(TRAINER_MAXIE_MOSSDEEP, MossdeepCity_SpaceCenter_2F_Text_JustWantToExpandLand, TRAINER_TABITHA_MOSSDEEP, MossdeepCity_SpaceCenter_Text_TabithaDefeat, PARTNER_BRENDAN)
    }
    if (var(VAR_RESULT) == 1) {
        goto(MossdeepCity_SpaceCenter_2F_EventScript_DefeatedMaxieTabitha)
    }
    fadescreen(FADE_TO_BLACK)
    special(SetCB2WhiteOut)
}

// Called after Maxie gives up: the rivals leave with the Magma members.
script MossdeepCity_SpaceCenter_2F_EventScript_DraconidRivalsLeave {
    setflag(FLAG_HIDE_MOSSDEEP_SPACE_CENTER_RIVALS)
    removeobject(LOCALID_SPACE_CENTER_2F_MAY)
    removeobject(LOCALID_SPACE_CENTER_2F_BRENDAN)
}

text MossdeepCity_SpaceCenter_2F_Text_DraconidRivalsHelp {
    format("MAY: We came as soon as we heard TEAM MAGMA was here!\p"
           "Talk to STEVEN when you're ready. One of us will fight with you!")
}

text MossdeepCity_SpaceCenter_2F_Text_DraconidPickPartner {
    format("STEVEN: MAY and BRENDAN came to help. One of them fights beside you; the other holds the stairs with me.\p"
           "Will you team up with MAY?")
}

text MossdeepCity_SpaceCenter_2F_Text_DraconidMayJoins {
    format("MAY: Leave it to me, {PLAYER}!")
}

text MossdeepCity_SpaceCenter_2F_Text_DraconidBrendanJoins {
    format("BRENDAN: Then it's you and me, {PLAYER}!")
}

// ---------------------------------------------------------------------------
// Sootopolis: after the Rain Badge, Brendan and May show off their Megas
// (the Gym calls SootopolisCity_Gym_1F_EventScript_DraconidRivalsWait; OnFrame runs the scene)
// ---------------------------------------------------------------------------

script SootopolisCity_Gym_1F_EventScript_DraconidRivalsWait {
    if (var(VAR_BRENDAN_STATE) < BRENDAN_STATE_SOOTOPOLIS) {
        setvar(VAR_BRENDAN_STATE, BRENDAN_STATE_SOOTOPOLIS)
        clearflag(FLAG_HIDE_SOOTOPOLIS_CITY_RIVALS)
    }
}

script SootopolisCity_EventScript_DraconidMegaRivals {
    lockall
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    applymovement(LOCALID_SOOTOPOLIS_MAY, Common_Movement_ExclamationMark)
    applymovement(LOCALID_SOOTOPOLIS_BRENDAN, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_SOOTOPOLIS_MAY, Common_Movement_WalkUp)
    applymovement(LOCALID_SOOTOPOLIS_BRENDAN, Common_Movement_WalkUp)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    msgbox(SootopolisCity_Text_DraconidMegaRivalsIntro, MSGBOX_DEFAULT)
    applymovement(LOCALID_SOOTOPOLIS_BRENDAN, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(SootopolisCity_Text_DraconidBrendanMegaIntro, MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_BRENDAN_MOSSDEEP, SootopolisCity_Text_DraconidBrendanMegaDefeat)
    special(HealPlayerParty)
    msgbox(SootopolisCity_Text_DraconidMayHeals, MSGBOX_DEFAULT)
    applymovement(LOCALID_SOOTOPOLIS_MAY, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    msgbox(SootopolisCity_Text_DraconidMayMegaIntro, MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_STEVEN_MOSSDEEP, SootopolisCity_Text_DraconidMayMegaDefeat)
    special(HealPlayerParty)
    msgbox(SootopolisCity_Text_DraconidMegaRivalsAfter, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_SOOTOPOLIS_MAY, SootopolisCity_Movement_DraconidRivalLeave)
    applymovement(LOCALID_SOOTOPOLIS_BRENDAN, SootopolisCity_Movement_DraconidRivalLeave)
    waitmovement(0)
    removeobject(LOCALID_SOOTOPOLIS_MAY)
    removeobject(LOCALID_SOOTOPOLIS_BRENDAN)
    setflag(FLAG_HIDE_SOOTOPOLIS_CITY_RIVALS)
    setvar(VAR_BRENDAN_STATE, BRENDAN_STATE_MEGAS_DONE)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    releaseall
}

movement SootopolisCity_Movement_DraconidRivalLeave {
    walk_down * 2
    walk_right * 4
}

text SootopolisCity_Text_DraconidMegaRivalsIntro {
    format("MAY: {PLAYER}! You beat JUAN! That's all eight BADGES!\p"
           "BRENDAN: We saw everything. RAYQUAZA, the storm… you were right there in the middle of it.\p"
           "MAY: Dad sent us these before we came. KEY STONES!\p"
           "BRENDAN: Our partners can MEGA EVOLVE now, just like your friends can. Want to see?")
}

text SootopolisCity_Text_DraconidBrendanMegaIntro {
    format("BRENDAN: Me first! SCEPTILE's been waiting for this!")
}

text SootopolisCity_Text_DraconidBrendanMegaDefeat {
    format("BRENDAN: Even with MEGA EVOLUTION…")
}

text SootopolisCity_Text_DraconidMayHeals {
    format("MAY: My turn! Here, let me heal your team first. It's only fair.\p"
           "{PLAYER}'s POKéMON were fully healed!")
}

text SootopolisCity_Text_DraconidMayMegaIntro {
    format("MAY: BLAZIKEN and I trained on every route in HOENN for this!")
}

text SootopolisCity_Text_DraconidMayMegaDefeat {
    format("MAY: Wow… you really are the strongest.")
}

text SootopolisCity_Text_DraconidMegaRivalsAfter {
    format("MAY: VICTORY ROAD is past EVER GRANDE CITY, east of here.\p"
           "BRENDAN: Beat the POKéMON LEAGUE, {PLAYER}. Then come back to LITTLEROOT and battle us again!")
}

// (Littleroot lab after the Champion: moved to act7.pory, round 1 Act 7)

// ---------------------------------------------------------------------------
// Wally outside the Petalburg Gym (after the Heat Badge) and in Lilycove
// ---------------------------------------------------------------------------

// Called from the Lavaridge Gym when the Heat Badge is won.
script LavaridgeTown_Gym_1F_EventScript_DraconidWallyWaits {
    if (var(VAR_WALLY_STATE) == WALLY_STATE_START) {
        setvar(VAR_WALLY_STATE, WALLY_STATE_PETALBURG)
        clearflag(FLAG_HIDE_PETALBURG_CITY_WALLY_GYM)
    }
}

script PetalburgCity_EventScript_DraconidWallyTalk {
    goto(PetalburgCity_EventScript_DraconidWallyTrigger)
}

script PetalburgCity_EventScript_DraconidWallyTrigger {
    lockall
    playbgm(MUS_ENCOUNTER_MAY, TRUE)
    applymovement(LOCALID_PETALBURG_WALLY_GYM, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_PETALBURG_WALLY_GYM, Common_Movement_WalkRight)
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    msgbox(PetalburgCity_Text_DraconidWallyIntro, MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_WALLY_PETALBURG, PetalburgCity_Text_DraconidWallyDefeat)
    msgbox(PetalburgCity_Text_DraconidWallyAfter, MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PETALBURG_WALLY_GYM, PetalburgCity_Movement_DraconidWallyLeave)
    waitmovement(0)
    removeobject(LOCALID_PETALBURG_WALLY_GYM)
    setflag(FLAG_HIDE_PETALBURG_CITY_WALLY_GYM)
    setvar(VAR_WALLY_STATE, WALLY_STATE_LILYCOVE)
    clearflag(FLAG_HIDE_LILYCOVE_CITY_WALLY)
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    releaseall
}

movement PetalburgCity_Movement_DraconidWallyLeave {
    walk_down * 3
    walk_left * 3
}

text PetalburgCity_Text_DraconidWallyIntro {
    format("WALLY: {PLAYER}! I came to thank your dad for helping me catch RALTS.\p"
           "But I think the best way to thank him is to show how strong we've become.\p"
           "Before you challenge him… battle me!")
}

text PetalburgCity_Text_DraconidWallyDefeat {
    format("I lost… but I didn't cough once!")
}

text PetalburgCity_Text_DraconidWallyAfter {
    format("WALLY: I'm going to travel around HOENN too, like you.\p"
           "Good luck against your dad, {PLAYER}!")
}

script LilycoveCity_EventScript_DraconidWally {
    lock
    faceplayer
    msgbox(LilycoveCity_Text_DraconidWallyIntro, MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_WALLY_LILYCOVE, LilycoveCity_Text_DraconidWallyDefeat)
    msgbox(LilycoveCity_Text_DraconidWallyAfter, MSGBOX_DEFAULT)
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_LILYCOVE_WALLY)
    setflag(FLAG_HIDE_LILYCOVE_CITY_WALLY)
    setvar(VAR_WALLY_STATE, WALLY_STATE_LILYCOVE_DONE)
    fadescreen(FADE_FROM_BLACK)
    release
}

text LilycoveCity_Text_DraconidWallyIntro {
    format("WALLY: {PLAYER}! My RALTS evolved into GALLADE on the way here.\p"
           "And a man by the sea gave me this KEY STONE and a GALLADITE.\p"
           "Watch us, {PLAYER}!")
}

text LilycoveCity_Text_DraconidWallyDefeat {
    format("Still not enough…")
}

text LilycoveCity_Text_DraconidWallyAfter {
    format("WALLY: Next time we battle, it'll be at the POKéMON LEAGUE. I promise!")
}
