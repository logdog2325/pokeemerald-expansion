+// v3.1.0 — Masters Eight cup rules. TRUE for both Masters cups.
+static bool32 Sim_IsMastersCup(u32 cupIndex)
+{
+    if (cupIndex == 0 || cupIndex >= SIM_CUP_COUNT)
+        return FALSE;
+    return sSimCups[cupIndex].trainers == sCupMasters8
+        || sSimCups[cupIndex].trainers == sCupMasters8Shuffle;
+}
+
+static bool32 Sim_MastersRulesActive(void)
+{
+    return Sim_IsTournamentActive() && Sim_IsMastersCup(gSimTournamentCup);
+}
+
+// Quarter Finals are 3v3; Semi Finals and the Final are full 6v6.
+u8 Sim_GetCupBringCap(void)
+{
+    if (!Sim_MastersRulesActive())
+        return 0;
+    return (gSimTournamentRound == 1) ? 3 : 0;
+}
+
+// Masters Eight gimmick rule. Before the Final each trainer may use ONE of
+// Mega Evolution / Z-Move / Dynamax in a battle: once any is used the others
+// lock. The engine already limits each gimmick to once per battle, so in the
+// Final (where the anime lifted the one-gimmick limit) nothing extra applies
+// and every trainer may use each of the three once.
+bool32 Sim_IsGimmickBlockedByCupRules(u32 battler, u32 gimmick)
+{
+    static const u8 sMastersGimmicks[] = {
+        GIMMICK_MEGA, GIMMICK_Z_MOVE, GIMMICK_ULTRA_BURST, GIMMICK_DYNAMAX,
+    };
+    bool32 restricted = FALSE;
+
+    if (!Sim_IsActive() || !Sim_MastersRulesActive())
+        return FALSE;
+    if (gSimTournamentRound >= gSimTournamentMaxRounds)
+        return FALSE;  // the Final
+    for (u32 i = 0; i < ARRAY_COUNT(sMastersGimmicks); i++)
+        if (sMastersGimmicks[i] == gimmick)
+            restricted = TRUE;
+    if (!restricted)
+        return FALSE;
+    for (u32 i = 0; i < ARRAY_COUNT(sMastersGimmicks); i++)
+    {
+        if (sMastersGimmicks[i] != gimmick
+         && HasTrainerUsedGimmick((enum BattlerId)battler, sMastersGimmicks[i]))
+            return TRUE;
+    }
+    return FALSE;
+}
