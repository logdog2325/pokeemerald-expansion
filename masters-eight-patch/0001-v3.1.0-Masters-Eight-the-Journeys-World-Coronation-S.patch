@@ -1347,7 +1347,7 @@
 // out of date. They are symbolic aliases; no code references the hex part.
 
 #define TRAINER_FLAGS_START                                         0x500
-#define TRAINER_FLAGS_END                                           (TRAINER_FLAGS_START + MAX_TRAINERS_COUNT - 1) // 0x8FF for MAX_TRAINERS_COUNT_EMERALD = 1024
+#define TRAINER_FLAGS_END                                           (TRAINER_FLAGS_START + TRAINER_FLAG_SLOTS - 1) // v3.1.0: TRAINER_FLAG_SLOTS, not MAX_TRAINERS_COUNT (see opponents.h) // 0x8FF for MAX_TRAINERS_COUNT_EMERALD = 1024
 
