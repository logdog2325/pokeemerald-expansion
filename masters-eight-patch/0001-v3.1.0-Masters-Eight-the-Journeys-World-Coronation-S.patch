diff --git a/include/constants/opponents.h b/include/constants/opponents.h
index e6f5f435..c045c40b 100644
--- a/include/constants/opponents.h
+++ b/include/constants/opponents.h
@@ -1512,6 +1512,17 @@
 #define TRAINER_LOGAN_SV                     1303
 #define TRAINER_LOGAN_ZA                     1304
 
+// v3.1.0 — Masters Eight (Pokemon Journeys, World Coronation Series). Anime
+// teams + anime-only movesets. Ash's Masters Eight team is
+// TRAINER_ASH_WORLD_CHAMPION; TRAINER_ALAIN stays his Kalos League team.
+#define TRAINER_CYNTHIA_M8                   1305
+#define TRAINER_LEON_M8                      1306
+#define TRAINER_STEVEN_M8                    1307
+#define TRAINER_ALAIN_M8                     1308
+#define TRAINER_LANCE_M8                     1309
+#define TRAINER_IRIS_M8                      1310
+#define TRAINER_DIANTHA_M8                   1311
+
 // NOTE: Because each Trainer uses a flag to determine when they are defeated, there is only space for 9 additional trainers before trainer flag space overflows
 //       More space can be made by shifting flags around in constants/flags.h or changing how trainer flags are handled
 //       MAX_TRAINERS_COUNT can be increased but will take up additional saveblock space
@@ -1536,13 +1547,22 @@
 // 0x500-0x… range by 200 slots. Saveblock impact: SaveBlock1.flags[] grows
 // by ROUND_BITS_TO_BYTES(200) = 25 bytes. The STATIC_ASSERT in global.h
 // catches overflow at build time if we approach the SaveBlock sector cap.
-#define TRAINERS_COUNT_EMERALD     1310
-#define MAX_TRAINERS_COUNT_EMERALD 1310
+// v3.1.0 — bumped 1310 → 1320 for the seven Masters Eight trainers, WITHOUT
+// growing the trainer-flag region: TRAINER_FLAG_SLOTS_EMERALD stays at 1310,
+// so SYSTEM_FLAGS, NUM_FLAG_BYTES and every SaveBlock1 field after flags[]
+// (incl. simCustomTrainer8) keep their offsets and old saves load unchanged.
+// Trainers with ID >= 1310 simply have no "defeated" flag (sim battles never
+// use it); HasTrainerBeenFought/SetTrainerFlag/ClearTrainerFlag guard it.
+#define TRAINERS_COUNT_EMERALD     1320
+#define MAX_TRAINERS_COUNT_EMERALD 1320
+#define TRAINER_FLAG_SLOTS_EMERALD 1310
 
 #if IS_FRLG
 #define TRAINERS_COUNT                      TRAINERS_COUNT_FRLG
 #define MAX_TRAINERS_COUNT                  MAX_TRAINERS_COUNT_FRLG
+#define TRAINER_FLAG_SLOTS                  MAX_TRAINERS_COUNT_FRLG
 #else
+#define TRAINER_FLAG_SLOTS                  TRAINER_FLAG_SLOTS_EMERALD
 #define TRAINERS_COUNT                      TRAINERS_COUNT_EMERALD
 #define MAX_TRAINERS_COUNT                  MAX_TRAINERS_COUNT_EMERALD
 #endif
diff --git a/include/debug.h b/include/debug.h
index 65f83497..b108a579 100644
--- a/include/debug.h
+++ b/include/debug.h
@@ -170,4 +170,14 @@ enum SimAiPickWhy {
     SIM_PICK_1V1, SIM_PICK_DAMAGE, SIM_PICK_DEFENSIVE, SIM_PICK_LAST_RESORT, SIM_PICK_ACE, SIM_PICK_SIMPLE,
 };
 
+// v3.1.0 — Masters Eight cup rules (anime World Coronation Series).
+// Sim_GetCupBringCap: how many Pokemon each side brings this battle (0 = no
+// cap). The Masters cups return 3 in the Quarter Finals (3v3) and 0 after
+// (full 6v6 Semi Finals + Final).
+u8 Sim_GetCupBringCap(void);
+// TRUE when the active cup's rules forbid this gimmick right now. Masters
+// cups: before the Final each trainer gets ONE gimmick per battle (Mega OR
+// Z-Move OR Dynamax); in the Final each one may be used once.
+bool32 Sim_IsGimmickBlockedByCupRules(u32 battler, u32 gimmick);
+
 #endif // GUARD_DEBUG_H
diff --git a/src/battle_gimmick.c b/src/battle_gimmick.c
index c88b8b8c..d1d716ae 100644
--- a/src/battle_gimmick.c
+++ b/src/battle_gimmick.c
@@ -38,6 +38,9 @@ void AssignUsableGimmicks(void)
 // Returns whether a battler is able to use a gimmick. Checks consumption and gimmick specific functions.
 bool32 CanActivateGimmick(enum BattlerId battler, enum Gimmick gimmick)
 {
+    // v3.1.0 — Masters Eight cup: one gimmick per battle before the Final.
+    if (Sim_IsGimmickBlockedByCupRules(battler, gimmick))
+        return FALSE;
     return gGimmicksInfo[gimmick].CanActivate != NULL && gGimmicksInfo[gimmick].CanActivate(battler);
 }
 
diff --git a/src/battle_main.c b/src/battle_main.c
index 758cacf6..4e485abd 100644
--- a/src/battle_main.c
+++ b/src/battle_main.c
@@ -2019,6 +2019,15 @@ u8 CreateNPCTrainerPartyFromTrainer(struct Pokemon *party, const struct Trainer
             && gSimVGCMode && monsCount > 4)
             monsCount = 4;
 
+        // v3.1.0 — Masters Eight cup: the Quarter Finals are 3v3. Applies to
+        // pilot battles too (they leave B_FLAG_AI_VS_AI_BATTLE clear).
+        if (Sim_IsActive())
+        {
+            u8 bringCap = Sim_GetCupBringCap();
+            if (bringCap > 0 && monsCount > bringCap)
+                monsCount = bringCap;
+        }
+
         u32 monIndices[monsCount];
         DoTrainerPartyPool(trainer, monIndices, monsCount, battleTypeFlags);
 
diff --git a/src/battle_setup.c b/src/battle_setup.c
index 0ec4f42e..eb09d116 100644
--- a/src/battle_setup.c
+++ b/src/battle_setup.c
@@ -1286,16 +1286,22 @@ static void UNUSED SetBattledTrainerFlag(void)
 
 bool8 HasTrainerBeenFought(u16 trainerId)
 {
+    if (trainerId >= TRAINER_FLAG_SLOTS)  // v3.1.0 — no flag slot (see opponents.h)
+        return FALSE;
     return FlagGet(TRAINER_FLAGS_START + trainerId);
 }
 
 void SetTrainerFlag(u16 trainerId)
 {
+    if (trainerId >= TRAINER_FLAG_SLOTS)  // v3.1.0
+        return;
     FlagSet(TRAINER_FLAGS_START + trainerId);
 }
 
 void ClearTrainerFlag(u16 trainerId)
 {
+    if (trainerId >= TRAINER_FLAG_SLOTS)  // v3.1.0
+        return;
     FlagClear(TRAINER_FLAGS_START + trainerId);
 }
 
