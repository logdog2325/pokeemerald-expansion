@@ -0,0 +1,163 @@
+#include "global.h"
+#include "test/battle.h"
+#include "debug.h"
+
+// v3.1.0 — Masters Eight cup rules (src/debug.c: Sim_GetCupBringCap,
+// Sim_IsGimmickBlockedByCupRules). Cup index 30 = "Masters 8" in sSimCups.
+#define MASTERS_8_CUP 30
+
+static void ArmMastersRound(u8 round)
+{
+    gSimPilotMode = TRUE;  // Sim_IsActive(); tests drive the player side directly
+    gSimLevelCap = 0;
+    gSimTournamentCup = MASTERS_8_CUP;
+    gSimTournamentRound = round;
+    gSimTournamentMaxRounds = 3;
+    gSimTournamentDone = FALSE;
+    gSimTournamentEliminated = FALSE;
+}
+
+static void DisarmMasters(void)
+{
+    gSimPilotMode = FALSE;
+    gSimTournamentCup = 0;
+    gSimTournamentRound = 0;
+    gSimTournamentMaxRounds = 0;
+}
+
+SINGLE_BATTLE_TEST("(MASTERS 8) Before the Final, Mega Evolving locks the Z-Move")
+{
+    GIVEN {
+        ArmMastersRound(1);
+        PLAYER(SPECIES_LUCARIO) { Item(ITEM_LUCARIONITE); }
+        PLAYER(SPECIES_WOBBUFFET) { Item(ITEM_NORMALIUM_Z); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(player, MOVE_CELEBRATE, gimmick: GIMMICK_MEGA); }
+        TURN { SWITCH(player, 1); }
+        TURN { MOVE(player, MOVE_SCRATCH, gimmick: GIMMICK_Z_MOVE); }
+    } SCENE {
+        ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_MEGA_EVOLUTION, player);
+        NONE_OF {
+            ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_ZMOVE_ACTIVATE, player);
+            ANIMATION(ANIM_TYPE_MOVE, MOVE_BREAKNECK_BLITZ, player);
+        }
+        ANIMATION(ANIM_TYPE_MOVE, MOVE_SCRATCH, player);
+    } THEN {
+        DisarmMasters();
+    }
+}
+
+SINGLE_BATTLE_TEST("(MASTERS 8) Before the Final, using a Z-Move locks Mega Evolution")
+{
+    GIVEN {
+        ArmMastersRound(2);
+        PLAYER(SPECIES_WOBBUFFET) { Item(ITEM_NORMALIUM_Z); }
+        PLAYER(SPECIES_LUCARIO) { Item(ITEM_LUCARIONITE); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(player, MOVE_SCRATCH, gimmick: GIMMICK_Z_MOVE); }
+        TURN { SWITCH(player, 1); }
+        TURN { MOVE(player, MOVE_CELEBRATE, gimmick: GIMMICK_MEGA); }
+    } SCENE {
+        ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_ZMOVE_ACTIVATE, player);
+        NOT ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_MEGA_EVOLUTION, player);
+    } THEN {
+        EXPECT_EQ(player->species, SPECIES_LUCARIO);
+        DisarmMasters();
+    }
+}
+
+SINGLE_BATTLE_TEST("(MASTERS 8) In the Final, Mega Evolution and a Z-Move can both be used")
+{
+    GIVEN {
+        ArmMastersRound(3);
+        PLAYER(SPECIES_LUCARIO) { Item(ITEM_LUCARIONITE); }
+        PLAYER(SPECIES_WOBBUFFET) { Item(ITEM_NORMALIUM_Z); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(player, MOVE_CELEBRATE, gimmick: GIMMICK_MEGA); }
+        TURN { SWITCH(player, 1); }
+        TURN { MOVE(player, MOVE_SCRATCH, gimmick: GIMMICK_Z_MOVE); }
+    } SCENE {
+        ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_MEGA_EVOLUTION, player);
+        ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_ZMOVE_ACTIVATE, player);
+        ANIMATION(ANIM_TYPE_MOVE, MOVE_BREAKNECK_BLITZ, player);
+    } THEN {
+        DisarmMasters();
+    }
+}
+
+SINGLE_BATTLE_TEST("(MASTERS 8) Rules are off outside the Masters cups")
+{
+    GIVEN {
+        DisarmMasters();
+        PLAYER(SPECIES_LUCARIO) { Item(ITEM_LUCARIONITE); }
+        PLAYER(SPECIES_WOBBUFFET) { Item(ITEM_NORMALIUM_Z); }
+        OPPONENT(SPECIES_WOBBUFFET);
+    } WHEN {
+        TURN { MOVE(player, MOVE_CELEBRATE, gimmick: GIMMICK_MEGA); }
+        TURN { SWITCH(player, 1); }
+        TURN { MOVE(player, MOVE_SCRATCH, gimmick: GIMMICK_Z_MOVE); }
+    } SCENE {
+        ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_MEGA_EVOLUTION, player);
+        ANIMATION(ANIM_TYPE_GENERAL, B_ANIM_ZMOVE_ACTIVATE, player);
+    }
+}
+
+static u32 CountBuiltMons(void)
+{
+    u32 count = 0;
+    for (u32 i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gEnemyParty[i], MON_DATA_SPECIES) != SPECIES_NONE)
+            count++;
+    return count;
+}
+
+// A six-Pokemon trainer built here: test builds swap the real trainer table
+// for test/battle/trainer_control.party, so the anime teams aren't present.
+static const struct TrainerMon sSixMons[] =
+{
+    { .species = SPECIES_WOBBUFFET, .lvl = 50, .moves = { MOVE_SCRATCH } },
+    { .species = SPECIES_WYNAUT,    .lvl = 50, .moves = { MOVE_SCRATCH } },
+    { .species = SPECIES_PIKACHU,   .lvl = 50, .moves = { MOVE_SCRATCH } },
+    { .species = SPECIES_EEVEE,     .lvl = 50, .moves = { MOVE_SCRATCH } },
+    { .species = SPECIES_MEW,       .lvl = 50, .moves = { MOVE_SCRATCH } },
+    { .species = SPECIES_DITTO,     .lvl = 50, .moves = { MOVE_SCRATCH } },
+};
+
+static const struct Trainer sSixMonTrainer =
+{
+    .party = TRAINER_PARTY(sSixMons),
+    .trainerName = _("TEST"),
+};
+
+TEST("(MASTERS 8) Quarter Finals are 3v3, Semi Finals and the Final are 6v6")
+{
+    ArmMastersRound(1);
+    EXPECT_EQ(Sim_GetCupBringCap(), 3);
+    CreateNPCTrainerPartyFromTrainer(gEnemyParty, &sSixMonTrainer, TRUE, BATTLE_TYPE_TRAINER);
+    EXPECT_EQ(CountBuiltMons(), 3);
+
+    ArmMastersRound(2);
+    EXPECT_EQ(Sim_GetCupBringCap(), 0);
+    CreateNPCTrainerPartyFromTrainer(gEnemyParty, &sSixMonTrainer, TRUE, BATTLE_TYPE_TRAINER);
+    EXPECT_EQ(CountBuiltMons(), 6);
+
+    ArmMastersRound(3);
+    CreateNPCTrainerPartyFromTrainer(gEnemyParty, &sSixMonTrainer, TRUE, BATTLE_TYPE_TRAINER);
+    EXPECT_EQ(CountBuiltMons(), 6);
+
+    // Outside the Masters cups nothing is capped.
+    DisarmMasters();
+    gSimPilotMode = TRUE;
+    gSimTournamentCup = 1;
+    gSimTournamentRound = 1;
+    gSimTournamentMaxRounds = 3;
+    EXPECT_EQ(Sim_GetCupBringCap(), 0);
+    CreateNPCTrainerPartyFromTrainer(gEnemyParty, &sSixMonTrainer, TRUE, BATTLE_TYPE_TRAINER);
+    EXPECT_EQ(CountBuiltMons(), 6);
+
+    DisarmMasters();
+    ZeroEnemyPartyMons();
+}
