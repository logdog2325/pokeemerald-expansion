# Flow test for Aster's arc (aster.pory; Meteor Falls is act3.pory's now, and
# tests/act3.play covers it and the Mega Ring in full).
# Needs rustboro_done.ss from tests/rustboro.play: a one-Pokemon party, so a mashed battle ends
# when it faints instead of stopping at the switch menu. VAR_SECOND_STARTER is set by hand.
# States are set by hand and scenes reached with the debug warp; battles are mashed with the
# no-whiteout flag on, so this checks the scripts, not the balance.
# Matrix parameters (tools/hack/emu/matrix.py): EGGNAME = the player's egg in the savestate (Aster's
# trainer ids are named after it), SECOND = the second starter, GFX/MAGMA = the player's sprite prefix for
# the Draconid and Magma outfits (unused since round 1 took the disguise scenes out; the matrix still passes them).
default START rustboro_done.ss
default EGGNAME DEINO
default SECOND 1
default GFX DRACONID_M
default MAGMA MAGMA_M
loadstate ${START}
setvar VAR_SECOND_STARTER ${SECOND}
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
setflag FLAG_DRACONID_NO_WHITEOUT

# --- A2 Meteor Falls: Magma and Aqua take the meteorite, then Aster ---
setvar VAR_METEOR_FALLS_STATE 0
clearflag FLAG_HIDE_METEOR_FALLS_TEAM_MAGMA
clearflag FLAG_HIDE_METEOR_FALLS_TEAM_AQUA
warp MAP_METEOR_FALLS_1F_1R 15 18
run 60
walk LEFT 14
mash A 90000
shot 10_meteor_falls
expect_var VAR_ASTER_STATE 1
expect_opponent TRAINER_ASTER_METEOR_FALLS_${EGGNAME}

# (Act 3: Aster gives the Mega Ring at Jagged Pass, state 6 - act3.play checks it)
setvar VAR_PLAYER_OUTFIT 0
setvar VAR_ASTER_STATE 6

# --- A5 Sky Pillar: the climax before Rayquaza wakes ---
setvar VAR_SKY_PILLAR_STATE 0
setvar VAR_SKY_PILLAR_RAYQUAZA_CRY_DONE 0
clearflag FLAG_HIDE_SKY_PILLAR_TOP_RAYQUAZA
heal
warp MAP_SKY_PILLAR_TOP 14 10
run 60
walk UP 9
run 60
shot 60_sky_pillar
mash A 90000
shot 61_after_rayquaza
expect_var VAR_ASTER_STATE 8
expect_var VAR_SKY_PILLAR_STATE 1
expect_flag FLAG_HIDE_SKY_PILLAR_TOP_ASTER 1
expect_opponent TRAINER_ASTER_SKY_PILLAR_${EGGNAME}

# --- A6 after the League: the shrine ---
setflag FLAG_SYS_GAME_CLEAR
heal
warp MAP_DRACONID_VILLAGE_SHRINE 10 11
run 60
walk UP 10
press A 2 30
mash A 90000
shot 70_shrine
expect_var VAR_ASTER_STATE 9
expect_opponent TRAINER_ASTER_POSTGAME_${EGGNAME}
savestate aster_done.ss

clearflag FLAG_DEBUG_NO_ENCOUNTER
clearflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
