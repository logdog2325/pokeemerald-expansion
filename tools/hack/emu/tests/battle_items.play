# Battle items and Mega Stones (round 1 follow-up 3, D-218 – D-222): the battle item counter's stock by badge
# count, a purchase, a Gym Leader's booster gift and a Mega Stone item ball. Needs rustboro_done.ss
# (tests/rustboro.play: 0 badges, the Magma uniform). Look at the list screenshots: 10_* (0 badges: the 18 type
# boosters), 20_* (4 badges: Leftovers … on top), 30_* (8 badges: stones and competitive items), 40_* (after the
# Champion: the post-game stones on top, revealed greeting), 50_* (the Lilycove Department Store 3F clerk).
loadstate rustboro_done.ss
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
expect_var VAR_DRACONID_REPUTATION 1

# --- 0 badges: Rustboro Mart, the new clerk at (1, 2); the player talks across the counter from (3, 2) ---
warp MAP_RUSTBORO_CITY_MART 3 3
walk UP 2
press LEFT 2 20
shot 10_counter
# greeting (two boxes, the second scrolls) -> BUY
press A 2 200
press A 2 200
press A 2 200
shot 11_greeting
press A 2 120
shot 12_tier1_list
# buy one Silk Scarf (the first item, ₽1,000): item -> "how many" -> 1 -> "that will be" -> YES -> "here you go"
press A 2 120
press A 2 60
press A 2 120
press A 2 120
press A 2 120
press A 2 120
press A 2 150
shot 13_bought
press B 2 120
mash B 3000
expect_item ITEM_SILK_SCARF 1

# --- Roxanne's booster (D-220): her TM path after a won battle, reached as "defeated, TM not yet received" ---
settrainer TRAINER_ROXANNE_1 1
clearflag FLAG_RECEIVED_TM_ROCK_TOMB
warp MAP_RUSTBORO_CITY_GYM 5 4
walk UP 3
press UP 2 20
mash A 6000
shot 14_after_roxanne
expect_item ITEM_TM_ROCK_TOMB 1
expect_item ITEM_HARD_STONE 1
expect_flag FLAG_RECEIVED_TM_ROCK_TOMB 1

# --- 4 badges: Leftovers, Rocky Helmet … (tier 3) on top ---
setflag FLAG_BADGE01_GET
setflag FLAG_BADGE02_GET
setflag FLAG_BADGE03_GET
setflag FLAG_BADGE04_GET
warp MAP_RUSTBORO_CITY_MART 3 3
walk UP 2
press LEFT 2 20
press A 2 200
press A 2 200
press A 2 200
press A 2 120
shot 20_tier3_list
repeat 12 press DOWN 2 8
shot 21_tier3_scrolled
press B 2 120
mash B 3000

# --- 8 badges: tier 5 (Mega Stones, then the competitive items), tier 4 below ---
setflag FLAG_BADGE05_GET
setflag FLAG_BADGE06_GET
setflag FLAG_BADGE07_GET
setflag FLAG_BADGE08_GET
warp MAP_RUSTBORO_CITY_MART 3 3
walk UP 2
press LEFT 2 20
press A 2 200
press A 2 200
press A 2 200
press A 2 120
shot 30_tier5_list
repeat 13 press DOWN 2 8
shot 31_tier5_items
repeat 38 press DOWN 2 8
shot 32_tier4_stones
repeat 12 press DOWN 2 8
shot 33_tier4_items
press B 2 120
mash B 3000

# --- after the Champion, revealed: the post-game stones on top ---
setflag FLAG_IS_CHAMPION
setvar VAR_DRACONID_REPUTATION 2
warp MAP_RUSTBORO_CITY_MART 3 3
walk UP 2
press LEFT 2 20
press A 2 200
shot 40_greeting_revealed
press A 2 200
press A 2 200
press A 2 120
shot 41_postgame_list
repeat 8 press DOWN 2 8
shot 42_postgame_scrolled
press B 2 120
mash B 3000

# --- Lilycove Department Store 3F: the third clerk at (9, 2), talked to from (9, 4) across the counter ---
warp MAP_LILYCOVE_CITY_DEPARTMENT_STORE_3F 9 5
walk UP 4
press UP 2 20
shot 50_lilycove_counter
press A 2 200
press A 2 200
press A 2 200
press A 2 120
shot 51_lilycove_list
press B 2 120
mash B 3000

# --- a Mega Stone item ball (D-221): Banettite on Mt. Pyre 3F (0, 7), in place of the vanilla Super Repel ---
expect_item ITEM_BANETTITE 0
warp MAP_MT_PYRE_3F 2 7
walk LEFT 1
press LEFT 2 20
mash A 3000
shot 60_banettite
expect_item ITEM_BANETTITE 1
expect_flag FLAG_ITEM_MT_PYRE_3F_BANETTITE 1
