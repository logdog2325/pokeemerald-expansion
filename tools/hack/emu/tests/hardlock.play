# Emulator checks behind tools/hack/check_hardlock.py (D-264, docs/hack_progression.md "Hard locks").
# Runs after act7.play in the regression chain: needs woods_done.ss (woods.play), act5_space_center.ss (act5.play)
# and act7_3f.ss (act7.play) in the same -o directory; section 4 starts from rustboro_done.ss (rustboro.play) with the
# states set by hand, as act7x.play does.
#   python3 tools/hack/emu/play.py tools/hack/emu/tests/hardlock.play -o DIR
#
# 1. A script that ends while lockall is in force does not freeze the player: the Space Center raid ends in the
#    vanilla MossdeepCity_SpaceCenter_2F_EventScript_DefeatedMaxieTabitha, whose releaseall is only under BUGFIX.
#    The engine unlocks the player's controls when a script ends, and back from the battle the objects were set up
#    again unfrozen - so the checker reports a lock left in force only as a CHECK, and not after a battle.
loadstate act5_space_center.ss
pos
walk LEFT 1
expect_pos 1 8
walk DOWN 9
expect_pos 1 9
shot hl_10_space_center_walk

# 2. A whiteout in a story scene (leg 1.15, Brendan at Rustboro's south edge; the checker's battle check): the
#    player respawns, Brendan's trigger and object are still there (VAR_BRENDAN_STATE 0), and the scene plays
#    again from the start when the player walks back.
loadstate woods_done.ss
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
boost 0 1
warp MAP_RUSTBORO_CITY 13 57
path RustboroCity 13 57 13 54
press UP 2 10
run 200
mash A 60000
run 60
mapid
shot hl_20_after_whiteout
expect_var VAR_BRENDAN_STATE 0
expect_flag FLAG_HIDE_RUSTBORO_CITY_RIVAL 0
expect_trainer TRAINER_BRENDAN_RUSTBORO 0
heal
boost 0
warp MAP_RUSTBORO_CITY 13 57
path RustboroCity 13 57 13 54
press UP 2 10
run 200
shot hl_21_brendan_again
mash A 60000
expect_opponent TRAINER_BRENDAN_RUSTBORO
expect_var VAR_BRENDAN_STATE 1
expect_flag FLAG_HIDE_RUSTBORO_CITY_RIVAL 1

# 3. A lost battle that goes on (FLAG_DRACONID_NO_WHITEOUT; leg 7.02, Zinnia on the Sky Pillar 3F; the checker's
#    re-entry check): the party is healed, the flag is cleared again, the finale state stays at the climb; talking
#    to Zinnia asks again (answered NO here), and re-entering the floor starts the scene over - then it is won.
loadstate act7_3f.ss
boost 0 1
run 60
until @gMain+4 4 @@BattleMainCB2 30000 A 24
run 60
shot hl_30_zinnia_loss
until @gMain+4 4 @@CB2_Overworld 90000 A 24
mash A 30000
shot hl_31_after_loss
expect_var VAR_DRACONID_FINALE_STATE 4
expect_flag FLAG_DRACONID_NO_WHITEOUT 0
expect_trainer TRAINER_ZINNIA_SKY_PILLAR 0
mapid
# Zinnia stands at (3, 4) after her walk up; ask her from (3, 3), answer NO
walk DOWN 3
press A 2 30
run 60
shot hl_32_zinnia_asks
press B 2 30
mash B 10000
expect_var VAR_DRACONID_FINALE_STATE 4
# leave and come back: the floor's load script arms the scene again (VAR_TEMP_7)
boost 0
warp MAP_SKY_PILLAR_3F 3 2
run 60
shot hl_33_zinnia_again
until @gMain+4 4 @@BattleMainCB2 30000 A 24
run 60
until @gMain+4 4 @@CB2_Overworld 90000 A 24
mash A 30000
shot hl_34_summit
expect_opponent TRAINER_ZINNIA_SKY_PILLAR
expect_var VAR_DRACONID_FINALE_STATE 5
expect_map MAP_SKY_PILLAR_TOP

# 4. A lost multi battle never whites out (BattleSetup_StartMultiBattle -> CB2_EndSpecialTrainerBattle goes back to
#    the script whatever the outcome; the checker's battle check, D-265a): leg 7.10, the south-west house in the
#    village under attack, lost with the whiteout flag off. Draconid_EventScript_VillageLost carries the player home
#    to (8, 6) - a whiteout would respawn them at (2, 7) or at another Pokemon Center - the house's grunts wait
#    (VILLAGE_STATE_ATTACK, no trainer flag), and talking to them again starts the same double battle.
default MOVE 2
loadstate rustboro_done.ss
setvar VAR_SECOND_STARTER 1
setvar VAR_DRACONID_REPUTATION 2
setvar VAR_PLAYER_OUTFIT 0
setvar VAR_MAGMA_STATE 12
setvar VAR_NERINE_STATE 8
setvar VAR_ASTER_STATE 8
setvar VAR_BRENDAN_STATE 6
setvar VAR_MAY_STATE 4
setvar VAR_SKY_PILLAR_STATE 3
setvar VAR_SKY_PILLAR_RAYQUAZA_CRY_DONE 1
setflag FLAG_SYS_GAME_CLEAR
setflag FLAG_BADGE01_GET
setflag FLAG_BADGE02_GET
setflag FLAG_BADGE03_GET
setflag FLAG_BADGE04_GET
setflag FLAG_BADGE05_GET
setflag FLAG_BADGE06_GET
setflag FLAG_BADGE07_GET
setflag FLAG_BADGE08_GET
setflag FLAG_DEFEATED_RAYQUAZA
setflag FLAG_HIDE_SKY_PILLAR_TOP_ASTER
setflag FLAG_HIDE_DRACONID_HOUSE_ELDER
setflag FLAG_HIDE_DRACONID_ELDERS_HOUSE_ELDER
setvar VAR_DRACONID_FINALE_STATE 6
setvar VAR_DRACONID_VILLAGE_STATE 4
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
pokebit *@gSaveBlock2Ptr+15 1 1
warp MAP_DRACONID_VILLAGE 19 24
run 150
until_var VAR_DRACONID_VILLAGE_STATE 5 120000 A
run 30
wait_free 600
walk DOWN 25
walk LEFT 13
press UP 2 20
boost 0 1
press A 2 30
until @gMain+4 4 @@CB2_UpdatePartyMenu 60000 A 24
run 60
press A 2 40
press A 2 40
press DOWN 2 30
press A 2 40
until @gMain+4 4 @@BattleMainCB2 3000
run 300
until @gMain+4 4 @@CB2_Overworld 200000 A 24
expect_opponent TRAINER_GRUNT_VILLAGE_1
expect_partner PARTNER_WALLY_VILLAGE
mash A 30000
run 30
shot hl_40_village_lost
expect_map MAP_DRACONID_VILLAGE_PLAYERS_HOUSE_1F
expect_pos 8 6
expect_flag FLAG_DRACONID_NO_WHITEOUT 0
expect_trainer TRAINER_GRUNT_VILLAGE_1 0
expect_var VAR_DRACONID_VILLAGE_STATE 5
# out of the door and back to the house: the same double battle again, won this time
walk DOWN 8
hold DOWN 20
run 90
wait_free 600
run 30
expect_map MAP_DRACONID_VILLAGE
expect_pos 8 15
path DraconidVillage 8 15 13 25
press UP 2 20
boost 0
press A 2 30
until @gMain+4 4 @@CB2_UpdatePartyMenu 60000 A 24
run 60
press A 2 40
press A 2 40
press DOWN 2 30
press A 2 40
until @gMain+4 4 @@BattleMainCB2 3000
run 60
poke @gMoveSelectionCursor ${MOVE}
until @gMain+4 4 @@CB2_Overworld 200000 A 24
expect_opponent TRAINER_GRUNT_VILLAGE_1
expect_partner PARTNER_WALLY_VILLAGE
mash A 30000
shot hl_41_village_won
expect_trainer TRAINER_GRUNT_VILLAGE_1 1
expect_trainer TRAINER_GRUNT_VILLAGE_2 1
expect_var VAR_DRACONID_VILLAGE_STATE 5
