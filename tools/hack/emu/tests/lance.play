run 60
shot lance_f01_lance_waits
expect_var VAR_TEMP_C 0
expect_flag FLAG_HIDE_DRACONID_VILLAGE_LANCE 0
# his Dragonite, from its left (12, 12)
path DraconidVillage 8 15 12 14
press UP 2 20
press UP 2 20
press RIGHT 2 20
press A 2 30
run 60
shot lance_f02_dragonite
mash B 20000

