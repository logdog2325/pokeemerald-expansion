expect_flag FLAG_RECEIVED_DRAGONINITE 0
expect_pos 13 14

# --- talking to him: a loss whites out (no softlock), and he is still there ---
clearflag FLAG_DRACONID_NO_WHITEOUT
boost 0 1
press UP 2 20
press A 2 30
until @gMain+4 4 @@BattleMainCB2 30000 A 24
run 60
shot lance_g01_battle_to_lose
until @gMain+4 4 @@CB2_Overworld 120000 A 24
mash A 30000
mapid
shot lance_g02_after_whiteout
expect_opponent TRAINER_LANCE_DRACONID
expect_trainer TRAINER_LANCE_DRACONID 0
setflag FLAG_DRACONID_NO_WHITEOUT
heal
warp MAP_DRACONID_VILLAGE 8 15
run 60
shot lance_g03_back_in_the_village
expect_flag FLAG_HIDE_DRACONID_VILLAGE_LANCE 0
expect_var VAR_TEMP_C 0

