# Lance in the Draconid village (data/scripts/draconid/lance.pory, D-260 - D-262). Post-game only: the first village
# visit of the post-game (the one with the SS Ticket) arms the arrival, a later one at the fly spot (8, 15) plays it:
# the Dragonite swoops down with Lance on its back, the Elder and Aster come over and Lance challenges the player.
# Accepted, the battle starts at once (Mega Dragonite last), then the Dratini and the Dragoninite; declined, Lance
# waits in the village and talking to him starts the battle; a loss whites out and he is still there; after the
# first win he battles again whenever asked.
# Needs rustboro_done.ss from tests/rustboro.play (the Deino chain: a one-Pokemon party); the post-game state is set
# by hand (as act7.play leaves it). The lead is boosted to win (play.py "boost") with the move cursor on MOVE (Deino:
# Dragon Breath, super effective against his all-dragon team), or set to 1 HP to lose. Frame series (lance_*): a the
# arrival, b the scene up to the battle (accepted), c Mega Dragonite, e after the battle, d the declined scene.
default START rustboro_done.ss
default MOVE 2
loadstate ${START}
setvar VAR_DRACONID_REPUTATION 2
setvar VAR_PLAYER_OUTFIT 0
setvar VAR_MAGMA_STATE 12
setvar VAR_NERINE_STATE 9
setvar VAR_ASTER_STATE 9
setvar VAR_BRENDAN_STATE 8
setvar VAR_MAY_STATE 5
setflag FLAG_SYS_GAME_CLEAR
setflag FLAG_BADGE01_GET
setflag FLAG_BADGE02_GET
setflag FLAG_BADGE03_GET
setflag FLAG_BADGE04_GET
setflag FLAG_BADGE05_GET
setflag FLAG_BADGE06_GET
setflag FLAG_BADGE07_GET
setflag FLAG_BADGE08_GET
setflag FLAG_RECEIVED_SS_TICKET
setflag FLAG_HIDE_DRACONID_HOUSE_ELDER
clearflag FLAG_HIDE_DRACONID_ELDERS_HOUSE_ELDER
clearflag FLAG_HIDE_DRACONID_VILLAGE_NERINE
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
setflag FLAG_DRACONID_NO_WHITEOUT
# battle style SET (gSaveBlock2Ptr->optionsBattleStyle, bit 1 of byte 0x15): no "Will you switch?" prompt to mash
pokebit *@gSaveBlock2Ptr+15 1 1
# text speed FAST (optionsTextSpeed, bits 0-2 of byte 0x14 = 2), so the frame series show every text box
pokebit *@gSaveBlock2Ptr+14 0 0
pokebit *@gSaveBlock2Ptr+14 1 1
pokebit *@gSaveBlock2Ptr+14 2 0

# --- before the post-game: no Lance, nothing armed ---
setvar VAR_DRACONID_FINALE_STATE 8
warp MAP_DRACONID_VILLAGE 8 15
run 60
shot lance_00_before_postgame
expect_flag FLAG_HIDE_DRACONID_VILLAGE_LANCE 1
expect_flag FLAG_DRACONID_LANCE_ARMED 0
expect_var VAR_TEMP_C 0

# --- the first post-game visit (the SS Ticket's) only arms the arrival ---
setvar VAR_DRACONID_FINALE_STATE 9
warp MAP_DRACONID_VILLAGE 8 15
run 60
shot lance_01_first_postgame_visit
expect_flag FLAG_DRACONID_LANCE_ARMED 1
expect_flag FLAG_HIDE_DRACONID_VILLAGE_LANCE 1
expect_var VAR_TEMP_C 0
# a later visit away from the fly spot (out of the shrine): he waits for one at the fly spot
warp MAP_DRACONID_VILLAGE 19 6
run 60
shot lance_02_shrine_door
expect_flag FLAG_HIDE_DRACONID_VILLAGE_LANCE 1
expect_var VAR_TEMP_C 0
expect_trainer TRAINER_LANCE_DRACONID 0
savestate lance_armed.ss

# --- the arrival, accepted: the battle at once ---
boost 0
warp MAP_DRACONID_VILLAGE 8 15
run 8
