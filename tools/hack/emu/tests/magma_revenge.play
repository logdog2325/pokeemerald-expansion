# Team Magma's revenge flow test (data/scripts/draconid/magma_revenge.pory, D-244 – D-249): after the Sootopolis
# reveal, the ambush out of Juan's Gym, the Ever Grande shore, the grunt by the Pokémon Center, the Aqua gauntlet
# (all six battles in one run, then a second run that loses mid-gauntlet and starts over from the first grunt),
# Maxie #2 at Victory Road's mouth (Mega Camerupt), Tabitha + Courtney in Victory Road B1F (both Mega Evolve), the
# grunt out of Victory Road and the last two at the League's forecourt.
# Needs rustboro_done.ss from tests/rustboro.play; the states after the turn and Juan's badge are set by hand,
# scenes are reached with the debug warp. A second Pokémon is given for the double battles. Every battle is won by
# a boosted lead, poked before it starts (gParties[B_TRAINER_PLAYER] slot 0: level 100 and 999 in every stat,
# +0x54, +0x56..+0x63 – the stats are recalculated when the battle ends), so each scene's "done" trainer flag is
# checked; the one battle meant to be lost (the gauntlet's third, with the whiteout on) keeps the weak lead. The
# battle style is SET, so a won battle doesn't ask to switch. -D GFX=DRACONID_M|DRACONID_F (the tamer sprites).
default GFX DRACONID_M
loadstate rustboro_done.ss
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
setflag FLAG_DRACONID_NO_WHITEOUT
# after the Sootopolis turn (act5.play) and Juan's Rain Badge
setvar VAR_SECOND_STARTER 1
setvar VAR_DRACONID_STATE 8
setvar VAR_PLAYER_OUTFIT 0
setvar VAR_DRACONID_REPUTATION 2
setvar VAR_MAGMA_STATE 12
setvar VAR_NERINE_STATE 7
setvar VAR_ASTER_STATE 7
setvar VAR_BRENDAN_STATE 6
setvar VAR_MAY_STATE 4
setvar VAR_SOOTOPOLIS_CITY_STATE 6
setvar VAR_SKY_PILLAR_STATE 3
setflag FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE
setflag FLAG_HIDE_SOOTOPOLIS_CITY_MAXIE
setflag FLAG_HIDE_SOOTOPOLIS_CITY_ARCHIE
setflag FLAG_HIDE_SOOTOPOLIS_CITY_RIVALS
setflag FLAG_RECEIVED_POKENAV
setflag FLAG_BADGE01_GET
setflag FLAG_BADGE02_GET
setflag FLAG_BADGE03_GET
setflag FLAG_BADGE04_GET
setflag FLAG_BADGE05_GET
setflag FLAG_BADGE06_GET
setflag FLAG_BADGE07_GET
setflag FLAG_BADGE08_GET
giveitem ITEM_HM_SURF
giveitem ITEM_HM_WATERFALL
givemon SPECIES_TREECKO 10
heal
# battle style SET (gSaveBlock2 optionsBattleStyle, bit 9 of the u16 at +0x14): a won single battle doesn't stop
# at "Will you change POKéMON?" between the opponent's Pokémon (mashing A would open the party menu)
pokebit *@gSaveBlock2Ptr+15 1 1

# --- 1. Sootopolis: out of Juan's Gym, two grunts come out of the door behind the player (double battle) ---
warp MAP_SOOTOPOLIS_CITY 31 33
run 60
expect_var VAR_TEMP_3 1
walk DOWN 34
run 60
shot r1_10_sootopolis_ambush
poke @gParties+54 64
poke @gParties+56 E7
poke @gParties+57 3
poke @gParties+58 E7
poke @gParties+59 3
poke @gParties+5A E7
poke @gParties+5B 3
poke @gParties+5C E7
poke @gParties+5D 3
poke @gParties+5E E7
poke @gParties+5F 3
poke @gParties+60 E7
poke @gParties+61 3
poke @gParties+62 E7
poke @gParties+63 3
mash A 60000
shot r1_11_after
expect_opponent TRAINER_GRUNT_SOOTOPOLIS_REVENGE_1
expect_opponent_b TRAINER_GRUNT_SOOTOPOLIS_REVENGE_2
expect_trainer TRAINER_GRUNT_SOOTOPOLIS_REVENGE_2 1
expect_var VAR_TEMP_3 0
expect_gfx OBJ_EVENT_GFX_${GFX}_NORMAL
# gone for good: back out of the Gym, nothing happens
warp MAP_SOOTOPOLIS_CITY 31 33
run 60
expect_var VAR_TEMP_3 0
walk DOWN 34
run 30
expect_pos 31 34

# --- 2. Ever Grande: the shore at the top of the waterfall (the player surfs up to row 57) ---
heal
warp MAP_EVER_GRANDE_CITY 21 59
run 60
expect_var VAR_TEMP_2 1
walk UP 57
run 60
shot r2_10_shore_ambush
poke @gParties+54 64
poke @gParties+56 E7
poke @gParties+57 3
poke @gParties+58 E7
poke @gParties+59 3
poke @gParties+5A E7
poke @gParties+5B 3
poke @gParties+5C E7
poke @gParties+5D 3
poke @gParties+5E E7
poke @gParties+5F 3
poke @gParties+60 E7
poke @gParties+61 3
poke @gParties+62 E7
poke @gParties+63 3
mash A 60000
shot r2_11_after
expect_opponent TRAINER_GRUNT_EVER_GRANDE_SHORE_1
expect_opponent_b TRAINER_GRUNT_EVER_GRANDE_SHORE_2
expect_trainer TRAINER_GRUNT_EVER_GRANDE_SHORE_2 1
expect_var VAR_TEMP_2 0

# --- 3. the grunt beside the Pokémon Center door (a sight trainer), then the player heals there ---
heal
clearflag FLAG_DEBUG_NO_TRAINER_SEE
warp MAP_EVER_GRANDE_CITY 27 52
run 60
walk UP 49
run 60
shot r3_10_center_grunt
poke @gParties+54 64
poke @gParties+56 E7
poke @gParties+57 3
poke @gParties+58 E7
poke @gParties+59 3
poke @gParties+5A E7
