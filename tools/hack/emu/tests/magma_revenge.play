# --- 5. Maxie at Victory Road's mouth (Mega Camerupt) ---
heal
warp MAP_EVER_GRANDE_CITY 18 45
run 60
expect_var VAR_TEMP_4 1
walk UP 43
run 60
shot r5_10_maxie
poke @gParties+54 64
poke @gParties+56 E7
poke @gParties+57 3
poke @gParties+58 E7
poke @gParties+59 3
