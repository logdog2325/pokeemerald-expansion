shot r5_12_after
expect_opponent TRAINER_MAXIE_VICTORY_ROAD
expect_trainer TRAINER_MAXIE_VICTORY_ROAD 1
expect_var VAR_TEMP_4 0

# --- 6. Victory Road B1F: Tabitha and Courtney come down the last ladder (two-trainer double, both Megas);
# B1F is dark: the player has used Flash ---
