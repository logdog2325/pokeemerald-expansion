poke @gParties+62 E7
poke @gParties+63 3
mash A 60000
shot r3_11_after
expect_opponent TRAINER_GRUNT_EVER_GRANDE_CENTER
expect_trainer TRAINER_GRUNT_EVER_GRANDE_CENTER 1
setflag FLAG_DEBUG_NO_TRAINER_SEE
# into the Pokémon Center: the respawn point is Ever Grande now
hold UP 30
run 90
expect_map MAP_EVER_GRANDE_CITY_POKEMON_CENTER_1F
heal

