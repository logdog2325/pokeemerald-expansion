run 60
expect_var VAR_TEMP_6 1
walk UP 14
run 60
shot r8_10_league_grunts
# both party slots boosted, as for the admins' double: with only the lead boosted, the weak second POKéMON can
# faint and a mashed double is sometimes lost (seen once in the matrix: F_DEINO)
boost 1
poke @gParties+54 64
poke @gParties+56 E7
poke @gParties+57 3
poke @gParties+58 E7
poke @gParties+59 3
poke @gParties+5A E7
poke @gParties+5B 3
poke @gParties+5C E7
poke @gParties+5D 3
poke @gParties+5E E7
poke @gParties+5F 3
poke @gParties+60 E7
poke @gParties+61 3
poke @gParties+62 E7
poke @gParties+63 3
mash A 60000
shot r8_11_after
expect_opponent TRAINER_GRUNT_POKEMON_LEAGUE_1
expect_opponent_b TRAINER_GRUNT_POKEMON_LEAGUE_2
expect_trainer TRAINER_GRUNT_POKEMON_LEAGUE_2 1
expect_var VAR_TEMP_6 0
# the way to the League door is open
walk UP 6
expect_pos 18 6
savestate revenge_done.ss

clearflag FLAG_DEBUG_NO_ENCOUNTER
clearflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
