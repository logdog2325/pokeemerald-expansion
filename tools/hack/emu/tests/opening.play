# Draconid Emerald opening, new game -> Birch's lab (regression test for Phases 1 and 4, round 1 D-230/D-231).
#   python3 tools/hack/emu/play.py tools/hack/emu/tests/opening.play -o /tmp/opening
# Saves opening_*.ss states in the output directory for follow-up scripts.
# The quickstart gender is random: -D GENDER=F tests the female player.
# -D EGG=0|1|2 -D EGGNAME=DEINO|DREEPY|JANGMO_O picks Deino / Dreepy / Jangmo-o (DRACONID_EGG_*).
default GENDER M
default EGG 0
default EGGNAME DEINO
newgame
gender ${GENDER}
mash A 3000
expect_var VAR_DRACONID_STATE 1
# bedroom: set the wall clock (the dialog defaults to NO; UP selects YES)
walk UP 2
walk RIGHT 5
press UP 3 10
press A 2 450
press A 2 150
press A 2 40
press UP 2 20
press A 2 60
mash A 3000
expect_var VAR_DRACONID_STATE 2
expect_flag FLAG_SYS_CLOCK_SET 1
# downstairs and out
walk RIGHT 7
walk UP 1
run 90
walk DOWN 8
run 150
hold DOWN 20
run 180
# to the Elder's house: the prophecy and the mission, then the Elder takes the player up to the shrine
# (a warp), where the egg ceremony runs: pick egg ${EGG}, then YES
walk RIGHT 19
walk UP 12
walk RIGHT 24
walk UP 11
run 120
choose ${EGG}
mash A 20000
expect_var VAR_DRACONID_STATE 3
expect_var VAR_STARTER_MON ${EGG}
expect_flag FLAG_RECEIVED_DRACONID_EGG 1
expect_flag FLAG_SYS_POKEMON_GET 1
expect_flag FLAG_DRACONID_EGG_HATCHED 0
expect_flag FLAG_HIDE_DRACONID_PASS_ASTER 0
expect_flag FLAG_HIDE_DRACONID_SHRINE_ELDER 1
expect_flag FLAG_HIDE_DRACONID_ELDERS_HOUSE_ELDER 0
# the Z-Power Ring and the first crystal from the Elder (zmoves.pory, D-267)
expect_item ITEM_Z_POWER_RING 1
expect_item ITEM_NORMALIUM_Z 1
expect_flag FLAG_RECEIVED_Z_POWER_RING 1
var VAR_STARTER_MON
var VAR_ASTER_EGG
mapid
pos
shot 01_egg
# out of the shrine (steps inside don't count): the egg hatches on the 5th step outdoors
# (DRACONID_EGG_HATCH_STEPS), not before
walk DOWN 19
hold DOWN 20
run 200
pos
walk DOWN 10
run 30
expect_var VAR_DRACONID_EGG_STEPS 4
expect_flag FLAG_DRACONID_EGG_HATCHED 0
expect_var VAR_DRACONID_STATE 3
walk DOWN 11
run 30
# the hatch (B answers NO to the nickname), then the old woman brings the Running Shoes
mash B 30000
run 60
mash B 20000
expect_flag FLAG_DRACONID_EGG_HATCHED 1
expect_var VAR_DRACONID_STATE 5
expect_flag FLAG_SYS_B_DASH 1
expect_flag FLAG_HIDE_DRACONID_VILLAGE_SHOES_GIVER 1
read @gParties+54 1 hatchling_level
shot 02_hatched
# down to Draconid Pass and Aster's battle at the bridge
walk DOWN 29
hold DOWN 40
run 60
walk DOWN 17
run 60
savestate opening_before_aster.ss
walk DOWN 18
run 40
mash A 40000
expect_var VAR_DRACONID_STATE 6
expect_flag FLAG_DEFEATED_ASTER_DRACONID_PASS 1
expect_opponent TRAINER_ASTER_PASS_${EGGNAME}
expect_flag FLAG_DRACONID_NO_WHITEOUT 0
shot 03_after_aster
savestate opening_after_aster.ss
# east along the valley path to Route 101: Birch, the fallen star and the dazed LUNATONE (round 2, D-400) – the
# first battle (no catching, running or whiteout; mashing A uses the first move), the LUNATONE drifts off, the lab
walk DOWN 26
walk RIGHT 27
hold RIGHT 16
run 30
shot 04_route101
mapid
mash A 40000
mash A 20000
mapid
pos
shot 05_lab_done
expect_seen SPECIES_LUNATONE 1
expect_caught SPECIES_LUNATONE 0
expect_flag FLAG_DRACONID_NO_CATCHING 0
expect_flag FLAG_HIDE_ROUTE_101_BIRCH_ZIGZAGOON_BATTLE 1
expect_flag FLAG_HIDE_ROUTE_101_ZIGZAGOON 1
expect_flag FLAG_RESCUED_BIRCH 1
expect_flag FLAG_SYS_POKEDEX_GET 1
expect_flag FLAG_ADVENTURE_STARTED 1
expect_var VAR_BIRCH_LAB_STATE 5
expect_var VAR_ROUTE101_STATE 3
expect_flag FLAG_HIDE_ROUTE_103_RIVAL 0
savestate opening_lab_done.ss
