# The SS Ticket / Lati TV scene after the Hall of Fame, moved to the Draconid house
# (DraconidVillage_PlayersHouse_1F). Needs route104_done.ss from tests/route104.play.
# hall_of_fame.inc sets the houses state to 3 and shows Dad; this does the same by hand and
# arrives on the stairs like the player coming down from the bedroom. Mashing A picks the first
# colour (red) in the "What colour?" menu.
loadstate route104_done.ss
setvar VAR_LITTLEROOT_HOUSES_STATE_MAY 3
setvar VAR_LITTLEROOT_HOUSES_STATE_BRENDAN 3
clearflag FLAG_HIDE_PLAYERS_HOUSE_DAD
warp MAP_DRACONID_VILLAGE_PLAYERS_HOUSE_1F 8 2 3000
run 150
shot 10_dad_arrives
mash A 30000
shot 11_after_scene
expect_flag FLAG_RECEIVED_SS_TICKET 1
expect_flag FLAG_LATIOS_OR_LATIAS_ROAMING 1
expect_flag FLAG_HIDE_PLAYERS_HOUSE_DAD 1
expect_var VAR_LITTLEROOT_HOUSES_STATE_MAY 4
