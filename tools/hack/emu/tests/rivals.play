# Flow test for the rival scenes vanilla doesn't have (data/scripts/draconid/rivals.pory).
# Needs rustboro_done.ss from tests/rustboro.play. Each scene is reached with the debug "warp"
# hook and its state vars/flags set by hand; battles are mashed with the no-whiteout flag on,
# so this checks the scripts, not the balance.
loadstate rustboro_done.ss
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
setflag FLAG_DRACONID_NO_WHITEOUT

# --- Slateport: May at the north exit (after the Oceanic Museum) ---
setvar VAR_MAY_STATE 1
clearflag FLAG_HIDE_SLATEPORT_CITY_MAY
warp MAP_SLATEPORT_CITY 18 7
path SlateportCity 18 7 18 6
press UP 2 10
run 120
shot 10_slateport_may
press A 2 30
mash A 60000
expect_var VAR_MAY_STATE 2
expect_flag FLAG_HIDE_SLATEPORT_CITY_MAY 1

# --- Petalburg: Wally at the Gym door (after the Heat Badge) ---
setvar VAR_WALLY_STATE 1
clearflag FLAG_HIDE_PETALBURG_CITY_WALLY_GYM
warp MAP_PETALBURG_CITY 15 12
path PetalburgCity 15 12 15 10
press UP 2 10
run 120
shot 20_petalburg_wally
press A 2 30
mash A 60000
shot 21_after_wally
expect_var VAR_WALLY_STATE 2
expect_flag FLAG_HIDE_PETALBURG_CITY_WALLY_GYM 1
expect_flag FLAG_HIDE_LILYCOVE_CITY_WALLY 0

# --- Lilycove: Wally by the Pokemon Center ---
warp MAP_LILYCOVE_CITY 26 18
path LilycoveCity 26 18 26 17
press UP 2 10
press A 2 30
run 60
shot 30_lilycove_wally
mash A 60000
expect_var VAR_WALLY_STATE 3
expect_flag FLAG_HIDE_LILYCOVE_CITY_WALLY 1

# --- Lilycove: Brendan and May (needs two Pokemon: this party has one, so they say so) ---
clearflag FLAG_HIDE_LILYCOVE_CITY_RIVAL
warp MAP_LILYCOVE_CITY 27 9
path LilycoveCity 27 9 27 8
press UP 2 10
press A 2 30
run 60
shot 40_lilycove_rivals
mash A 20000
shot 41_lilycove_need_two
expect_flag FLAG_MET_RIVAL_LILYCOVE 0

# --- Sootopolis: the Mega battles after the Rain Badge (OnFrame scene) ---
setvar VAR_BRENDAN_STATE 2
clearflag FLAG_HIDE_SOOTOPOLIS_CITY_RIVALS
warp MAP_SOOTOPOLIS_CITY 31 33 2000
shot 50_sootopolis
mash A 90000
shot 51_after_sootopolis
expect_var VAR_BRENDAN_STATE 3
expect_flag FLAG_HIDE_SOOTOPOLIS_CITY_RIVALS 1

# --- Littleroot lab after the Champion: Brendan's rematch ---
setflag FLAG_SYS_GAME_CLEAR
setvar VAR_DEX_UPGRADE_JOHTO_STARTER_STATE 3
warp MAP_LITTLEROOT_TOWN_PROFESSOR_BIRCHS_LAB 8 12
path LittlerootTown_ProfessorBirchsLab 8 12 8 11
press UP 2 10
press A 2 30
run 60
shot 60_lab_brendan
mash A,A,UP 60000
shot 61_after_lab_brendan
savestate rivals_done.ss

clearflag FLAG_DEBUG_NO_ENCOUNTER
clearflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
