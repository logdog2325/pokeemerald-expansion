# Flow test for the rival scenes vanilla doesn't have (data/scripts/draconid/rivals.pory).
# Needs rustboro_done.ss from tests/rustboro.play. Each scene is reached with the debug "warp"
# hook and its state vars/flags set by hand; battles are mashed with the no-whiteout flag on,
# so this checks the scripts, not the balance.
loadstate rustboro_done.ss
setflag FLAG_DEBUG_NO_ENCOUNTER
setflag FLAG_DEBUG_NO_TRAINER_SEE
setflag FLAG_DRACONID_NO_WHITEOUT

# --- Littleroot lab after the finale: Brendan's rematch (act7.pory) ---
setflag FLAG_SYS_GAME_CLEAR
setvar VAR_DRACONID_FINALE_STATE 9
setvar VAR_DEX_UPGRADE_JOHTO_STARTER_STATE 3
warp MAP_LITTLEROOT_TOWN_PROFESSOR_BIRCHS_LAB 8 12
path LittlerootTown_ProfessorBirchsLab 8 12 8 11
press UP 2 10
press A 2 30
run 60
shot 60_lab_brendan
mash A,A,UP 60000
shot 61_after_lab_brendan
expect_var VAR_BRENDAN_STATE 8
savestate rivals_done.ss

clearflag FLAG_DEBUG_NO_ENCOUNTER
clearflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
