shot w99_after
mapid
# --- a generic trainer with a Gen 4-9 swap (D-195): Bug Catcher Rick on Route 102 leads with Kricketot (401)
setflag FLAG_DEBUG_NO_ENCOUNTER
warp MAP_ROUTE102 25 14
run 60
press DOWN 2 16
press A 2 16
until @gMain+4 4 @@BattleMainCB2 3000 A 30
run 300
read @gBattleMons+8C 2 rick_lead_species
press A 2 120
press A 2 200
shot w20_rick
mash A 30000
expect_opponent TRAINER_RICK
shot w21_after_rick
clearflag FLAG_DEBUG_NO_TRAINER_SEE
clearflag FLAG_DRACONID_NO_WHITEOUT
